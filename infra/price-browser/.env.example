# Kopieer naar infra/price-browser/.env op de server en zet
# COMPOSE_PROFILES=price-browser in infra/.env. Zie docs/bestuursorgaan.md
# ("De prijsbrowser").

# Het gedeelde geheim tussen de website en de prijsbrowser, minstens 16 tekens.
# Maak er een met: openssl rand -hex 24
PRICE_BROWSER_SECRET=

# Optioneel: een proxy waarlangs de browser de winkels opvraagt, bv. wanneer een
# winkel het IP van de server weigert. Leeg = rechtstreeks. Zet hier enkel een
# proxy die daarvoor bedoeld is en waarvan de eigenaar dit gebruik goedkeurde.
# PRICE_BROWSER_PROXY=http://proxy.example:3128
