model Group {
  id                String    @id @default(cuid())
  // Vrije, GUI-beheerde code (was een `GroupCode`-enum). Uniek, en de waarde die
  // shiften opslaan in `Shift.post` en de sessie meegeeft als `groups[].code`.
  code              String    @unique
  slug              String    @unique
  nameNl            String
  nameEn            String
  descriptionNl     String?
  descriptionEn     String?
  orderInPraesidium Int       @default(0)
  photoKey          String?
  // Praesidiumpost of werkgroep. Een werkgroep gebruikt dezelfde leden/rollen
  // maar staat niet op /praesidium; ze krijgt /werkgroepen met haar eigen
  // infotekst (description*, door de leden zelf bewerkbaar) en optionele website.
  type              GroupType @default(PRAESIDIUM)
  website           String?
  // Een gedeactiveerde post verdwijnt uit de nieuwe-shift-keuzes en het
  // postenbeheer voor nieuwe jaren, maar de historiek (memberships per jaar)
  // blijft bewaard i.p.v. de post te verwijderen.
  active            Boolean   @default(true)

  memberships       GroupMembership[]
  vaultPost         VaultPost?
  // Rollen die deze post toekent aan haar leden (DEFAULT) en verantwoordelijke (LEADER).
  roleGrants        GroupRole[]
  events            CalendarEvent[]
  dashboardTiles    DashboardTile[]
  ownedTicketEvents TicketEvent[]              @relation("TicketEventOwnerGroup")
  ticketEventGrants TicketEventGroupGrant[]
  ownedForms        Form[]                     @relation("FormOwnerGroup")
  formGrants        FormGroupGrant[]
  ssoGrants         SsoGroupClientPermission[]

  uitleenReservations UitleenReservation[]
  uitleenTransport    UitleenTransportBooking[]
  uitleenTemplates    UitleenRequestTemplate[]
  uitleenEventsGroup  UitleenEvent[]
  mailGroupSources    MailGroupSource[]
  expenses            Expense[]
}

model GroupMembership {
  id           String         @id @default(cuid())
  userId       String
  groupId      String
  role         MembershipRole @default(MEMBER)
  // Werkingsjaar (startjaar van het academiejaar): 2026 = "26-27". Elk jaar is
  // een aparte rij, zodat de historiek per post per jaar bewaard blijft en een
  // nieuw werkingsjaar automatisch met een lege post begint.
  year         Int
  titleNl      String?
  titleEn      String?
  displayOrder Int            @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, year])
  @@index([groupId])
  @@index([year])
}

// -----------------------------------------------------------------------------
// Wachtwoordkluis (Vaultwarden)
// -----------------------------------------------------------------------------
// De kluis zelf bewaart de wachtwoorden; hier staat enkel de koppeling. Bewust
// geen kopie van een wachtwoord in deze database: dan zou er een tweede bron
// zijn die uit de pas kan lopen, en zou elke backup ze meenemen.
// Zie docs/wachtwoorden.md.

/// Een post waarvan de wachtwoorden via de kluis lopen. Een post zonder rij hier
/// is niet gekoppeld: die leden krijgen geen account en geen collection.
model VaultPost {
  id           String    @id @default(cuid())
  groupId      String    @unique
  /// Uuid van de collection in Vaultwarden; leeg tot de eerste synchronisatie.
  collectionId String?
  /// Uuid van de groep in Vaultwarden.
  vaultGroupId String?
  enabled      Boolean   @default(true)
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

/// Waar een lid staat in de uitnodigingsstroom van de kluis. Het pad is
/// INVITED -> ACCEPTED -> CONFIRMED, en enkel een CONFIRMED lid kan iets lezen:
/// pas bij het bevestigen krijgt het de organisatiesleutel.
enum VaultMemberStatus {
  /// Uitgenodigd, maar nog nooit ingelogd. Heeft nog geen sleutelpaar en kan dus
  /// niet bevestigd worden. Een wachtstand, geen fout.
  INVITED
  /// Ingelogd en uitnodiging aanvaard; wacht op de eerstvolgende synchronisatie.
  ACCEPTED
  /// Bevestigd: heeft de organisatiesleutel en ziet de collections van zijn posten.
  CONFIRMED
}

model VaultMember {
  id          String            @id @default(cuid())
  userId      String            @unique
  /// Uuid van het organisatielidmaatschap in Vaultwarden.
  memberId    String?
  status      VaultMemberStatus @default(INVITED)
  invitedAt   DateTime?
  confirmedAt DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Google Workspace: de eigen adressen van de kring (activiteiten@vtk.be, ...)
// -----------------------------------------------------------------------------
// Bewust iets anders dan de opt-in mailinglijsten van Brevo: dit zijn
// ontvangende adressen van de vereniging zelf, en je staat erin omdat je in die
// post zit. Een lijst beschrijft daarom *wie erin hoort* (bronnen + extra's) en
// niet wie erin zit: de leden worden bij elke sync herberekend uit de posten van
// het huidige werkingsjaar, waardoor de 15-juli-wissel vanzelf goed loopt.
// Zie docs/design-decisions.md, "Google Workspace".

model MailGroup {
  id          String  @id @default(cuid())
  /// Volledig adres in kleine letters, bv. "activiteiten@vtk.be".
  email       String  @unique
  name        String
  description String?

  /// Immutable groeps-id van Google; leeg tot de eerste geslaagde sync.
  googleId String?

  /// Uit = wij raken de groep in Google niet meer aan. Ze blijft wel bestaan:
  /// aan een groepsadres hangt het archief en het staat op affiches en in
  /// mailhandtekeningen, dus de sync verwijdert nooit een groep.
  enabled Boolean @default(true)

  /// Mag iemand van buiten vtk.be naar dit adres mailen? Standaard ja, want dat
  /// is het punt van deze adressen. Met Google's default zou mail van een
  /// bedrijf naar moderatie of naar de prullenbak gaan.
  allowExternalSenders Boolean @default(true)

  lastSyncAt      DateTime?
  lastError       String?
  /// Aantal leden dat de laatste geslaagde sync in Google zette.
  lastMemberCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources MailGroupSource[]
  extras  MailGroupExtra[]

  @@index([enabled])
}

/// Een post of werkgroep waarvan de leden van dit werkingsjaar in de lijst
/// horen. Meerdere bronnen per lijst: `activiteiten@vtk.be` is "post
/// Activiteiten + post Groep 5". Dat g5 overal in zit, staat hier dus als
/// zichtbare rij en niet als verstopte regel in de code.
model MailGroupSource {
  id              String     @id @default(cuid())
  mailGroupId     String
  /// Precies één van de vier is ingevuld: een post/werkgroep, elke actieve
  /// groep van een soort, een hele kiesploeg, of één post binnen een kiesploeg.
  /// Bewust losse kolommen en geen polymorfe `type` + `id`: zo blijft de foreign
  /// key echt, en verdwijnt een bron vanzelf wanneer de post of de kiesploeg
  /// verdwijnt.
  groupId         String?
  /// "Elke actieve praesidiumpost" of "elke actieve werkgroep", in plaats van
  /// vijftien losse bronrijen. Dat is wat een adres als praesidium@vtk.be nodig
  /// heeft: één regel die ook nog klopt nadat er een post bijkomt. Datzelfde
  /// adres is meteen de sleutel tot de gedeelde drive; zie
  /// docs/design-decisions.md, "Gedeelde drives volgen de groepen".
  groupType       GroupType?
  kiesploegId     String?
  kiesploegPostId String?
  /// Enkel de verantwoordelijke (`role = LEAD`) i.p.v. elk lid.
  onlyLead        Boolean    @default(false)

  mailGroup     MailGroup      @relation(fields: [mailGroupId], references: [id], onDelete: Cascade)
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kiesploeg     Kiesploeg?     @relation(fields: [kiesploegId], references: [id], onDelete: Cascade)
  kiesploegPost KiesploegPost? @relation(fields: [kiesploegPostId], references: [id], onDelete: Cascade)

  @@unique([mailGroupId, groupId, onlyLead])
  @@unique([mailGroupId, groupType, onlyLead])
  @@unique([mailGroupId, kiesploegId, onlyLead])
  @@unique([mailGroupId, kiesploegPostId, onlyLead])
  @@index([groupId])
  @@index([kiesploegId])
  @@index([kiesploegPostId])
}

// -----------------------------------------------------------------------------
// Kiesploeg
// -----------------------------------------------------------------------------
// Een opkomende ploeg met een eigen postverdeling, die maanden vóór haar
// werkingsjaar al mailadressen nodig heeft. Bewust een eigen structuur en geen
// derde waarde in `GroupType`: haar posten zijn andere posten dan die van het
// praesidium, ze bestaat maar één jaar, en haar leden hebben een beperkt
// account tot ze aantreden. Wat gedeeld wordt met de posten is enkel de
// mailinglijst-machinerie (`MailGroupSource`).
// Zie docs/design-decisions.md, "Google Workspace".

model Kiesploeg {
  id           String  @id @default(cuid())
  /// Korte code die in elk adres terugkomt, bv. "2027".
  code         String  @unique
  /// Het werkingsjaar waarin ze aantreedt (2027 = "27-28"). Vanaf 15 juli van
  /// dat jaar worden haar leden volwaardig, op voorwaarde dat ze dan effectief
  /// in een post zitten.
  workingYear  Int
  /// De naam die VTK kiest, bv. "Kiesploeg Delta".
  formalName   String
  /// De naam die de ploeg zelf later kiest; mag lang leeg blijven. De adressen
  /// hangen aan de code en niet aan de naam, dus dit breekt niets.
  informalName String?

  /// Sjablonen voor de adressen, met {code}, {voornaam}, {achternaam} en {post}.
  /// Sjablonen en geen code, want de conventie verschilt nu al per ploeg.
  accountTemplate String @default("{voornaam}.{achternaam}")
  aliasTemplate   String @default("kiesploeg{code}.{voornaam}.{achternaam}")
  listTemplate    String @default("{post}.{code}")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts      KiesploegPost[]
  members    KiesploegMember[]
  mailGroups MailGroupSource[]
}

/// Een post binnen de kiesploeg. Dit zijn níét de praesidiumposten: ze hebben
/// eigen namen en bestaan enkel voor deze ploeg.
model KiesploegPost {
  id          String  @id @default(cuid())
  kiesploegId String
  /// Gaat in het lijstadres, bv. "marketing" -> marketing.2027@vtk.be.
  code        String
  name        String
  /// De g5 van de ploeg. Haar leden zitten in élke lijst van deze kiesploeg,
  /// zoals Groep 5 in elke postenlijst van het praesidium zit.
  isG5        Boolean @default(false)
  order       Int     @default(0)

  kiesploeg  Kiesploeg         @relation(fields: [kiesploegId], references: [id], onDelete: Cascade)
  members    KiesploegMember[]
  mailGroups MailGroupSource[]

  @@unique([kiesploegId, code])
  @@index([kiesploegId])
}

model KiesploegMember {
  id            String         @id @default(cuid())
  kiesploegId   String
  userId        String
  /// Leeg zolang de postverdeling nog niet gemaakt is: in het begin is enkel
  /// de g5 bekend.
  postId        String?
  role          MembershipRole @default(MEMBER)
  /// Override: dit lid mag nu al mailen vanaf zijn eigen adres (de
  /// marketingmensen). Wint van de afgeleide staat.
  mailboxActive Boolean        @default(false)
  /// Waar de mail naartoe gaat zolang de mailbox niet actief is.
  forwardTo     String?
  createdAt     DateTime       @default(now())

  kiesploeg Kiesploeg      @relation(fields: [kiesploegId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      KiesploegPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([kiesploegId, userId])
  @@index([userId])
  @@index([postId])
}

/// Waarom een adres los toegevoegd of net weggehouden wordt.
enum MailGroupExtraKind {
  /// Hoort er sowieso bij, ook zonder lidmaatschap (een oud-lid, een externe).
  INCLUDE
  /// Moet eruit, ook al zit de persoon in een bronpost. De uitzondering die je
  /// anders elk jaar opnieuw in Google zou moeten najagen.
  EXCLUDE
}

model MailGroupExtra {
  id          String             @id @default(cuid())
  mailGroupId String
  /// Kleine letters; een vrij adres, dus niet noodzakelijk van een lid.
  email       String
  kind        MailGroupExtraKind @default(INCLUDE)
  note        String?
  createdAt   DateTime           @default(now())

  mailGroup MailGroup @relation(fields: [mailGroupId], references: [id], onDelete: Cascade)

  @@unique([mailGroupId, email])
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique
  labelNl  String
  labelEn  String
  category String @default("general")

  roles RolePermission[]
}

// Een rol bundelt rechten. Leden krijgen rollen direct (UserRole) of via een
// post (GroupRole). Roldefinities blijven over de jaren heen bestaan; enkel de
// toewijzingen zijn werkingsjaar-gebonden (zie UserRole) en resetten op 15 juli.
// `system` markeert rollen die de GUI niet mag verwijderen (bv. admin).
model Role {
  id            String   @id @default(cuid())
  code          String   @unique
  nameNl        String
  nameEn        String
  descriptionNl String?
  descriptionEn String?
  // Optionele accentkleur voor de rol-pill in de UI (key in het paletsysteem).
  color         String?
  order         Int      @default(0)
  system        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
  groupGrants GroupRole[]
  pageGrants  PageEditorRole[]
  ssoGrants   SsoRoleClientPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Directe roltoewijzing aan een gebruiker, per werkingsjaar (2026 = "26-27").
// Net als GroupMembership per jaar: een nieuw werkingsjaar begint met een lege
// toewijzing (de 15-juli-reset) en de historiek blijft bewaard. De uitzondering
// die niet reset is `User.isSuperAdmin` (een boolean, geen toewijzing).
model UserRole {
  userId String
  roleId String
  year   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, year])
  @@index([userId])
  @@index([roleId])
  @@index([year])
}

// Rollen die een post automatisch toekent. DEFAULT geldt voor elk lid, LEADER
// enkel voor de verantwoordelijke (bovenop DEFAULT). Deze grants worden niet per
// persoon opgeslagen: de sessie-resolver leidt ze af uit de lidmaatschappen.
model GroupRole {
  groupId String
  roleId  String
  kind    RoleGrantKind @default(DEFAULT)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([groupId, roleId, kind])
  @@index([groupId])
  @@index([roleId])
}

// -----------------------------------------------------------------------------
// Header tabs & pages CMS
// -----------------------------------------------------------------------------

model HeaderTab {
  id        String  @id @default(cuid())
  code      String  @unique
  slug      String  @unique
  labelNl   String
  labelEn   String
  order     Int     @default(0)
  visible   Boolean @default(true)
  visibleNl Boolean @default(true)
  visibleEn Boolean @default(true)

  // Foto op de aanbod-kaart van deze werking op de homepage (storage-key,
  // uploadbaar via /admin/home). Zonder foto valt de kaart terug op het
  // gestreepte placeholder-patroon of de statische default in HomeEditorial.
  imageKey String?

  // Tekstje onder de titel op diezelfde aanbod-kaart ("Wat we doen"),
  // bewerkbaar via /admin/home. Leeg = de algemene standaardzin uit
  // lib/aanbodCards.ts.
  homeBodyNl String?
  homeBodyEn String?

  // Externe bestemming voor deze tab. Staat die ingevuld, dan linkt de header
  // rechtstreeks naar die site (in een nieuw tabblad) in plaats van naar de
  // categoriepagina /<slug>. Bv. Career -> career.vtk.be.
  externalUrl String?

  // Inhoud van de categoriepagina zelf, bewerkbaar via /admin/inhoud.
  introNl    String?
  introEn    String?
  // Optionele knop naast de titel (bv. cudi.vtk.be bij Cursusdienst).
  ctaLabelNl String?
  ctaLabelEn String?
  ctaUrl     String?

  pages Page[]
  links HeaderTabLink[]
}

/**
 * Extra items in het uitklapmenu van een headertab, naast de pagina's die onder
 * die tab hangen. Bedoeld voor werkingen met een eigen site: Career en
 * Cursusdienst hebben geen pagina's hier, maar wel bestemmingen waar leden
 * naartoe moeten (jobfair, boeken bestellen, ...).
 */
model HeaderTabLink {
  id       String  @id @default(cuid())
  tabId    String
  labelNl  String
  labelEn  String
  url      String
  order    Int     @default(0)
  // Foto op de kaart van dit item op de categoriepagina. Geldt zowel voor een
  // vaste route (/praesidium) als voor een externe link. Beheer via
  // /admin/header, net als Page.imageKey.
  imageKey String?

  tab HeaderTab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@unique([tabId, url])
  @@index([tabId])
}

/**
 * Aankondiging: het bericht dat als modal op de homepage verschijnt.
 * Meerdere aankondigingen mogen naast elkaar bestaan (elk met hun eigen
 * venster), zodat je ze vooraf kan klaarzetten; de homepage toont er hoogstens
 * één, en oude rijen blijven staan als historiek.
 */
model Announcement {
  id      String @id @default(cuid())
  titleNl String
  titleEn String
  /**
   * Markdown, bewerkt met de gedeelde MarkdownEditor.
   */
  bodyNl  String
  bodyEn  String

  ctaLabelNl String?
  ctaLabelEn String?
  ctaUrl     String?

  /**
   * Leeg = meteen zichtbaar / blijft zichtbaar.
   */
  startsAt DateTime?
  endsAt   DateTime?
  /**
   * Uit = nooit tonen, ongeacht het venster.
   */
  active   Boolean           @default(true)
  /**
   * Waar ze mag verschijnen: enkel de homepage, of elke publieke pagina.
   */
  scope    AnnouncementScope @default(HOME)

  createdById String?
  createdBy   User?    @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

enum AnnouncementScope {
  HOME
  SITE
}

/**
 * One configurable front page: the dark block at the top of the homepage.
 * Which front pages exist is decided in code, not here. Each one is its own
 * component with its own layout, free to look nothing like the others; a
 * 24-urenloop page wants lap counts, a jobfair page wants a wall of company
 * logos, and squeezing both into one shared template only produces the same page
 * with different words. See `apps/web/lib/frontpage/registry.ts`.
 * This table only carries what an admin may change without a deploy: which front
 * page is live and when, plus the values for the fields that that particular
 * component chose to expose. Hence `values` as JSON: every front page declares
 * its own fields, so there is no shared set of columns to model. A row whose
 * `layout` is no longer in the registry is ignored.
 * One row per front page (`layout` is unique). Scheduling the same event again
 * next year is a matter of moving its window, not of making a second row.
 */
model Frontpage {
  id String @id @default(cuid())

  /**
   * Registry id of the component this row configures ("default", "urenloop").
   */
  layout String @unique

  /**
   * Field values, keyed by the field names that this layout declares. Stored as
   * strings: an image holds a storage key, a moment holds an ISO timestamp.
   */
  values Json @default("{}")

  /**
   * Window in which this front page takes over. Both empty means it only shows
   * when switched on by hand. The "default" layout ignores these: it is the
   * fallback whenever nothing else is live.
   */
  startsAt DateTime?
  endsAt   DateTime?
  /**
   * Off = never show, whatever the window says.
   */
  active   Boolean   @default(false)

  updatedById String?
  updatedBy   User?    @relation("FrontpageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model Page {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  headerTabId           String?
  // Onafhankelijke navigatiekeuzes: een pagina kan als kaart op /<categorie>
  // staan zonder de hover-dropdown in de siteheader langer te maken.
  visibleInHeader       Boolean   @default(true)
  visibleOnCategoryPage Boolean   @default(true)
  titleNl               String
  titleEn               String?
  // Legacy tiptap-documenten. Markdown (contentMdNl/En) is de bron van waarheid;
  // deze JSON wordt enkel nog gerenderd zolang de pagina niet één keer in de
  // markdown-editor opgeslagen is.
  contentJsonNl         Json
  contentJsonEn         Json?
  contentMdNl           String?
  contentMdEn           String?
  excerptNl             String?
  excerptEn             String?
  // Foto op de kaart van deze pagina op de categoriepagina (`/info`, ...),
  // uploadbaar in /admin/header en /admin/paginas. Zelfde soort veld als
  // `HeaderTabLink.imageKey`: een storage-key, geen URL. Zonder foto toont de
  // kaart het technische patroon uit de huisstijl.
  imageKey              String?
  // Optionele knop naast de titel, dezelfde velden als op HeaderTab. Voor een
  // pagina die een aparte app beschrijft (Uitleendienst -> logistiek, Shiften ->
  // de shiftenlijst) hoort die app één klik ver te staan en niet ergens
  // halverwege de tekst.
  ctaLabelNl            String?
  ctaLabelEn            String?
  ctaUrl                String?
  // Jaarlijks na te kijken pagina (namen, telefoonnummers, ...): komt bovenaan
  // het paginabeheer te staan zolang ze dit werkingsjaar niet bewerkt is.
  needsYearlyEdit       Boolean   @default(false)
  // Laatste keer dat de INHOUD via de editor opgeslagen is. updatedAt telt niet:
  // die verschuift ook bij structuurwijzigingen (verslepen, hernoemen, ...).
  contentEditedAt       DateTime?
  publishedAt           DateTime?
  order                 Int       @default(0)
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Zoekvectoren voor /zoeken, één per taalconfiguratie. Een trigger houdt ze
  // bij (zie de migratie `search_vectors`); Prisma schrijft ze nooit zelf en
  // kent het type niet, dus ze staan hier enkel zodat schema en database niet
  // uiteenlopen. Bevraagd wordt er via ruwe SQL in `lib/search-server.ts`.
  searchNl Unsupported("tsvector")?
  searchEn Unsupported("tsvector")?

  headerTab   HeaderTab?       @relation(fields: [headerTabId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assets      PageAsset[]
  editorRoles PageEditorRole[]
  /// Het formulier dat in deze pagina staat, als er een gekoppeld is.
  form        Form?

  @@index([headerTabId])
  @@index([searchNl], type: Gin)
  @@index([searchEn], type: Gin)
}

// Rollen die de inhoud van een pagina mogen bewerken (naast superadmin en
// pages.editAll). Een pagina zonder rijen hier is vergrendeld voor gewone
// pages.edit-houders.
model PageEditorRole {
  pageId String
  roleId String

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([pageId, roleId])
  @@index([roleId])
}

model PageAsset {
  id         String        @id @default(cuid())
  pageId     String
  storageKey String
  kind       PageAssetKind
  labelNl    String
  labelEn    String?
  sizeBytes  Int?
  mimeType   String?
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

// -----------------------------------------------------------------------------
// Calendar
// -----------------------------------------------------------------------------

model CalendarEvent {
  id            String    @id @default(cuid())
  /// De publieke URL-naam: `/kalender/galabal-2026`. Titel plus jaartal, want
  /// Galabal en Beiaardcantus komen elk jaar terug en het jaartal is precies wat
  /// iemand intikt. Zie packages/db/src/slug.ts.
  ///
  /// Deelt het routesegment `[slugOrId]` met de categorieslugs, dus uniek over
  /// beide tabellen; de action bewaakt dat. Het jaartal maakt een botsing daar in
  /// de praktijk al onmogelijk, want een categorieslug eindigt nooit op een jaar.
  slug          String    @unique
  titleNl       String
  titleEn       String?
  descriptionNl String?
  descriptionEn String?
  location      String?
  start         DateTime
  end           DateTime
  allDay        Boolean   @default(false)
  url           String?
  imageKey      String?
  /// Welk punt van de foto in beeld moet blijven wanneer ze bijgesneden wordt:
  /// 0..1, met (0, 0) linksboven. De site toont dezelfde foto in drie
  /// verhoudingen (16/9 op de homepage, 16/10 op de eventpagina, 4/3 op een
  /// telefoon), dus een vaste uitsnede bestaat niet; dit punt is wat elk formaat
  /// centraal houdt en gaat als `object-position` mee.
  ///
  /// Bewust niet-destructief: de upload blijft ongewijzigd, zodat de uitsnede
  /// achteraf nog te verleggen is. Een affiche waar de tekst bovenaan staat is
  /// zo te redden zonder de foto opnieuw te uploaden.
  imageFocusX   Float     @default(0.5)
  imageFocusY   Float     @default(0.5)
  groupId       String
  createdById   String?
  // NULL = concept. Een concept blijft wel zichtbaar en bewerkbaar in de admin,
  // maar verschijnt nergens op de publieke site of in een agenda-feed.
  publishedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Zie de gelijknamige velden op `Page`: door een trigger onderhouden
  // zoekvectoren, enkel via ruwe SQL bevraagd.
  searchNl Unsupported("tsvector")?
  searchEn Unsupported("tsvector")?

  /// Wanneer het bericht "er staat iets nieuws in een categorie die je volgt"
  /// voor dit evenement verstuurd is. Wordt geclaimd voor er iets vertrekt, en
  /// nooit teruggezet: bij twijfel liever geen bericht dan twee.
  announcedPushAt DateTime? @db.Timestamptz(3)

  /// Voorrang of uitsluiting in het weekoverzicht op de homepage. Zie
  /// `HeroWeekPlacement` en apps/web/lib/calendar/heroWeek.ts; enkel te zetten
  /// met de permissie `calendar.heroWeek`.
  heroWeek HeroWeekPlacement @default(AUTO)

  group          Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy      User?                        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  ticketEvent    TicketEvent?
  form           Form?
  /// Het logistiek-evenement dat bij dit kalenderevenement hoort (E1). Ontstaat
  /// enkel wanneer iemand in de admin "Logistiek nodig" aanvinkt.
  uitleenEvent   UitleenEvent?
  categories     CalendarEventCategory[]
  interests      CalendarEventInterest[]
  guestInterests CalendarEventGuestInterest[]

  @@index([start])
  @@index([publishedAt, announcedPushAt])
  @@index([groupId])
  @@index([searchNl], type: Gin)
  @@index([searchEn], type: Gin)
}

/// Wat dit evenement doet in het weekoverzicht van de hero op de homepage.
///
/// Het overzicht kiest normaal zelf: het toont de dagen van het rollende venster
/// en kapt af op drie events per dag en tien in totaal. Deze twee uitzonderingen
/// bestaan omdat die keuze soms fout uitpakt. `PINNED` zet een evenement vooraan
/// op zijn dag en beschermt het tegen die kap; `HIDDEN` houdt het volledig uit
/// het overzicht, bijvoorbeeld een interne vergadering die wel in de kalender
/// hoort maar niet op de homepage.
///
/// Dit raakt **alleen** de homepage. Een verborgen evenement blijft gewoon in de
/// kalender, in de feeds en in de app staan; dit is geen zichtbaarheidsregel en
/// dus ook geen vervanging van een concept.
enum HeroWeekPlacement {
  AUTO
  PINNED
  HIDDEN
}

// Doelgroep waar een categorie voor staat. Een categorie zonder `audience` is een
// gewoon thema (Career, Sport, ...) dat iedereen ziet en dat als filterchip op
// /kalender staat. Een categorie mét `audience` verschijnt in de aparte rij met
// doelgroepfilters. Alle evenementen zijn standaard zichtbaar; profielmatching
// is een expliciete voorkeur van de bezoeker.
//
// De waarde is een enum en geen vrij veld, want bij elke waarde hoort code die
// bepaalt of een lid erbij hoort (zie lib/calendar/audience.ts). Een nieuwe
// doelgroep toevoegen is dus bewust geen GUI-actie.
enum CalendarAudience {
  FIRST_YEARS
  INTERNATIONALS
  LAST_YEARS
  ALUMNI
}

model CalendarCategory {
  id                 String            @id @default(cuid())
  // Zit in de publieke URL en in de feed-URL, dus wijzigen breekt bestaande
  // abonnementen; daarom niet vrij bewerkbaar zodra hij in gebruik is.
  slug               String            @unique
  nameNl             String
  nameEn             String
  // Introtekst bovenaan de categoriepagina (Markdown), optioneel.
  descriptionNl      String?
  descriptionEn      String?
  // Hexkleur van het bolletje in de legende en van de eventpil in het raster.
  colour             String            @default("#5C667F")
  order              Int               @default(0)
  // NULL = gewoon thema. Anders: doelgroepcategorie, zie de enum hierboven.
  audience           CalendarAudience?
  // Uit = de categorie bestaat nog (feed en pagina blijven werken) maar staat
  // niet meer tussen de filterchips op /kalender.
  showOnCalendarPage Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    CalendarEventCategory[]
  followers CalendarCategoryFollow[]

  @@index([order])
}

model CalendarEventCategory {
  eventId    String
  categoryId String

  event    CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category CalendarCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@index([categoryId])
}

// Persoonlijke ICS-feed van één lid: ledenexclusieve events, zijn shiften en de
// events waarvoor hij een ticket heeft. Een agenda-client stuurt geen cookies,
// dus de URL draagt zelf het geheim; we bewaren enkel de hash.
//
// Bewust **zonder `expiresAt`**, anders dan DoorShortcutToken: een abonnement dat
// na 90 dagen stil ophoudt met verversen is erger dan geen abonnement, want de
// agenda blijft dan verouderde events tonen zonder dat iemand het merkt.
// Intrekken gebeurt expliciet vanuit /account.
model CalendarFeedToken {
  id         String    @id @default(cuid())
  userId     String
  label      String
  tokenHash  String    @unique
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// -----------------------------------------------------------------------------
// Integrated ticketing
// -----------------------------------------------------------------------------

model TicketEvent {
  id                    String            @id @default(cuid())
  calendarEventId       String?           @unique
  ownerGroupId          String
  slug                  String            @unique
  titleNl               String
  titleEn               String?
  descriptionNl         String?
  descriptionEn         String?
  // `location` blijft de vrije naam die bezoekers zien ("Theokot"). Het adres
  // is optioneel en dient om coördinaten op te zoeken; enkel wanneer die
  // gevonden zijn, krijgt een walletticket een geofence en komt het vanzelf op
  // het vergrendelscherm bij aankomst.
  location              String?
  locationAddress       String?
  locationLatitude      Float?
  locationLongitude     Float?
  startsAt              DateTime          @db.Timestamptz(3)
  endsAt                DateTime          @db.Timestamptz(3)
  timeZone              String            @default("Europe/Brussels")
  salesStartAt          DateTime?         @db.Timestamptz(3)
  salesEndAt            DateTime?         @db.Timestamptz(3)
  status                TicketEventStatus @default(DRAFT)
  currency              String            @default("EUR")
  maxTicketsPerOrder    Int               @default(8)
  // Aanmelden met de studentenkaart aan de deur (cantus). Staat dit aan, dan
  // koppelt de kassa het r-nummer van de ingelogde koper aan zijn ticket en kan
  // de scanner een gescande kaart tot een ticket herleiden.
  cardCheckIn           Boolean           @default(false)
  // Staat de scanlijst open voor elke praesidiumpost, en voor de leden van de
  // eigenaarsgroep wanneer die een werkgroep is? Uit zetten voor een event met
  // een gevoelige gastenlijst; dan telt enkel wie een expliciete grant heeft.
  // Wie kan scannen, ziet namelijk de namen van alle deelnemers: het
  // offline-manifest draagt die lijst mee naar het toestel.
  openScanning          Boolean           @default(true)
  contactEmail          String?
  termsUrl              String?
  termsVersion          String?
  confirmationMessageNl String?
  confirmationMessageEn String?
  settings              Json              @default("{}")
  createdById           String?
  publishedAt           DateTime?         @db.Timestamptz(3)
  archivedAt            DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  ownerGroup    Group          @relation("TicketEventOwnerGroup", fields: [ownerGroupId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("TicketEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  inventoryPools TicketInventoryPool[]
  ticketTypes    TicketType[]
  questions      TicketQuestion[]
  userGrants     TicketEventUserGrant[]
  groupGrants    TicketEventGroupGrant[]
  orders         TicketOrder[]
  orderItems     TicketOrderItem[]
  tickets        Ticket[]
  gates          TicketGate[]
  scanDevices    TicketScanDevice[]
  scanLogs       TicketScanLog[]
  auditLogs      TicketAuditLog[]
  outboxMessages TicketOutboxMessage[]

  @@index([ownerGroupId])
  @@index([status, salesStartAt, salesEndAt])
  @@index([startsAt])
}

model TicketInventoryPool {
  id            String   @id @default(cuid())
  eventId       String
  code          String
  nameNl        String
  nameEn        String?
  capacity      Int
  reservedCount Int      @default(0)
  soldCount     Int      @default(0)
  version       Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  event       TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  orderItems  TicketOrderItem[]

  @@unique([eventId, code])
  @@unique([id, eventId])
  @@index([eventId, active])
}

model TicketType {
  id              String         @id @default(cuid())
  eventId         String
  inventoryPoolId String
  code            String
  nameNl          String
  nameEn          String?
  descriptionNl   String?
  descriptionEn   String?
  unitPriceCents  Int
  currency        String         @default("EUR")
  audience        TicketAudience @default(PUBLIC)
  // Key uit het palet in `apps/web/lib/ticketing/ticketColors.ts`, geen vrije
  // hexwaarde: de scanner kleurt hiermee een vlak van een halve telefoon groot
  // en een zelfgekozen kleur is daar vroeg of laat onleesbaar op. Aan een cantus
  // is dit het verschil tussen water, bier en eigen drank.
  color           String         @default("navy")
  salesStartAt    DateTime?      @db.Timestamptz(3)
  salesEndAt      DateTime?      @db.Timestamptz(3)
  minPerOrder     Int            @default(1)
  maxPerOrder     Int            @default(8)
  active          Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  event         TicketEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventoryPool TicketInventoryPool @relation(fields: [inventoryPoolId, eventId], references: [id, eventId], onDelete: Restrict)
  questions     TicketQuestion[]
  orderItems    TicketOrderItem[]

  @@unique([eventId, code])
  @@unique([id, eventId])
  @@index([eventId, active, sortOrder])
  @@index([inventoryPoolId])
}

model TicketQuestion {
  id            String             @id @default(cuid())
  eventId       String
  ticketTypeId  String?
  code          String
  labelNl       String
  labelEn       String?
  descriptionNl String?
  descriptionEn String?
  type          TicketQuestionType
  required      Boolean            @default(false)
  options       Json?
  active        Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  event      TicketEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType?             @relation(fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: Restrict)
  answers    TicketOrderItemAnswer[]

  @@unique([eventId, code])
  @@unique([id, eventId])
  @@index([eventId, active, sortOrder])
  @@index([ticketTypeId])
}

model TicketEventUserGrant {
  id          String          @id @default(cuid())
  eventId     String
  userId      String
  role        TicketGrantRole
  grantedById String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  event     TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User        @relation("TicketEventGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?       @relation("TicketEventGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
}

model TicketEventGroupGrant {
  id          String                @id @default(cuid())
  eventId     String
  groupId     String
  role        TicketGrantRole
  scope       TicketGroupGrantScope @default(ALL_MEMBERS)
  grantedById String?
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)

  event     TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedBy User?       @relation("TicketEventGroupGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([eventId, groupId])
  @@index([groupId])
}

model TicketOrder {
  id                   String            @id @default(cuid())
  eventId              String
  reference            String            @unique
  accessTokenHash      String            @unique
  accessExpiresAt      DateTime          @db.Timestamptz(3)
  requestFingerprint   String?
  buyerUserId          String?
  buyerName            String
  buyerEmail           String
  locale               Locale            @default(NL)
  status               TicketOrderStatus @default(PENDING_PAYMENT)
  currency             String            @default("EUR")
  subtotalCents        Int
  discountCents        Int               @default(0)
  totalCents           Int
  refundedCents        Int               @default(0)
  reservationExpiresAt DateTime?         @db.Timestamptz(3)
  termsAcceptedAt      DateTime?         @db.Timestamptz(3)
  termsVersion         String?
  paidAt               DateTime?         @db.Timestamptz(3)
  failedAt             DateTime?         @db.Timestamptz(3)
  expiredAt            DateTime?         @db.Timestamptz(3)
  cancelledAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  event          TicketEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  buyer          User?                 @relation("TicketOrderBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  items          TicketOrderItem[]
  payments       TicketPayment[]
  refunds        TicketRefund[]
  outboxMessages TicketOutboxMessage[]

  @@unique([id, eventId])
  @@index([eventId, status, createdAt])
  @@index([eventId, requestFingerprint, createdAt])
  @@index([buyerUserId])
  @@index([buyerEmail])
  @@index([status, reservationExpiresAt])
}

// Each order item represents exactly one attendee and can issue at most one ticket.
model TicketOrderItem {
  id              String   @id @default(cuid())
  eventId         String
  orderId         String
  ticketTypeId    String
  inventoryPoolId String
  ticketTypeCode  String
  ticketTypeName  String
  unitPriceCents  Int
  discountCents   Int      @default(0)
  totalCents      Int
  attendeeName    String
  attendeeEmail   String?
  // KU Leuven-nummer van de deelnemer, kleine letters, enkel gevuld wanneer het
  // event `cardCheckIn` aan heeft staan. Hierop landt een gescande
  // studentenkaart. Wordt gewist wanneer het event gearchiveerd wordt.
  rNumber         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  event         TicketEvent             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order         TicketOrder             @relation(fields: [orderId, eventId], references: [id, eventId], onDelete: Restrict)
  ticketType    TicketType              @relation(fields: [ticketTypeId, eventId], references: [id, eventId], onDelete: Restrict)
  inventoryPool TicketInventoryPool     @relation(fields: [inventoryPoolId, eventId], references: [id, eventId], onDelete: Restrict)
  answers       TicketOrderItemAnswer[]
  ticket        Ticket?
  refundItems   TicketRefundItem[]

  @@unique([id, eventId])
  @@unique([id, orderId])
  // Eén r-nummer kan per event maar aan één ticket hangen, anders weet een
  // gescande kaart niet welk ticket ze bedoelt. Postgres telt NULL's als
  // verschillend, dus tickets zonder r-nummer botsen hier niet.
  @@unique([eventId, rNumber])
  @@index([orderId])
  @@index([eventId, ticketTypeId])
  @@index([inventoryPoolId])
}

model TicketOrderItemAnswer {
  id            String   @id @default(cuid())
  eventId       String
  orderItemId   String
  questionId    String
  questionCode  String
  questionLabel String
  value         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  orderItem TicketOrderItem @relation(fields: [orderItemId, eventId], references: [id, eventId], onDelete: Restrict)
  question  TicketQuestion  @relation(fields: [questionId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([orderItemId, questionId])
  @@index([questionId])
}

model TicketPayment {
  id                 String              @id @default(cuid())
  orderId            String
  provider           String
  providerCheckoutId String?
  providerPaymentId  String?
  idempotencyKey     String
  status             TicketPaymentStatus @default(CREATED)
  amountCents        Int
  currency           String              @default("EUR")
  checkoutUrl        String?
  providerStatus     String?
  expiresAt          DateTime?           @db.Timestamptz(3)
  succeededAt        DateTime?           @db.Timestamptz(3)
  failedAt           DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  order    TicketOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhooks TicketPaymentWebhook[]
  refunds  TicketRefund[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])
  @@unique([id, orderId])
  @@index([orderId, status])
  @@index([status, expiresAt])
}

model TicketPaymentWebhook {
  id                 String    @id @default(cuid())
  provider           String
  externalEventId    String
  paymentId          String?
  signatureValid     Boolean
  payload            Json
  processingAttempts Int       @default(0)
  receivedAt         DateTime  @default(now()) @db.Timestamptz(3)
  processedAt        DateTime? @db.Timestamptz(3)
  lastError          String?

  payment TicketPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@index([processedAt, receivedAt])
}

model Ticket {
  id                String       @id @default(cuid())
  eventId           String
  orderItemId       String       @unique
  publicCode        String       @unique
  credentialHash    String       @unique
  credentialVersion Int          @default(1)
  status            TicketStatus @default(VALID)
  issuedAt          DateTime     @default(now()) @db.Timestamptz(3)
  checkedInAt       DateTime?    @db.Timestamptz(3)
  checkedInById     String?
  voidedAt          DateTime?    @db.Timestamptz(3)
  refundedAt        DateTime?    @db.Timestamptz(3)
  // Immutable copy of the published ticket design at issue time. Existing
  // tickets deliberately remain null and use the Classic renderer fallback.
  designSnapshot    Json?

  event       TicketEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItem   TicketOrderItem @relation(fields: [orderItemId, eventId], references: [id, eventId], onDelete: Restrict)
  checkedInBy User?           @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  scanLogs    TicketScanLog[]

  @@unique([id, eventId])
  @@unique([orderItemId, eventId])
  @@index([eventId, status])
  @@index([eventId, checkedInAt])
  @@index([checkedInById])
}

model TicketRefund {
  id               String             @id @default(cuid())
  orderId          String
  paymentId        String
  provider         String
  providerRefundId String?
  idempotencyKey   String
  status           TicketRefundStatus @default(PENDING)
  amountCents      Int
  currency         String             @default("EUR")
  reason           String?
  requestedById    String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)

  order       TicketOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     TicketPayment      @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict)
  requestedBy User?              @relation("TicketRefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  items       TicketRefundItem[]

  @@unique([provider, providerRefundId])
  @@unique([provider, idempotencyKey])
  @@unique([id, orderId])
  @@index([orderId, status])
  @@index([paymentId])
  @@index([requestedById])
}

model TicketRefundItem {
  id          String @id @default(cuid())
  orderId     String
  refundId    String
  orderItemId String
  amountCents Int

  refund    TicketRefund    @relation(fields: [refundId, orderId], references: [id, orderId], onDelete: Restrict)
  orderItem TicketOrderItem @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

model TicketGate {
  id        String   @id @default(cuid())
  eventId   String
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  event    TicketEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanLogs TicketScanLog[]

  @@unique([eventId, code])
  @@unique([id, eventId])
  @@index([eventId, active])
}

model TicketScanDevice {
  id          String    @id @default(cuid())
  eventId     String
  label       String
  tokenHash   String    @unique
  createdById String?
  lastSeenAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  event     TicketEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("TicketScanDeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  scanLogs  TicketScanLog[]

  @@unique([id, eventId])
  @@index([eventId, revokedAt])
  @@index([createdById])
}

model TicketScanLog {
  id                    String           @id @default(cuid())
  eventId               String
  ticketId              String?
  scannerUserId         String?
  deviceId              String?
  gateId                String?
  clientScanId          String           @unique
  result                TicketScanResult
  credentialFingerprint String?
  scannedAt             DateTime         @default(now()) @db.Timestamptz(3)
  clientScannedAt       DateTime?        @db.Timestamptz(3)
  reversesScanId        String?          @unique
  metadata              Json?

  event        TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket       Ticket?           @relation(fields: [ticketId, eventId], references: [id, eventId], onDelete: Restrict)
  scannerUser  User?             @relation("TicketScanActor", fields: [scannerUserId], references: [id], onDelete: SetNull)
  device       TicketScanDevice? @relation(fields: [deviceId, eventId], references: [id, eventId], onDelete: Restrict)
  gate         TicketGate?       @relation(fields: [gateId, eventId], references: [id, eventId], onDelete: Restrict)
  reversesScan TicketScanLog?    @relation("TicketScanReversal", fields: [reversesScanId], references: [id], onDelete: Restrict)
  reversedBy   TicketScanLog?    @relation("TicketScanReversal")

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([scannerUserId])
  @@index([deviceId])
  @@index([gateId])
}

model TicketAuditLog {
  id          String   @id @default(cuid())
  eventId     String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  event     TicketEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actorUser User?       @relation("TicketAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([eventId, entityType, entityId])
  @@index([actorUserId])
}

model TicketOutboxMessage {
  id          String             @id @default(cuid())
  eventId     String?
  orderId     String?
  type        String
  dedupeKey   String             @unique
  recipient   String?
  payload     Json
  status      TicketOutboxStatus @default(PENDING)
  attempts    Int                @default(0)
  availableAt DateTime           @default(now()) @db.Timestamptz(3)
  lockedAt    DateTime?          @db.Timestamptz(3)
  lockedBy    String?
  lastError   String?
  sentAt      DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  event TicketEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order TicketOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([eventId])
  @@index([orderId])
}

// -----------------------------------------------------------------------------
// Photo albums
// -----------------------------------------------------------------------------

model PhotoAlbum {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleNl       String
  titleEn       String?
  descriptionNl String?
  descriptionEn String?
  coverPhotoId  String?   @unique
  eventDate     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coverPhoto Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos     Photo[] @relation("AlbumPhotos")
}

model Photo {
  id           String    @id @default(cuid())
  albumId      String
  storageKey   String
  thumbnailKey String?
  width        Int?
  height       Int?
  sizeBytes    Int?
  originalName String?
  takenAt      DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())

  album        PhotoAlbum  @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: Cascade)
  coverOfAlbum PhotoAlbum? @relation("AlbumCover")

  @@index([albumId])
}

// -----------------------------------------------------------------------------
// POCs (student representatives per study track)
// -----------------------------------------------------------------------------

model Poc {
  id            String  @id @default(cuid())
  slug          String  @unique
  nameNl        String
  nameEn        String?
  /// Eén adres voor de hele POC (bv. wtk-poc@vtk.be). Studenten mailen de POC,
  /// niet een individuele vertegenwoordiger; die adressen tonen we nergens.
  email         String?
  descriptionNl String?
  descriptionEn String?
  order         Int     @default(0)

  // Aan welke richtingen deze POC hangt. Dit is de enige koppeling met een
  // studierichting: het is de machineleesbare link naar `User.studyProgrammes`,
  // zodat de homepage de POC's van jouw richtingen kan tonen. Meerdere richtingen
  // per POC kan: één POC bedient soms verschillende opleidingen.
  studyProgrammes StudyProgramme[] @default([])

  representatives PocRepresentative[]
}

model PocRepresentative {
  id     String  @id @default(cuid())
  pocId  String
  userId String
  year   Int
  roleNl String?
  roleEn String?
  order  Int     @default(0)

  poc  Poc  @relation(fields: [pocId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pocId, userId, year])
  @@index([pocId])
  @@index([year])
}

// -----------------------------------------------------------------------------
// Partners
// -----------------------------------------------------------------------------

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoKey   String
  url       String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Settings (key/value JSON, drives the editable homepage and opening hours)
// -----------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Admin dashboard tiles (configurable launchpad links)
// -----------------------------------------------------------------------------

model DashboardTile {
  id        String             @id @default(cuid())
  label     String
  url       String
  icon      String             @default("link") // key into curated icon set
  color     String             @default("navy") // key into color palette
  // Eigen logo in plaats van een pictogram (bv. het GitHub-logo). Wanneer dit
  // gezet is, wint het van `icon`; `icon` blijft staan zodat het terugvalt op
  // het gekozen pictogram wanneer de afbeelding verwijderd wordt.
  imageKey  String?
  scope     DashboardTileScope
  groupId   String? // set when scope = GROUP
  userId    String? // set when scope = USER (personal tile)
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  group Group?                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs UserDashboardTilePref[]

  @@index([scope])
  @@index([groupId])
  @@index([userId])
}

// Per-user override of a shared (GLOBAL/GROUP) tile: hide it, reorder it, or
// override its display fields. Personal (USER) tiles are edited directly.
model UserDashboardTilePref {
  userId       String
  tileId       String
  hidden       Boolean @default(false)
  order        Int?
  label        String? // null = inherit from the default tile
  url          String?
  icon         String?
  color        String?
  // Eigen logo bovenop een gedeelde tegel. `imageCleared` onderscheidt "erf de
  // afbeelding van de standaardtegel" (null + false) van "ik wil hier bewust
  // geen afbeelding maar een pictogram" (null + true).
  imageKey     String?
  imageCleared Boolean @default(false)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tile DashboardTile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@id([userId, tileId])
  @@index([userId])
}

// Vastgepinde admin-tabs per gebruiker. Gekeyd op de nav-`key` uit
// lib/admin-nav.ts en niet op het pad: een tab die later verhuist houdt zo zijn
// pin. Een pin op een tab die de gebruiker niet (meer) mag zien, rendert
// gewoon niet; de rij mag blijven staan tot hij het recht terugkrijgt.
model UserAdminNavPin {
  userId String
  key    String
  order  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Shifts
// -----------------------------------------------------------------------------

model Shift {
  id String @id @default(cuid())

  participantIds Int[]
  participants   ShiftParticipant[]

  name            String
  startTime       DateTime
  endTime         DateTime
  location        String
  description     String
  maxParticipants Int
  reward          Int

  // Kan je deze shift doen zonder Nederlands? Dan krijgt ze de markering "Ook
  // voor internationals" op /shift. Het gaat over de taal, niet over wie welkom
  // is: iedereen mag inschrijven.
  openToInternationals Boolean @default(false)

  // Langere uitleg (Markdown) over wat de shift concreet inhoudt, los van de
  // korte `description`. Leeg (NULL of "") = de frontend toont het blok niet.
  instructions String?

  // Postcode (Group.code) waarvoor deze shift telt; los tekstveld i.p.v. een
  // relatie, zodat een oude postcode behouden blijft ook als de post later
  // gedeactiveerd of hernoemd wordt.
  post String?
  // Ook een field bijhouden voor het evenement waarbij de shift hoort?

  // Herkomst van een gespiegelde shift. Cursusdienst-shiften worden op
  // cudi.vtk.be aangemaakt en hierheen gespiegeld; `sourceSystem` ("cudi") +
  // `sourceId` (de cudi-shift-id) maken die spiegeling idempotent en markeren
  // dat main-admins ze niet manueel beheren. Native VTK-shiften laten beide
  // leeg (NULL, en NULLs botsen niet in de unieke index). Zie
  // docs/design-decisions.md, "Cursusdienst-shiften op de main site".
  sourceSystem String?
  sourceId     String?

  @@unique([sourceSystem, sourceId])
}

model ShiftParticipant {
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // `payedOut` blijft de compatibele "volledig uitbetaald"-vlag voor bestaande
  // API-consumers. `rewardPaid` bewaart het exacte aantal toegekende bonnetjes,
  // zodat een shift ook gedeeltelijk kan worden uitbetaald.
  payedOut   Boolean
  rewardPaid Int     @default(0)

  /// Moment van inschrijven: binnen een korte bedenktijd mag je je nog
  /// uitschrijven, ook wanneer de shift al binnen 24 uur begint.
  registeredAt DateTime @default(now())

  /// Wanneer de herinnering afgehandeld is: verstuurd, of bewust overgeslagen
  /// (wie zich twee uur op voorhand inschrijft, hoeft geen mail van een dag
  /// vooraf meer). Leeg = staat nog te wachten. De samengestelde sleutel
  /// hieronder maakt dat er per persoon per shift maar één van elk kan bestaan.
  reminderDayBeforeAt DateTime?
  reminderSoonAt      DateTime?

  @@id([shiftId, userId])
}

// -----------------------------------------------------------------------------
// Short links (on.vtk.be/<slug> -> target URL)
// -----------------------------------------------------------------------------

model ShortLink {
  id          String    @id @default(cuid())
  slug        String    @unique
  url         String
  enabled     Boolean   @default(true)
  clicks      Int       @default(0)
  note        String?
  expiresAt   DateTime? // when set, the link stops resolving after this instant
  createdById String?
  createdBy   User?     @relation("ShortLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// Theokot (cafetaria / broodjesbar) reservatiesysteem
//
// Zie docs/design-decisions.md voor de niet-vanzelfsprekende keuzes achter dit
// systeem (bestelvenster, annulatie-deadline, no-show/ban-logica, turf-lijst,
// snapshots i.p.v. live catalogus).
// -----------------------------------------------------------------------------

/// Catalogus met het standaardaanbod. Prijs in eurocent (Int, geen floats).
/// Bij het aanmaken van een week worden deze rijen naar `TheokotSessionItem`
/// gekopieerd (snapshot), zodat latere catalogus-edits oude sessies niet wijzigen.
model TheokotProduct {
  id                  String   @id @default(cuid())
  nameNl              String
  nameEn              String?
  priceCents          Int
  defaultQuantity     Int      @default(0)
  isWeeklySpecialSlot Boolean  @default(false) // "broodje van de week"-slot
  imageKey            String? // optionele foto; NULL = gestreept patroon
  ingredientsNl       String? // optionele ingrediëntenlijst (info-icoontje)
  ingredientsEn       String?
  order               Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Eén verkoopsessie = één open dag. Uren en aanbod zijn per dag aanpasbaar;
/// `isOpen=false` betekent dat Theokot die dag dicht is. De venster-momenten
/// (order/pickup) worden bij aanmaak berekend uit config + Brussel-tijd en
/// opgeslagen zodat ze daarna manueel bijgesteld kunnen worden.
model TheokotSession {
  id                   String    @id @default(cuid())
  date                 DateTime  @unique // lokale middernacht van de verkoopdag
  isOpen               Boolean   @default(true)
  orderOpenAt          DateTime // vanaf wanneer studenten kunnen bestellen
  orderCloseAt         DateTime // annulatie-/besteldeadline (turf-lijst wordt geprint)
  pickupStart          DateTime
  pickupEnd            DateTime
  weeklySpecialLabelNl String? // welk broodje deze week "van de week" is
  weeklySpecialLabelEn String?
  processedAt          DateTime? // wanneer no-shows verwerkt zijn (idempotentie)
  processingStartedAt  DateTime? // lease/claim voor een actieve no-show-worker
  /// Wanneer het pushbericht "de bestelronde is open" voor deze dag vertrokken
  /// is. Zelfde claim-dan-versturen-aanpak als `TheokotOrder.pickupPushedAt`.
  orderOpenPushedAt    DateTime? @db.Timestamptz(3)
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items  TheokotSessionItem[]
  orders TheokotOrder[]

  @@index([date])
  @@index([processedAt, isOpen, pickupEnd])
  @@index([isOpen, orderOpenPushedAt, orderOpenAt])
}

/// Aanbod van één sessie (snapshot van een product op het moment van aanmaken).
model TheokotSessionItem {
  id              String  @id @default(cuid())
  sessionId       String
  productId       String? // herkomst-catalogusitem, puur informatief
  nameNl          String
  nameEn          String?
  priceCents      Int
  quantity        Int // beschikbare voorraad voor deze sessie
  isWeeklySpecial Boolean @default(false)
  imageKey        String? // meegekopieerd uit de catalogus, per dag aanpasbaar
  ingredientsNl   String?
  ingredientsEn   String?
  order           Int     @default(0)

  session             TheokotSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lines               TheokotOrderLine[]
  /// Broodjes die voor een vergadering (GM/Bureau) op dit item gereserveerd zijn.
  /// Ze gaan van dezelfde voorraad af en staan apart op de turflijst.
  meetingReservations MeetingReservation[]

  @@index([sessionId])
}

/// Eén bestelling per persoon per sessie.
model TheokotOrder {
  id                String             @id @default(cuid())
  sessionId         String
  userId            String
  status            TheokotOrderStatus @default(RESERVED)
  totalCents        Int
  statusNote        String? // vrije notitie bij correcties
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pickedUpAt        DateTime?
  pickedUpById      String? // wie aan de balie op "opgehaald" drukte
  noShowProcessedAt DateTime? // mail + eventuele ban voor deze order afgewerkt
  /// Wanneer het pushbericht "je broodje ligt klaar" voor deze bestelling
  /// verstuurd is. Dezelfde claim-dan-versturen-aanpak als bij de
  /// shift-herinneringen: eerst de markering zetten in een voorwaardelijke
  /// update, dan pas versturen. Bij twijfel liever geen bericht dan twee.
  pickupPushedAt    DateTime?          @db.Timestamptz(3)

  session           TheokotSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                      @relation("TheokotOrderUser", fields: [userId], references: [id], onDelete: Cascade)
  pickedUpBy        User?                     @relation("TheokotPickedUpBy", fields: [pickedUpById], references: [id], onDelete: SetNull)
  lines             TheokotOrderLine[]
  voucherRedemption TheokotVoucherRedemption?

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([status])
  @@index([status, noShowProcessedAt])
  @@index([status, pickupPushedAt])
}

/// Auditrij wanneer een student aan de afhaalbalie twee nog openstaande
/// medewerkersbonnetjes gebruikt voor een broodje.
model TheokotVoucherRedemption {
  id            String   @id @default(cuid())
  orderId       String   @unique
  userId        String
  processedById String?
  amount        Int      @default(2)
  createdAt     DateTime @default(now())

  order       TheokotOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User         @relation("TheokotVoucherUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User?        @relation("TheokotVoucherProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model TheokotOrderLine {
  id             String @id @default(cuid())
  orderId        String
  sessionItemId  String
  quantity       Int
  unitPriceCents Int // snapshot van de prijs op besteldatum

  order       TheokotOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sessionItem TheokotSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sessionItemId])
}

// -----------------------------------------------------------------------------
// Broodjesmomenten: grocomeet (GM) en VTK Bureau
//
// Twee vergaderingen met dezelfde werking: er wordt vooraf een broodje en een
// drankje besteld, die broodjes gaan van de Theokot-voorraad af en komen in een
// aparte doos. Ze delen daarom één model; `kind` bepaalt het publiek (GM: enkel
// postverantwoordelijken en Groep 5, via het profielmenu; Bureau: elke student,
// via een gedeelde link) en wie het beheert. Zie docs/design-decisions.md.
// -----------------------------------------------------------------------------

/// Eén vergadering. `startsAt` is het moment zelf; het bestelvenster hangt aan de
/// Theokot-verkoopdag van diezelfde dag (dezelfde deadline als voor studenten).
model Meeting {
  id String @id @default(cuid())

  kind     MeetingKind
  /// Werkingsjaar + semester waarin dit moment valt. Enkel voor de
  /// planningskalender: die vraagt per semester welke dagen er een moment is.
  year     Int
  semester Int
  /// Deelbare link voor een bureau (`/bureau/<slug>`). Ook een GM krijgt er een,
  /// zodat een mail naar één moment kan verwijzen.
  slug     String      @unique

  startsAt DateTime  @db.Timestamptz(3)
  location String?
  /// Vanaf wanneer studenten dit bureau kunnen invullen. Leeg = meteen open.
  /// Een GM staat altijd open: de grocos bestellen weken op voorhand.
  opensAt  DateTime? @db.Timestamptz(3)

  /// Aanbod uit Theokot (standaard), of een eigen lijst wanneer Theokot die dag
  /// niets kan voorzien (lasagne, broodjes van een bakker). Een eigen aanbod
  /// raakt de Theokot-voorraad en de turflijst niet.
  useTheokot Boolean @default(true)

  /// Vrije toelichting boven het reservatieformulier.
  noteNl String?
  noteEn String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy    User?                @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  options      MeetingOption[]
  reservations MeetingReservation[]

  @@index([kind, startsAt])
  @@index([year, semester, kind])
}

/// Eén keuze uit het eigen aanbod van een moment (enkel bij `useTheokot=false`).
model MeetingOption {
  id         String  @id @default(cuid())
  meetingId  String
  nameNl     String
  nameEn     String?
  priceCents Int     @default(0)
  order      Int     @default(0)

  meeting      Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reservations MeetingReservation[]

  @@index([meetingId])
}

/// Eén bestelling per persoon per moment. Naam en prijs van het broodje en het
/// drankje zijn snapshots van het moment van bestellen: prijzen in de catalogus
/// mogen een openstaande schuld niet met terugwerkende kracht veranderen.
model MeetingReservation {
  id        String                   @id @default(cuid())
  meetingId String
  userId    String
  status    MeetingReservationStatus @default(ACTIVE)

  /// Leeg = enkel een drankje besteld.
  itemNameNl     String?
  itemNameEn     String?
  itemPriceCents Int     @default(0)
  /// Herkomst van het gekozen broodje: catalogusitem (`TheokotProduct`) of een
  /// eigen optie van dit moment. Puur informatief; de naam is wat telt bij het
  /// koppelen aan de verkoopdag.
  productId      String?
  optionId       String?
  /// Het aanbod-item van die verkoopdag, zodra het gekoppeld kon worden. Dit is
  /// wat de voorraad afroomt en op de turflijst verschijnt.
  sessionItemId  String?

  /// Leeg = geen drankje.
  drinkName       String?
  drinkPriceCents Int     @default(0)

  /// Opmerking bij een bureau (onderwijsfeedback vooraf).
  comment String?

  /// Ongeldig gemaakt omdat het gekozen broodje die dag niet bestaat. De persoon
  /// kreeg er een mail over en ziet het op de reservatiepagina.
  invalidatedAt     DateTime? @db.Timestamptz(3)
  invalidatedReason String?

  /// Betaald (enkel gebruikt voor de GM; een bureau betaalt Onderwijs zelf).
  paidAt   DateTime? @db.Timestamptz(3)
  paidById String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                @relation("MeetingReservationUser", fields: [userId], references: [id], onDelete: Cascade)
  paidBy      User?               @relation("MeetingReservationPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  option      MeetingOption?      @relation(fields: [optionId], references: [id], onDelete: SetNull)
  sessionItem TheokotSessionItem? @relation(fields: [sessionItemId], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([userId, status])
  @@index([sessionItemId])
  @@index([status, paidAt])
}

/// Onthoudt dat de kalender voor dit semester al ingevuld is, zodat het beheer
/// er maar één keer per semester ongevraagd naar vraagt.
model MeetingPlan {
  id          String      @id @default(cuid())
  kind        MeetingKind
  year        Int
  semester    Int
  plannedById String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  plannedBy User? @relation("MeetingPlanBy", fields: [plannedById], references: [id], onDelete: SetNull)

  @@unique([kind, year, semester])
}

/// Tijdelijke ban na te veel no-shows. Historiek blijft bewaard; een ban
/// opheffen zet `active=false` (i.p.v. verwijderen) zodat correcties zichtbaar blijven.
model TheokotBan {
  id          String   @id @default(cuid())
  userId      String
  reason      String
  startsAt    DateTime @default(now())
  endsAt      DateTime
  active      Boolean  @default(true)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

// -----------------------------------------------------------------------------
// Theokot-verhuur: de zaal zelf uitlenen aan een post, een werkgroep of iemand
// van buiten de kring.
//
// Dit verving een Google Form met een Sheet ernaast. De vragen staan daarom niet
// hier maar in `Setting` onder `theokot.rental.questions`: Theokot moet ze kunnen
// herschrijven zonder deploy. Wat wél kolommen zijn, is alles waar het systeem
// zelf op rekent (wanneer, wie, en de vier opvolgvelden), want daar hangen de
// kalender, de dubbelboeking-waarschuwing en de mails aan.
//
// Zie docs/design-decisions.md ("Theokot-verhuur").
// -----------------------------------------------------------------------------

/// Waar een aanvraag in haar leven staat. De namen volgen de kolom uit de Sheet;
/// `ENDED` is "het moment is voorbij", `COMPLETED` is "sleutel terug, waarborg
/// geregeld, dossier dicht".
enum TheokotRentalStatus {
  UNANSWERED
  REJECTED
  APPROVED
  CANCELLED
  ENDED
  COMPLETED
}

/// Wat de aanvrager in het formulier koos als betaalwijze voor de waarborg.
/// Blijft staan zoals hij het antwoordde; het opvolgen gebeurt in `deposit`.
enum TheokotRentalDepositChoice {
  TRANSFER
  CASH
  NVT
}

/// Waar de waarborg staat. "OS" is een overschrijving, "C" is cash; binnen is
/// ontvangen, terug is teruggestort of teruggegeven.
enum TheokotDepositState {
  NVT
  TRANSFER
  CASH
  TRANSFER_IN
  CASH_IN
  TRANSFER_BACK
  CASH_BACK
  PROBLEM
}

enum TheokotContractState {
  PENDING
  SIGNED
  NVT
}

enum TheokotKeyState {
  PENDING
  GIVEN
  RETURNED
  NVT
}

/// Intern (een post of werkgroep van VTK) of extern. Bepaalt welk huurcontract
/// er als bijlage meegaat; die twee documenten zijn niet hetzelfde.
enum TheokotRenterType {
  INTERNAL
  EXTERNAL
}

enum TheokotRentalDecision {
  APPROVE
  REJECT
}

/// Eén verhuuraanvraag.
model TheokotRental {
  id String @id @default(cuid())

  /// De taal waarin de aanvrager verder aangeschreven wil worden ("nl"/"en").
  /// Kwam als eerste vraag in het formulier en stuurt de keuze van het sjabloon.
  locale String @default("nl")

  /// De verantwoordelijke. Die moet student aan de faculteit zijn, tekent het
  /// contract en is tijdens het hele evenement aanwezig; het formulier zegt dat,
  /// wij bewaren enkel wie het is.
  responsibleName String
  phone           String
  email           String

  /// Instants; de weergave rekent naar Brussel-wandklok (lib/brussels.ts).
  /// `endsAt` is het einde inclusief kuisen, zoals het formulier vraagt.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  /// Aard van de activiteit, letterlijk zoals ingevuld. Een post begint die tekst
  /// met haar naam tussen vierkante haakjes ("[Theokot] Kaas- en wijnavond");
  /// daar leidt `renterType` zijn eerste gok uit af.
  purpose   String
  attendees Int?
  remarks   String?

  depositChoice TheokotRentalDepositChoice @default(NVT)

  /// De antwoorden op de vragen die Theokot zelf toevoegde, als
  /// `{ vraagId: antwoord }`. Vrije vorm omdat de vragenlijst dat ook is; alles
  /// waar code op rekent staat hierboven als kolom.
  extraAnswers Json @default("{}")

  renterType TheokotRenterType @default(EXTERNAL)

  /// De vier opvolgvelden uit de Sheet. Ze staan los van elkaar met opzet: een
  /// aanvraag kan goedgekeurd zijn terwijl het contract nog niet getekend is en
  /// de sleutel nog binnen ligt.
  status    TheokotRentalStatus  @default(UNANSWERED)
  deposit   TheokotDepositState  @default(NVT)
  contract  TheokotContractState @default(PENDING)
  keyStatus TheokotKeyState      @default(PENDING)

  /// Interne notitie, enkel in het beheer zichtbaar.
  internalNote String?
  /// De reden bij een weigering of een goedkeuring, zoals ze in de mail naar de
  /// aanvrager terechtkomt. Schrijf hier een zin en geen code.
  decisionNote String?

  decidedAt      DateTime? @db.Timestamptz(3)
  decidedById    String?
  /// Beslist via de knop in de meldingsmail: dan is er geen ingelogde gebruiker
  /// en weten we enkel dát het via die weg gebeurde.
  decidedViaMail Boolean   @default(false)

  /// Wanneer de aanvrager de uitkomst hoorde. Zonder dit is "heb ik al
  /// geantwoord?" niet te beantwoorden.
  requesterNotifiedAt DateTime? @db.Timestamptz(3)

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  decidedBy User? @relation("TheokotRentalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy User? @relation("TheokotRentalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  messages     TheokotRentalMessage[]
  actionTokens TheokotRentalActionToken[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([email])
}

/// Elke mail die over een aanvraag vertrok, met de tekst zoals ze verstuurd werd.
///
/// Bewust de verstuurde tekst en niet enkel het sjabloon-id: een sjabloon wordt
/// bijgeschaafd, en dan zou de historiek achteraf iets anders beweren dan wat de
/// aanvrager in zijn inbox heeft.
model TheokotRentalMessage {
  id       String @id @default(cuid())
  rentalId String

  /// "confirmation" (ontvangstbevestiging), "notify" (naar de behandelaars) of
  /// "reply" (een sjabloonantwoord naar de aanvrager).
  kind       String
  templateId String?

  to             String
  cc             String?
  subject        String
  body           String
  /// Naam van het meegestuurde huurcontract, als er een meeging.
  attachmentName String?

  sentAt      DateTime @default(now()) @db.Timestamptz(3)
  sentById    String?
  /// Verstuurd door de knop in de meldingsmail in plaats van door een ingelogd lid.
  sentViaMail Boolean  @default(false)

  rental TheokotRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  sentBy User?         @relation("TheokotRentalMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([rentalId, sentAt])
}

/// De eenmalige sleutel achter "Goedkeuren" en "Weigeren" in de meldingsmail.
///
/// Enkel de hash staat hier: het token zelf bestaat alleen in die mail. Het is
/// eenmalig en verloopt, want een mail blijft jaren in een mailbox staan en een
/// doorgestuurde melding mag geen tweede beslissing kunnen nemen.
model TheokotRentalActionToken {
  id       String @id @default(cuid())
  rentalId String

  action    TheokotRentalDecision
  tokenHash String                @unique

  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  rental TheokotRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([expiresAt])
}

/// Het huurcontract als pdf, per doelgroep en per taal. Eén rij per combinatie;
/// een nieuwe upload vervangt de vorige.
model TheokotRentalContractDoc {
  id       String            @id @default(cuid())
  audience TheokotRenterType
  /// "nl" of "en".
  locale   String

  storageKey String
  fileName   String
  sizeBytes  Int

  uploadedById String?
  uploadedAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  uploadedBy User? @relation("TheokotRentalContractUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([audience, locale])
}

// -----------------------------------------------------------------------------
// Piano (lokaal 01.52 in het kasteel). Leden reserveren zelf een tijdslot. De
// slots bestaan niet als rijen: ze worden berekend uit de terugkerende vensters
// (`PianoWindow`) min de sluitingsdagen (`PianoClosure`), zodat een venster van
// een heel academiejaar één rij is in plaats van duizend. Enkel een geboekt slot
// krijgt een rij (`PianoReservation`). Zie docs/design-decisions.md.
// -----------------------------------------------------------------------------

/// Terugkerend venster waarin de piano vrij is, bv. "elke ma/di/do 19u-22u van
/// week 39 t.e.m. week 21". Meerdere vensters mogen naast elkaar bestaan; de
/// slotgenerator neemt hun unie.
model PianoWindow {
  id      String  @id @default(cuid())
  labelNl String
  labelEn String?

  /// ISO-weekdagen waarop dit venster geldt: 1 = maandag ... 7 = zondag.
  weekdays    Int[]
  /// Begin en einde als minuten sinds middernacht (Brussel-wandklok), zodat het
  /// venster in zomer- én winteruur op hetzelfde uur op de klok staat.
  startMinute Int
  endMinute   Int

  /// Geldigheidsperiode als lokale middernacht, beide grenzen inclusief.
  /// NULL = geen ondergrens respectievelijk geen bovengrens.
  startDate DateTime?
  endDate   DateTime?

  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Dagen waarop er niets te reserveren valt, ook al valt er een venster over:
/// sluitingsdagen van de KU Leuven, of de piano die in herstelling is.
model PianoClosure {
  id String @id @default(cuid())

  /// Lokale middernacht, beide grenzen inclusief (één dag = start == eind).
  startDate DateTime
  endDate   DateTime
  reasonNl  String
  reasonEn  String?
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

/// Eén geboekt slot. `startsAt` is uniek: de piano is er maar één, dus een slot
/// is bezet of vrij. Annuleren verwijdert de rij; er is bewust geen historiek,
/// want er hangt geen geld of sanctie aan een pianoreservatie.
model PianoReservation {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([startsAt])
  @@index([startsAt])
  @@index([userId, startsAt])
}

// -----------------------------------------------------------------------------
// Uitleendienst (logistiek.vtk.be): materiaal lenen, transport (kar/auto/
// bakfiets) en flesserke. Aanvragen gebeuren per evenement, met een
// aanvragertype (intern/werkgroep/extern). Flow: lid vraagt aan (REQUESTED),
// Logistiek keurt goed of wijst af; de harde voorraadcheck gebeurt bij
// goedkeuring in een Serializable-transactie. Prijzen/waarborgen worden
// gesnapshot zodat catalogswijzigingen bestaande reservaties niet herschrijven.
// -----------------------------------------------------------------------------

model UitleenCategory {
  id        String   @id @default(cuid())
  name      String
  sortIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items UitleenItem[]
}

model UitleenItem {
  id           String  @id @default(cuid())
  categoryId   String?
  name         String
  description  String?
  photoKey     String?
  // Aantal fysieke exemplaren; beschikbaarheid = quantity min overlappende
  // APPROVED/PICKED_UP-reservaties in de gevraagde periode.
  quantity     Int     @default(1)
  depositCents Int     @default(0) // waarborg per stuk
  priceCents   Int     @default(0) // huurprijs per stuk per reservatie; 0 = gratis
  active       Boolean @default(true) // soft-delete: uit de catalogus, historiek blijft

  // Een set is een fysiek samengestelde bundel met eigen voorraad; de inhoud
  // (setContents) is louter beschrijvend en koppelt niet aan andere items.
  isSet Boolean @default(false)

  /// Ruwe omvang, voor de ladingsinschatting per evenement (A8). Optioneel: het
  /// is een hulpmiddel voor de transportverantwoordelijke, geen inventarisplicht.
  /// Staat het niet ingevuld, dan toont het evenementscherm een itemtelling en
  /// zegt het er expliciet bij dat het volume onvolledig is.
  volumeLiters Int?

  // Locatie in de loods (schap/rek) en staat.
  //
  // `condition` geldt voor de hele rij en is informatief, behalve wanneer er
  // exemplaren (`units`) bijgehouden worden: dan telt de staat per exemplaar en
  // is `quantity` de som van de bruikbare exemplaren. Zie UitleenItemUnit.
  locationShelf String? // bv. "2R"
  locationRack  String? // bv. "A1"
  condition     UitleenItemCondition @default(WERKT)
  conditionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      UitleenCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lines         UitleenReservationLine[]
  templateLines UitleenRequestTemplateLine[]
  units         UitleenItemUnit[]
  setContents   UitleenSetContent[]
  photos        UitleenItemPhoto[]
  properties    UitleenItemProperty[]
  downloads     UitleenItemDownload[]
  // Beide richtingen van de alternatieven-koppeling; zie UitleenItemAlternative.
  alternatives  UitleenItemAlternative[]     @relation("UitleenItemAlternatives")
  alternativeOf UitleenItemAlternative[]     @relation("UitleenItemAlternativeOf")

  /// Zoekvector voor /zoeken, door een trigger bijgehouden (naam + omschrijving,
  /// dutch). Eén kolom: dit model heeft geen Engelse velden.
  search Unsupported("tsvector")?

  @@index([categoryId, active])
  @@index([search], type: Gin)
}

/// "Dit kan ook": een alternatief item dat de aanvrager kan overwegen wanneer
/// het gevraagde in zijn periode op is. Een suggestie, geen automatische
/// vervanging; de aanvrager kiest zelf (zie docs/design-decisions.md).
///
/// De koppeling is wederzijds: de actieve en de passieve box zijn elkaars
/// alternatief. Beide richtingen staan als eigen rij, zodat één query per item
/// volstaat; `saveItemAction` houdt de twee rijen samen.
model UitleenItemAlternative {
  itemId        String
  alternativeId String
  createdAt     DateTime @default(now())

  item        UitleenItem @relation("UitleenItemAlternatives", fields: [itemId], references: [id], onDelete: Cascade)
  alternative UitleenItem @relation("UitleenItemAlternativeOf", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@id([itemId, alternativeId])
  @@index([alternativeId])
}

/// Extra productbeelden. `photoKey` op UitleenItem blijft de oudere hoofdfoto;
/// de catalogus gebruikt het eerste beeld hieronder wanneer het bestaat.
model UitleenItemPhoto {
  id        String @id @default(cuid())
  itemId    String
  key       String
  sortIndex Int    @default(0)

  item UitleenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortIndex])
}

/// Vrije technische eigenschappen, zodat Logistiek geen schemawijziging nodig
/// heeft voor bijvoorbeeld afmetingen, vermogen of aansluitingen.
model UitleenItemProperty {
  id        String @id @default(cuid())
  itemId    String
  label     String
  value     String
  sortIndex Int    @default(0)

  item UitleenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortIndex])
}

/// Handleidingen, fiches en andere documenten die leden bij een item kunnen
/// downloaden. De bestanden staan net als foto's in de bestaande opslag.
model UitleenItemDownload {
  id        String @id @default(cuid())
  itemId    String
  label     String
  key       String
  sortIndex Int    @default(0)

  item UitleenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortIndex])
}

/// Beschrijvende inhoud van een set (vrije tekst, geen koppeling aan andere
/// items zodat de voorraad niet dubbel geteld wordt).
model UitleenSetContent {
  id        String @id @default(cuid())
  itemId    String
  label     String
  quantity  Int    @default(1)
  sortIndex Int    @default(0)

  item UitleenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortIndex])
}

/// Koepel boven de aanvragen van hetzelfde evenement: materiaal, flesserke en
/// vervoer hangen eronder.
///
/// **Optioneel, en bewust niet automatisch.** Elke aanvraag een evenement geven
/// zou dit scherm een tweede aanvraaglijst maken, en de waarschuwing "nog geen
/// vervoer aangevraagd" zou afgaan op elke uitlening van twee tafels. Een
/// evenement ontstaat wanneer iemand er een maakt: het lid in het
/// aanvraagformulier, het team op /beheer/evenementen, of het groeperingsscript
/// voor de historiek. Zie docs/design-decisions.md.
///
/// De aanvragen houden hun eigen `eventName` als momentopname; die van het
/// evenement wint in de weergave zodra ze eraan hangen.
model UitleenEvent {
  id       String    @id @default(cuid())
  name     String
  location String?
  startAt  DateTime? @db.Timestamptz(3)

  /// Het kalenderevenement op vtk.be waar dit uit ontstaan is (E1).
  ///
  /// Bewust nullable en uniek: de meeste logistiek-evenementen ontstaan hier, en
  /// eentje dat uit de site komt hoort er precies één te hebben. Naam, locatie en
  /// uren volgen dat evenement zolang iemand ze daar aanpast; verdwijnt het
  /// evenement, dan blijft dit staan (`SetNull`), want de aanvragen eronder zijn
  /// het echte werk.
  calendarEventId String? @unique

  /// Is het uur van `startAt` echt ingevuld, of staat er enkel een dag?
  ///
  /// Bij het aanmaken is het uur vaak nog niet gekend ("ergens die zaterdag"),
  /// en het dan verplicht maken levert een verzonnen uur op dat later niemand
  /// meer durft te wijzigen. Zonder deze vlag valt "de fuif begint om
  /// middernacht" niet te onderscheiden van "we weten het uur nog niet", want
  /// allebei staan ze als 00:00 in de kolom.
  startTimeKnown Boolean @default(true)

  /// Wanneer het evenement gedaan is. Optioneel: een cantus is één avond, een
  /// weekend duurt drie dagen, en het materiaal moet in dat tweede geval ook
  /// drie dagen blijven staan.
  endAt DateTime? @db.Timestamptz(3)

  /// Post of werkgroep achter het evenement, en wie het aanmaakte.
  groupId     String?
  createdById String?

  /// Hoeveel volk er verwacht wordt. Stond tot nu toe enkel per aanvraag, en
  /// dus drie keer met drie verschillende getallen wanneer materiaal, flesserke
  /// en transport apart aangevraagd werden. De koepel is de plek waar het één
  /// keer klopt; per aanvraag blijft het bestaan voor wie zonder evenement werkt.
  expectedAttendance Int?

  /// Vrije nota van het team ("materiaal blijft staan tot maandag").
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("UitleenEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  reservations  UitleenReservation[]
  transport     UitleenTransportBooking[]
  extraItems    UitleenEventExtraItem[]
  groceryOrders CollectEnGoOrder[]

  @@index([startAt])
  @@index([groupId])
}

/// Materiaal dat niet van Logistiek komt: het theokot, de vicepraeses, iemands
/// eigen boxen. Puur informatief, zonder voorraadberekening.
///
/// Waarom het toch in het systeem staat: de materiaallijst die de dag zelf
/// meegaat, moet compleet zijn. Stond de helft ervan in een spreadsheet of in
/// een kop, dan is het blad aan het rek een half blad, en gaat er iets mis met
/// precies dat deel dat niemand kon nalezen.
model UitleenEventExtraItem {
  id      String @id @default(cuid())
  eventId String

  /// Waar het vandaan komt: "Theokot", "Vicepraeses", "Eigen materiaal".
  source   String
  itemName String
  quantity Int     @default(1)
  note     String?

  createdAt   DateTime @default(now())
  createdById String?

  event     UitleenEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("UitleenEventExtraItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId])
}

/// Een vaste set materiaal die vaak samen gevraagd wordt (een cantus, een BBQ).
///
/// Beheerd door Logistiek zelf: posten maken hun eigen sjablonen niet aan. Anders
/// staan er na één jaar dertig varianten van "cantus" in de keuzelijst en weet
/// niemand nog welke de juiste is. Een sjabloon vult het aanvraagformulier in;
/// wat er daarna mee gebeurt, is een gewone aanvraag.
model UitleenRequestTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  /// Post waarvoor dit sjabloon typisch dient, enkel als toelichting in de lijst.
  /// Filtert niet: een sjabloon van Cultuur kan even goed voor een andere post
  /// passen, en verbergen zou het onvindbaar maken voor wie het nodig heeft.
  groupId     String?
  createdById String?

  active    Boolean  @default(true)
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group?                       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User?                        @relation("UitleenTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     UitleenRequestTemplateLine[]

  @@index([active, sortIndex])
}

model UitleenRequestTemplateLine {
  id         String @id @default(cuid())
  templateId String
  itemId     String
  quantity   Int    @default(1)

  template UitleenRequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Verdwijnt het item uit de catalogus (soft-delete), dan blijft de lijn staan;
  /// het formulier slaat ze over. Hard verwijderen kan niet zolang er lijnen zijn.
  item     UitleenItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([templateId, itemId])
  @@index([itemId])
}

/// Eén fysiek exemplaar van een item, met een eigen staat.
///
/// `UitleenItem.condition` geldt voor de hele rij: van vier frigo's kan er geen
/// enkele als kapot gemarkeerd worden zonder ze alle vier te markeren. Wie dat
/// onderscheid nodig heeft, splitst het item in exemplaren; wie het niet nodig
/// heeft, laat het staan en houdt het huidige gedrag (`quantity` als getal).
///
/// Bestaan er exemplaren, dan is `UitleenItem.quantity` de bijgehouden telling
/// van de bruikbare exemplaren (actief en niet KAPOT), zoals
/// `UitleenFlesserkeBatch` dat voor flesserke doet. Zo blijft elke
/// beschikbaarheidsberekening één kolom lezen in plaats van te moeten weten of
/// dit item exemplaren heeft.
model UitleenItemUnit {
  id     String @id @default(cuid())
  itemId String

  /// Hoe het team dit exemplaar noemt: "Box 3", "de blauwe", een serienummer.
  label String

  condition     UitleenItemCondition @default(WERKT)
  conditionNote String?

  /// Uit roulatie zonder de historiek te verliezen (weggegooid, uitgeleend aan
  /// een andere kring). Telt niet mee voor de voorraad.
  active Boolean @default(true)

  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item UitleenItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortIndex])
}

model UitleenReservation {
  id     String                   @id @default(cuid())
  userId String
  status UitleenReservationStatus @default(REQUESTED)

  // Namens wie de aanvraag gebeurt. INTERN koppelt aan een post (groupId);
  // WERKGROEP/EXTERN bewaren een vrije naam (requesterName).
  requesterType UitleenRequesterType @default(INTERN)
  groupId       String?
  requesterName String?

  // Evenement-context (de Logi-werking vraagt aan per evenement).
  //
  // `eventId` is de optionele koepel (A8); `eventName` blijft de momentopname van
  // wat het lid intikte, ook wanneer het evenement later hernoemd wordt.
  eventId            String?
  eventName          String // verplicht: waarvoor het materiaal dient
  eventLocation      String?
  eventStart         DateTime? @db.Timestamptz(3) // startuur (opbouw) van het evenement
  expectedAttendance Int?
  contactName        String?
  contactPhone       String?
  delivery           Boolean   @default(false) // levering nodig?
  deliveryNote       String?

  // Afhaal- en terugbrengdag (hele dagen; de concrete uren spreekt het team af).
  pickupDate DateTime @db.Date
  returnDate DateTime @db.Date

  // Grofweg wanneer op die dag. Bewust géén boekingseenheid: de
  // voorraadberekening blijft op hele dagen rekenen (zie docs/design-decisions.md).
  // Een afspraak tussen mensen dus, die nu in het systeem staat in plaats van in
  // een mail.
  pickupPart UitleenDayPart?
  returnPart UitleenDayPart?

  memberNote String? // extra info van het lid
  adminNote  String? // nota van het team (bv. reden van afwijzing)

  // Extra adres dat mee op de hoogte blijft, naast de aanvrager zelf. Bedoeld
  // voor de mailbox van een werkgroep (logistiek.existenz@vtk.be): die overleeft
  // de wissel van aanvrager, een persoonlijk adres niet.
  notifyEmail String?

  // Totalen gesnapshot bij de aanvraag.
  totalPriceCents   Int
  totalDepositCents Int

  paymentMode       UitleenPaymentMode? // gezet door het team bij goedkeuring
  paidOfflineAt     DateTime? // team drukte "betaald bij afhaling"
  depositReturnedAt DateTime?

  decidedAt    DateTime?
  decidedById  String?
  pickedUpAt   DateTime?
  pickedUpById String?
  returnedAt   DateTime?
  returnedById String?

  /// Wanneer de aanvrager deze aanvraag zelf laatst open had staan.
  ///
  /// Voor het merkteken "Logistiek heeft hier iets aan gewijzigd" (R5): alles in
  /// de historiek dat ná dit moment door iemand anders geschreven werd, heeft de
  /// aanvrager nog niet gezien. Eén kolom op de aanvraag en geen tabel per
  /// lezer: het gaat om de aanvrager, en die is er maar één.
  requesterSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation("UitleenReservationUser", fields: [userId], references: [id], onDelete: Cascade)
  group      Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Verdwijnt het evenement, dan blijven de aanvragen bestaan: ze zijn het echte
  // werk, de koepel is enkel een groepering.
  event      UitleenEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  decidedBy  User?         @relation("UitleenDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  pickedUpBy User?         @relation("UitleenPickedUpBy", fields: [pickedUpById], references: [id], onDelete: SetNull)
  returnedBy User?         @relation("UitleenReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  lines          UitleenReservationLine[]
  flesserkeLines UitleenFlesserkeLine[]
  payments       UitleenPayment[]
  auditLogs      UitleenAuditLog[]
  /// Ritten die Logistiek voor de levering van deze aanvraag aanmaakte.
  transports     UitleenTransportBooking[]

  @@index([userId])
  @@index([status, pickupDate])
  @@index([pickupDate, returnDate])
  @@index([requesterType, status])
  @@index([eventId])
}

model UitleenReservationLine {
  id            String @id @default(cuid())
  reservationId String
  itemId        String

  // Snapshot van het item op aanvraagmoment.
  itemName         String
  quantity         Int
  unitPriceCents   Int
  unitDepositCents Int

  // Opmerking van het lid bij deze lijn ("liefst de zwarte").
  note String?

  // Opmerking van Logistiek bij deze lijn ("staat al klaar bij het rek", of de
  // reden waarom ze niet toegekend is). Apart van `note`: één gedeeld veld liet
  // de tweede schrijver de eerste overschrijven zonder dat iemand zag dat er
  // iets weg was, en bij het item moet zichtbaar zijn wie wat schreef.
  adminNote String?

  // Beslissing over deze lijn. Bij het goedkeuren van de aanvraag gaan alle
  // openstaande lijnen mee naar APPROVED; het team kan er eerst enkele op
  // REJECTED zetten. Enkel APPROVED-lijnen nemen voorraad in.
  lineStatus UitleenLineStatus @default(REQUESTED)

  // Klaarzetten: afgevinkt door een shift in de loods, vóór het lid langskomt.
  // Los van de status van de aanvraag: een aanvraag is pas afgehaald wanneer het
  // lid er is, terwijl het klaarzetten daarvoor gebeurt en per lijn vordert.
  preparedAt   DateTime?
  preparedById String?

  reservation UitleenReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  // Items worden soft-deleted (active=false), nooit hard verwijderd zolang er
  // reservaties aan hangen.
  item        UitleenItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  preparedBy  User?              @relation("UitleenLinePreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([itemId])
}

/// Een voertuig van de transportdienst (kar, auto, bakfiets). Tarieven zijn
/// team-configureerbaar, daarom DB-rijen i.p.v. een enum.
model UitleenVehicle {
  id             String             @id @default(cuid())
  code           String             @unique // kar | auto | bakfiets
  nameNl         String
  nameEn         String
  description    String?
  pricingMode    UitleenPricingMode @default(FREE)
  rateCents      Int                @default(0) // per uur / per km / vast, naargelang pricingMode
  sortIndex      Int                @default(0)
  active         Boolean            @default(true)
  // Rijden met dit voertuig vraagt een chauffeur die het aankan: bij VTK is dat
  // "de kar", de bestelwagen. Een vlag per voertuig en geen check op
  // `code == "kar"`: het team voert zelf voertuigen in, en een tweede
  // bestelwagen zou anders stil buiten de regel vallen.
  //
  // Heette tot augustus 2026 `needsTrailerDriver`. Dat was een leesfout van
  // "met de kar rijden": VTK heeft geen aanhangwagen.
  needsVanDriver Boolean            @default(false)
  /// Rijdt Logistiek dit voertuig, of neemt de aanvrager het zelf mee? De
  /// bakfiets is het tweede geval: daar hoort geen chauffeur bij, en toch stond
  /// die rit geel gemarkeerd als "nog geen chauffeur toegewezen", een taak die
  /// nooit afgevinkt raakte. Een vlag per voertuig en geen check op
  /// `code == "bakfiets"`, om dezelfde reden als bij `needsVanDriver`.
  needsDriver    Boolean            @default(true)

  /// Arcering van dit voertuig in de transportplanning: `diagonal`, `vertical`,
  /// `dots`, `grid` of `none`. Een streeppatroon en geen kleur, want de kleur is
  /// al bezet door de chauffeur (zie `UitleenDriver.colorIndex`): zo lees je in
  /// één blok wie rijdt én waarmee, in plaats van te moeten kiezen.
  ///
  /// Een vrije string en geen enum: de patronen zijn CSS-klassen, en er eentje
  /// bij zetten hoort geen migratie te vragen. `null` = geen arcering, wat de
  /// toestand is van elk voertuig tot iemand er een kiest.
  pattern        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings UitleenTransportBooking[]
}

/// Chauffeur die Logistiek zelf toevoegt, buiten de post om.
///
/// De chauffeurskeuze bij een rit is de unie van twee bronnen: de leden van de
/// post Logistiek in het huidige werkingsjaar (automatisch, via
/// GroupMembership) en de rijen hier. Zo kan iemand met een rijbewijs rijden
/// zonder praesidiumlid te worden (en dus zonder `logistiek.manage`, want die
/// permissie hangt aan de post en niet aan deze tabel). De pool is bewust niet
/// werkingsjaar-gescoped: hij wordt met de hand beheerd en resetten op 15 juli
/// zou de ritten van de zomer zonder chauffeurs zetten.
model UitleenDriver {
  id          String  @id @default(cuid())
  userId      String  @unique
  // Vrije notitie van het team, bv. "rijbewijs B sinds 2023, rijdt niet met de kar".
  note        String?
  addedById   String?
  // Mag met de kar rijden (de bestelwagen). Eén vlag en geen enum AUTO/KAR: wie
  // de kar rijdt, rijdt ook gewoon met de auto, dus die twee sluiten elkaar niet
  // uit. Leden van de post Logistiek hebben pas een rij hier zodra iemand deze
  // vlag zet; tot dan gelden ze als autochauffeur.
  canDriveVan Boolean @default(false)

  /// De kleur van deze chauffeur in de transportplanning, 1 tot 8
  /// (`--driver-1` .. `--driver-8` in app/globals.css).
  ///
  /// `null` = de kleur die uit zijn id volgt (`driverColorIndex` in
  /// lib/driver-colors.ts). Die hash blijft de standaard: het doel is
  /// onderscheiden wie welke rit doet, niet dat Jonas geel wil. Maar twee
  /// chauffeurs die toevallig op bijna dezelfde tint uitkomen, of iemand die
  /// altijd al "de blauwe" was, moet het team kunnen rechtzetten zonder dat
  /// daar een deploy aan te pas komt.
  ///
  /// Een lid van de post Logistiek zonder rij in deze tabel krijgt er een zodra
  /// iemand zijn kleur zet, net zoals `canDriveVan` dat al doet.
  colorIndex  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User  @relation("UitleenDriverUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("UitleenDriverAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
}

/// Wanneer een chauffeur kan rijden.
///
/// Vensters en geen rooster: een chauffeur weet "zaterdagvoormiddag kan ik" en
/// niet "elke tweede week van 9 tot 12". Een herhalend rooster zou hem dwingen
/// iets vast te leggen dat elke week anders is, en het team zou erop plannen.
///
/// Het is een **hulpmiddel en geen belofte**: iemand toewijzen buiten zijn
/// venster geeft een waarschuwing en geen blokkade. De app kent zijn agenda niet,
/// hij wel, en een blokkade zou de planning stilleggen op het moment dat er nog
/// snel iemand gebeld moet worden.
///
/// Niet werkingsjaar-gescoped en niet opgekuist: een venster in het verleden
/// zegt achteraf wie er die dag kon, en dat is precies de vraag bij "waarom deed
/// altijd dezelfde persoon de nachtritten".
model UitleenDriverAvailability {
  id     String @id @default(cuid())
  userId String

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// Hoe graag deze chauffeur op dit moment rijdt.
  ///
  /// `JA` voor alles wat er stond voor deze kolom bestond, en dat is ook wat het
  /// betekende: het enige antwoord was toen "ik kan".
  kind UitleenAvailabilityKind @default(JA)

  /// Vrije nota van de chauffeur zelf ("enkel met de auto", "tot 16u zeker").
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UitleenDriverAvailabilityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([startAt, endAt])
}

/// Hoe graag een chauffeur op een moment rijdt.
///
/// Drie antwoorden en niet twee: in de praktijk zegt niemand enkel ja of niets.
/// "Ik kan wel, maar vraag eerst iemand anders" en "enkel als er echt niemand
/// anders is" zijn allebei een ja waarop je anders plant, en zonder dat verschil
/// kruisten mensen ofwel te veel aan (en werden ze gebeld voor ritten die
/// slecht uitkwamen) ofwel te weinig (en stond de kalender leeg terwijl er wel
/// iemand kon).
///
/// Niet meer dan drie: elke extra tint is een keuze die de chauffeur moet maken
/// en die het team moet interpreteren, en dan wordt het een schaal in plaats van
/// een antwoord.
///
/// Géén vierde waarde voor "kan niet": niets aanduiden betekent al "we weten het
/// niet", en dat is iets anders dan "kan niet". Zie `driverAvailability`.
enum UitleenAvailabilityKind {
  /// Ik kan rijden.
  JA
  /// Ik kan, maar vraag eerst iemand anders.
  LIEVER_NIET
  /// Enkel als er echt niemand anders is.
  NOOD
}

/// Heen of terug binnen één heen-en-terugaanvraag (`tripGroupId`).
enum UitleenTripLeg {
  HEEN
  TERUG
}

/// Transportaanvraag met een voertuig, een tijdvenster en (later) een chauffeur.
/// Bewust een eigen model (geen materiaalaanvraag): aparte behandelaar, aparte
/// lifecycle. Prijs kan pas bij afronden gekend zijn (per-km).
model UitleenTransportBooking {
  id        String                        @id @default(cuid())
  userId    String
  vehicleId String
  status    UitleenTransportBookingStatus @default(REQUESTED)

  requesterType UitleenRequesterType @default(INTERN)
  groupId       String?
  requesterName String?

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  eventId       String? // optionele koepel (A8)
  eventName     String? // momentopname van wat het lid intikte
  /// Materiaalaanvraag waarvan dit de levering is. Enkel gezet wanneer Logistiek
  /// de rit vanaf die aanvraag aanmaakt ("Levering nodig"); een rit die een lid
  /// zelf aanvraagt heeft geen aanvraag om aan te hangen.
  reservationId String?
  purpose       String // waarvoor de rit dient
  /// Wat er mee moet: "20 bierbakken en 4 tafels", "de geluidsinstallatie".
  ///
  /// Los van `purpose` (waarvóór de rit dient) en van de materiaalaanvraag: een
  /// rit die geen levering is, heeft geen aanvraag met een inhoudslijst, en de
  /// chauffeur wil weten of hij de kar of de auto moet nemen. Stond tot ronde 3
  /// nergens; het team schreef het in de vrije nota of belde erover.
  cargoNote     String?
  pickupAddress String?
  destination   String?
  /// Vrije tekst over de bijrijders, van vóór V2. Blijft staan voor de historiek
  /// van bestaande ritten; nieuwe bijrijders komen in `UitleenTransportHelper`,
  /// waar er meer dan één met elk zijn eigen nummer in past.
  helpersNote   String?
  helpersPhone  String?
  contactPhone  String? // nummer van de aanvrager zelf, zoals UitleenReservation dat heeft

  // Heen- en terugrit horen bij elkaar maar zijn twee boekingen: de kar is
  // tussendoor vrij, en één boeking met twee tijdvensters zou elke query over
  // "wanneer is dit voertuig bezet" twee vensters moeten laten kennen (de
  // conflictcheck, de kalender, het weekoverzicht). Zie docs/design-decisions.md.
  tripGroupId String?
  // Welke rit van het paar dit is; null bij een gewone enkele rit.
  tripLeg     UitleenTripLeg?

  driverId String? // pas het weekend ervoor toegewezen; blijft optioneel bij goedkeuring

  // Tarief gesnapshot bij de aanvraag (en her-gesnapshot bij een voertuigwissel).
  pricingMode UitleenPricingMode
  rateCents   Int
  kilometers  Int? // ingevuld bij afronden voor PER_KM
  priceCents  Int? // null = nog niet gekend (PER_KM voor de rit)

  paymentMode   UitleenPaymentMode?
  paidOfflineAt DateTime?

  memberNote String?
  adminNote  String?

  /// Zoals op UitleenReservation: een meelezend adres naast de aanvrager.
  notifyEmail String?

  decidedAt     DateTime?
  decidedById   String?
  completedAt   DateTime?
  completedById String?

  /// Zie `UitleenReservation.requesterSeenAt` (R5).
  requesterSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation("UitleenTransportUser", fields: [userId], references: [id], onDelete: Cascade)
  vehicle     UitleenVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  event       UitleenEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // Verdwijnt de aanvraag, dan blijft de rit bestaan: ze is dan gewoon een rit
  // zonder levering eraan, en het voertuig is die dag nog altijd bezet.
  reservation UitleenReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  group       Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  driver      User?               @relation("UitleenTransportDriver", fields: [driverId], references: [id], onDelete: SetNull)
  decidedBy   User?               @relation("UitleenTransportDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  completedBy User?               @relation("UitleenTransportCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  payments  UitleenPayment[]
  auditLogs UitleenAuditLog[]
  helpers   UitleenTransportHelper[]

  @@index([userId])
  @@index([status, startAt])
  @@index([startAt, endAt])
  @@index([vehicleId, status])
  @@index([requesterType, status])
  @@index([eventId])
  @@index([reservationId])
  @@index([tripGroupId])
  // "Mijn ritten" voor een chauffeur, en de rittentelling per chauffeur in het
  // chauffeursbeheer.
  @@index([driverId, startAt])
}

/// Waar een agendafeed van de uitleendienst over gaat.
enum UitleenFeedScope {
  /// De hele transportplanning: elke rit, met chauffeur, aanvrager en adressen.
  /// Enkel voor wie `logistiek.manage` heeft op het moment van aanmaken.
  TEAM
  /// Enkel de ritten die aan deze persoon toegewezen zijn ("Mijn ritten").
  DRIVER
}

/// Een abonneerbare agendafeed op de transportplanning.
///
/// Gemodelleerd op `CalendarFeedToken` van de hoofdsite, met dezelfde reden: een
/// agenda-client stuurt geen cookies mee, dus het geheim zit in de URL zelf. Die
/// URL komt in agenda-instellingen, back-ups en soms in server-logs terecht;
/// daarom een token van 256 bits, een `no-store`-antwoord en een `noindex`.
///
/// Een eigen tabel en niet die van de hoofdsite: die feed gaat over de publieke
/// kalender van de kring en heeft geen scope, terwijl deze de adressen en
/// telefoonnummers van ritten draagt. Twee soorten geheim in één tabel betekent
/// dat één fout in een query beide lekt.
model UitleenFeedToken {
  id     String           @id @default(cuid())
  userId String
  /// Waar de eigenaar deze feed voor gebruikt ("mijn gsm", "de logikot-agenda").
  label  String
  scope  UitleenFeedScope @default(TEAM)

  /// sha256 van het token; het token zelf staat nergens. Een random token van
  /// 256 bits heeft geen salt nodig.
  tokenHash  String    @unique
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("UitleenFeedTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Iemand die meerijdt op een rit: een naam en een nummer.
///
/// Verving `helpersNote` + `helpersPhone` op de rit zelf (V2). Die twee velden
/// droegen één vrije tekst en één nummer, en twee bijrijders met elk hun eigen
/// gsm pasten daar niet in; de chauffeur belde dan de aanvrager om het nummer
/// van de tweede te vragen.
///
/// Hangt aan de **boeking** en niet aan de tripgroep: heen en terug kunnen
/// andere bijrijders hebben, en dat is precies het geval waarin je het wil weten.
/// Bij het aanvragen van een heen-en-terugrit krijgen beide helften dezelfde
/// rijen; daarna leiden ze hun eigen leven.
model UitleenTransportHelper {
  id                 String @id @default(cuid())
  transportBookingId String

  name  String
  /// Optioneel: soms weet de aanvrager enkel wie er meegaat, nog niet zijn nummer.
  phone String?

  /// Wie deze bijrijder toevoegde. Kan de aanvrager zijn, een collega van
  /// dezelfde post, of iemand van het team.
  addedById String?
  createdAt DateTime @default(now())

  booking UitleenTransportBooking @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  addedBy User?                   @relation("UitleenTransportHelperAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([transportBookingId])
}

/// Spiegel van TicketPayment (zonder refunds): provider is een vrije string
/// zodat een providerwissel geen migratie vraagt. Precies één van
/// reservationId/transportBookingId is gezet.
model UitleenPayment {
  id                 String               @id @default(cuid())
  reservationId      String?
  transportBookingId String?
  provider           String
  providerCheckoutId String?
  providerPaymentId  String?
  idempotencyKey     String
  status             UitleenPaymentStatus @default(CREATED)
  amountCents        Int
  currency           String               @default("EUR")
  checkoutUrl        String?
  providerStatus     String?
  expiresAt          DateTime?            @db.Timestamptz(3)
  succeededAt        DateTime?            @db.Timestamptz(3)
  failedAt           DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  reservation      UitleenReservation?      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  transportBooking UitleenTransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: Restrict)
  webhooks         UitleenPaymentWebhook[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])
  @@index([reservationId, status])
  @@index([transportBookingId, status])
  @@index([status, expiresAt])
}

model UitleenPaymentWebhook {
  id                 String    @id @default(cuid())
  provider           String
  externalEventId    String
  paymentId          String?
  signatureValid     Boolean
  payload            Json
  processingAttempts Int       @default(0)
  receivedAt         DateTime  @default(now()) @db.Timestamptz(3)
  processedAt        DateTime? @db.Timestamptz(3)
  lastError          String?

  payment UitleenPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@index([processedAt, receivedAt])
}

// -----------------------------------------------------------------------------
// Flesserke: verbruiksstock (voeding, drank, huishoudproducten) die per event
// wordt klaargezet. Enkel voor interne werking (INTERN/WERKGROEP). Beschikbaar
// wordt altijd berekend (quantity min gereserveerd), nooit opgeslagen. Bij het
// terugbrengen boekt het team het verbruik af (gesloten terug, open weg).
// -----------------------------------------------------------------------------

model UitleenFlesserkeCategory {
  id        String   @id @default(cuid())
  name      String
  sortIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items UitleenFlesserkeItem[]
}

model UitleenFlesserkeItem {
  id            String    @id @default(cuid())
  categoryId    String?
  name          String
  brand         String?
  // Inhoud per stuk, gesplitst in getal en eenheid. De Excel-kolom heette
  // "Hoeveelheid [kg of L]" en gaf enkel het getal, dus stond er "0.14" bij een
  // pot tomatenpuree van 140 g en moest je de eenheid zelf raden. De eenheid is
  // vrije tekst met een keuzelijst ervoor (`CONTENT_UNITS`) en blijft optioneel:
  // borden en dweilen hebben er geen.
  contentAmount String?
  contentUnit   String?
  // Eerstvolgende vervaldatum over alle ladingen heen, en de totale fysieke
  // voorraad. Allebei afgeleid uit `batches`: de acties houden ze bij zodat de
  // beschikbaarheidsberekening (`quantity` min gereserveerd) en de zoek- en
  // sorteervelden op één rij blijven staan. Schrijf ze nooit los bij.
  expiryDate    DateTime? @db.Date
  colruytUrl    String?
  quantity      Int       @default(0) // som van de batches; beschikbaar = quantity - gereserveerd
  locationShelf String?
  locationRack  String?
  note          String?
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       UitleenFlesserkeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lines          UitleenFlesserkeLine[]
  batches        UitleenFlesserkeBatch[]
  collectEnGo    CollectEnGoOrderLine[]
  collectEnGoKey CollectEnGoProductMatch[]

  @@index([categoryId, active])
}

/// Eén lading van een flesserke-item, met een eigen vervaldatum.
///
/// Twee bakken cola die je op verschillende momenten kocht, vervallen op
/// verschillende dagen. Met één datum per item sloeg de rode markering "vervalt
/// binnen 3 weken" op de hele stapel, ook op de bakken die nog maanden goed zijn.
///
/// De batches zijn de waarheid; `UitleenFlesserkeItem.quantity` en `.expiryDate`
/// zijn een bijgehouden samenvatting ervan (som en eerstvolgende datum). Verbruik
/// gaat van de oudste lading eerst; zie docs/design-decisions.md.
model UitleenFlesserkeBatch {
  id         String    @id @default(cuid())
  itemId     String
  quantity   Int       @default(0)
  // Null = geen houdbaarheidsdatum (bv. kuisgerief); die lading gaat als laatste op.
  expiryDate DateTime? @db.Date
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item UitleenFlesserkeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, expiryDate])
}

model UitleenFlesserkeLine {
  id              String @id @default(cuid())
  reservationId   String
  flesserkeItemId String

  itemName         String // snapshot
  quantity         Int
  returnedQuantity Int? // ingevuld bij terugbrengen; verbruik = quantity - returnedQuantity

  reservation UitleenReservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  item        UitleenFlesserkeItem @relation(fields: [flesserkeItemId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([flesserkeItemId])
}

/// Een Collect&Go-bevestigingsmail, uitgelezen en klaargezet om te importeren.
///
/// Wie voor de kring boodschappen bestelt bij Colruyt, krijgt een mail met alle
/// producten, aantallen en prijzen en een reservatienummer. Die lijst met de hand
/// overtypen in de flesserke-voorraad is een half uur werk per bestelling, en
/// levert dubbele items op. De mail wordt hier bewaard zoals ze gelezen is; het
/// importscherm zet ze per lijn om in ladingen (`UitleenFlesserkeBatch`).
///
/// `reservationNumber` is bewust **niet uniek**: bij een wijziging stuurt
/// Collect&Go een tweede mail met hetzelfde nummer. Dedupe gebeurt op
/// `messageId`; het beheer neemt de nieuwste niet-geïmporteerde mail.
model CollectEnGoOrder {
  id                String                 @id @default(cuid())
  reservationNumber String
  /// Message-ID van de mail. Voorkomt dat dezelfde mail bij een tweede
  /// IMAP-ronde opnieuw binnenkomt. Leeg bij een geplakte mail.
  messageId         String?                @unique
  /// "IMAP" of "PASTE": kwam ze uit de mailbox of plakte iemand ze zelf?
  source            String
  status            CollectEnGoOrderStatus @default(NEW)

  customerName String?
  pickupPoint  String?
  pickupFrom   DateTime? @db.Timestamptz(3)
  pickupUntil  DateTime? @db.Timestamptz(3)
  orderedAt    DateTime? @db.Timestamptz(3)

  // De bedragen onderaan de mail. Ze gaan niet mee naar de voorraad (een lading
  // heeft geen prijs), maar dienen als controle op het parsen en laten het team
  // achteraf zien wat een bestelling gekost heeft.
  subtotalCents    Int?
  discountCents    Int?
  serviceCostCents Int?
  totalCents       Int?

  /// De genormaliseerde tekst van de mail, om later opnieuw te kunnen parsen
  /// wanneer Collect&Go zijn opmaak wijzigt.
  rawText String

  receivedAt   DateTime  @default(now()) @db.Timestamptz(3)
  importedAt   DateTime? @db.Timestamptz(3)
  importedById String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Bij welk evenement deze boodschappen horen (B1/E5). Optioneel: een
  /// bestelling voor de kelder hangt aan niets. SetNull en geen cascade, want
  /// een verwijderd evenement mag de bestelhistoriek niet meenemen.
  eventId String?

  importedBy User?                  @relation("CollectEnGoImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  event      UitleenEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  lines      CollectEnGoOrderLine[]

  @@index([status, receivedAt])
  @@index([reservationNumber])
  @@index([eventId])
}

/// Eén productlijn uit de mail, met wat het importscherm ervan maakte.
model CollectEnGoOrderLine {
  id        String @id @default(cuid())
  orderId   String
  sortIndex Int

  /// De categoriekop uit de mail ("Diepvries"). Puur van Colruyt; ze staat los
  /// van `UitleenFlesserkeCategory`.
  category    String?
  productName String
  /// De vrije notitie die de besteller in Collect&Go bij het product zette. In
  /// de praktijk is dat de acti waarvoor het gekocht is ("Acti - livecantus").
  note        String?

  unit         CollectEnGoUnit @default(PIECE)
  /// Aantal stuks. Bij `WEIGHT` staat het gewicht in `quantityText` en is dit
  /// een naar boven afgerond werkgetal dat het team in het importscherm zet.
  quantity     Int
  quantityText String?

  unitPriceCents    Int?
  /// Waarop de eenheidsprijs slaat: "st" of "Kg".
  unitPriceBasis    String?
  totalPriceCents   Int?
  /// Leeggoed en promo uit de `leeggoed`-regel onder een bak bier.
  depositCents      Int?
  lineDiscountCents Int?

  /// Waar deze lijn naartoe ging bij het importeren; leeg zolang dat niet gebeurd
  /// is of wanneer het team ze oversloeg.
  flesserkeItemId  String?
  importedQuantity Int?

  order CollectEnGoOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  UitleenFlesserkeItem? @relation(fields: [flesserkeItemId], references: [id], onDelete: SetNull)

  @@index([orderId, sortIndex])
  @@index([flesserkeItemId])
}

/// Onthoudt naar welk flesserke-item een Collect&Go-product de vorige keer ging.
///
/// Zonder dit begint elke bestelling weer bij nul en moet het team dezelfde
/// zeventig lijnen opnieuw aanduiden. `productKey` is de genormaliseerde
/// productnaam uit de mail (zie lib/collectengo/match.ts).
model CollectEnGoProductMatch {
  id              String @id @default(cuid())
  productKey      String @unique
  productName     String
  flesserkeItemId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  item UitleenFlesserkeItem @relation(fields: [flesserkeItemId], references: [id], onDelete: Cascade)

  @@index([flesserkeItemId])
}

/// Wat er met een aanvraag of een rit gebeurd is, in volgorde.
///
/// De velden op de aanvraag zelf (`decidedAt`, `pickedUpAt`, ...) bewaren enkel
/// de laatste toestand. Sinds het team een beslissing kan terugdraaien, is dat
/// te weinig: een terugdraaiing overschreef die velden en er bleef niets van
/// over. Hier staat elke stap, met wie ze zette.
///
/// `fromStatus`/`toStatus` zijn `String` en geen enum: materiaalaanvragen en
/// ritten hebben elk hun eigen statusenum, en één gedeelde tabel weegt zwaarder
/// dan typeveiligheid op een veld dat enkel getoond wordt.
model UitleenAuditLog {
  id String @id @default(cuid())

  /// Precies één van beide is gezet, zoals bij UitleenPayment.
  reservationId      String?
  transportBookingId String?

  kind       UitleenAuditKind
  fromStatus String?
  toStatus   String?
  /// Vrije toelichting, bv. de reden van een afwijzing of wat er gewijzigd is.
  note       String?

  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  reservation      UitleenReservation?      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  transportBooking UitleenTransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  actor            User?                    @relation("UitleenAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([transportBookingId, createdAt])
}

// -----------------------------------------------------------------------------
// Deurtoegang (KU Leuven-kaartscanner op de deur, bediend door een Raspberry Pi)
// -----------------------------------------------------------------------------

// Tijdelijke deurtoegang los van de rollen: wie geen `door.open`-recht heeft maar
// binnen [startsAt, endsAt] valt, mag de deur toch openen. Bedoeld voor gasten,
// externen of kortlopende uitzonderingen. Verlopen grants blijven staan als
// historiek; ze tellen enkel mee zolang now in het venster valt.
model DoorAccessGrant {
  id          String   @id @default(cuid())
  userId      String
  startsAt    DateTime @default(now())
  endsAt      DateTime
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endsAt])
}

// Eén rij per deurgebeurtenis: elke kaartscan (toegelaten, geweigerd, onbekende
// kaart of fout) en elke remote-open vanaf het dashboard. Voedt de statistiek en
// het logoverzicht in /admin/deur. `userId` is null wanneer de kaart niet aan een
// gebruiker gekoppeld kon worden; `offline` markeert events die de Pi tijdens een
// outage bufferde en later naflushte.
model DoorAccessLog {
  id       String        @id @default(cuid())
  at       DateTime      @default(now())
  userId   String?
  rNumber  String?
  cardName String?
  method   DoorMethod
  result   DoorLogResult
  reason   String?
  offline  Boolean       @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([result])
  @@index([userId])
}

// Persoonlijk, intrekbaar token waarmee een Apple Shortcut de deur via de
// publieke website-API kan openen. Alleen de SHA-256-hash wordt bewaard; het
// ruwe token wordt bij aanmaak exact één keer aan de gebruiker getoond.
model DoorShortcutToken {
  id         String    @id @default(cuid())
  userId     String
  label      String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Studentenkaarten: de kaart-naar-r-nummer-map, gedeeld door elke kaartlezer
// -----------------------------------------------------------------------------

// Wat de lezer "typt" (`serial;cardAppId`) hoort bij precies één r-nummer, en dat
// verandert niet meer zolang de kaart bestaat. We bewaren die koppeling dus na de
// eerste geslaagde verificatie, zodat elke volgende scan van dezelfde kaart geen
// KU Leuven-call meer nodig heeft (zie `apps/web/lib/student-card.ts`). Bewust
// géén relatie naar `User`: een kaart kan gekend zijn zonder dat er een account
// bij hoort, en het r-nummer is de sleutel waarop we die opzoeken.
model StudentCard {
  serial      String
  cardAppId   String
  rNumber     String
  firstName   String?
  lastName    String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@id([serial, cardAppId])
  @@index([rNumber])
}

// -----------------------------------------------------------------------------
// Fakscanner (kaartlezer aan de bar: één check-in per bardag, pint per 10 punten)
// -----------------------------------------------------------------------------

// **Eén rij per lid per werkingsjaar, en bewust geen rij per scan.** De stand is
// het enige dat de kring nodig heeft; een lijst van wie wanneer aan de bar stond
// is dat niet, en die zouden we dan wel bijhouden. Er valt hier dus ook niets uit
// te reconstrueren: we weten hoeveel iemand dit jaar scande en wanneer voor het
// laatst, niet op welke avonden.
//
// `lastCheckinAt` doet meteen dienst als "al gescand vandaag"-check: ligt het na
// het begin van de huidige bardag, dan telt een nieuwe scan niet. Zie
// `registerCheckin` voor hoe dat racevrij blijft zonder rij per dag.
//
// De sleutel is het **r-nummer** en niet een `User`: ook studenten zonder
// VTK-account scannen aan de bar en sparen gewoon mee.
model FakTally {
  rNumber       String
  year          Int // werkingsjaar, zodat de ranglijst op 15 juli mee reset
  points        Int      @default(0) // telt dubbel binnen het dubbeltelvenster
  checkins      Int      @default(0) // aantal keer gescand (los van de punten)
  lastCheckinAt DateTime

  @@id([rNumber, year])
  @@index([year, points])
}

// Waar een mislukte scan aan lag.
enum FakScanResult {
  CARD_ERROR // onleesbare kaart, of KU Leuven weigerde/antwoordde niet
  SERVER_ERROR // onze kant ging stuk nadat de kaart wel gelezen was
}

// **Enkel de mislukte scans.** Een log van elke geslaagde check-in zou precies de
// aanwezigheidslijst zijn die `FakTally` hierboven vermijdt. Wat de beheerder wél
// moet kunnen zien is of de lezer of KU Leuven het laat afweten, want anders is
// een stille storing pas zichtbaar wanneer iemand komt klagen dat zijn punten
// ontbreken.
model FakScanLog {
  id      String        @id @default(cuid())
  at      DateTime      @default(now())
  result  FakScanResult
  // Enkel gevuld wanneer de kaart wél gelezen raakte en het daarna misging; bij
  // een onleesbare kaart weten we per definitie niet van wie ze was.
  rNumber String?
  reason  String?

  @@index([at])
}

// -----------------------------------------------------------------------------
// KU Leuven SSO (OIDC) debug log
// -----------------------------------------------------------------------------
// Opt-in via Admin -> IT (Setting-sleutel "kul.debug"). Eén rij per KU Leuven-
// login met de ruwe claims die better-auth aan `mapProfileToUser` doorgeeft,
// zodat een superadmin kan zien welke attributen ICTS effectief vrijgeeft (bv. of
// KULeuvenEmployeeType/faculteit binnenkomt). Bevat persoonsgegevens, staat
// daarom standaard uit en wordt na 7 dagen gesnoeid.
model KulAuthLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  email   String?
  rNumber String?
  claims  Json

  @@index([at])
}

// -----------------------------------------------------------------------------
// Adminlogboek: wie deed wat in de admin
// -----------------------------------------------------------------------------
// Eén rij per beheerdersactie (evenement aangemaakt, pagina bewerkt, deurtoegang
// gegeven, ...), geschreven door `logAudit` in apps/web/lib/audit.ts. Enkel
// wijzigende acties, geen leesacties en geen zelfbediening van leden.
//
// De rijen worden na AUDIT_RETENTION_DAYS gesnoeid: het is een logboek voor
// "wie heeft dit gedaan", geen archief. Namen worden meegekopieerd (net als bij
// SsoAuditLog) zodat de regel leesbaar blijft nadat het lid of het onderwerp
// verdwenen is; een FK naar het onderwerp zou de regel mee weggooien.
model AdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor     User?   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  /// Naam van de handelende persoon op het moment van de actie.
  actorName String

  /// create | update | delete | grant | revoke | publish | ... (zie AUDIT_ACTIONS)
  action   String
  /// Soort onderwerp, sleutel uit de registry in apps/web/lib/audit.ts.
  entity   String
  entityId String?
  /// Naam van het onderwerp op het moment van de actie, bv. "Career Fair".
  target   String
  /// Korte toelichting, bv. welke velden gewijzigd zijn.
  summary  String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, createdAt])
}

// -----------------------------------------------------------------------------
// Uitgaande e-mail: technisch verzendlogboek
// -----------------------------------------------------------------------------
// Eén rij per verzendpoging vanuit apps/web. De inhoud staat erbij omdat dit
// logboek net bedoeld is om foute templates, ontvangers en links te kunnen
// reconstrueren. Daarom is het scherm superadmin-only en worden de rijen na een
// korte bewaartermijn verwijderd; dit is geen mailbox of blijvend archief.
enum EmailLogStatus {
  SENT
  PARTIAL
  FAILED
  SIMULATED
}

model EmailLog {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  completedAt DateTime       @db.Timestamptz(3)
  durationMs  Int
  status      EmailLogStatus

  source  String
  from    String
  to      String
  cc      String?
  replyTo String?
  subject String
  text    String
  html    String?

  /// Enkel metadata (naam, MIME-type en grootte), nooit de bytes zelf.
  attachments Json @default("[]")

  /// Wat de SMTP-server teruggaf. "SENT" betekent dat de server de mail
  /// aanvaardde, niet dat de inbox van de ontvanger ze gegarandeerd afleverde.
  providerMessageId String?
  providerResponse  String?
  accepted          String[] @default([])
  rejected          String[] @default([])
  error             String?

  @@index([createdAt])
  @@index([status, createdAt])
}

// -----------------------------------------------------------------------------
// better-auth specific tables
// -----------------------------------------------------------------------------

model Session {
  id                 String              @id
  token              String
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Eenmalige link die per mail vertrekt: een nieuw account bevestigen of een
/// vergeten wachtwoord opnieuw zetten.
///
/// Bewust naast better-auths eigen `Verification`-tabel en niet erin. Die tabel
/// is van de plugin: better-auth schrijft en ruimt er zelf in op, en meeliften
/// betekent dat een toekomstige plugin-update onze tokens kan opruimen of van
/// vorm veranderen. Dit is één tabel met één eigenaar.
///
/// Enkel de hash wordt bewaard, zoals bij `CalendarFeedToken`: wie de database
/// leest mag geen werkende link kunnen samenstellen.
model AccountEmailToken {
  id     String                @id @default(cuid())
  userId String
  kind   AccountEmailTokenKind

  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation("AccountEmailTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

enum AccountEmailTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

//JWT plugin
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)

  @@map("jwks")
}

//SSO-provider
model OauthClient {
  id                      String    @id
  clientId                String    @unique
  clientSecret            String?
  disabled                Boolean?
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]
  user                    User?     @relation(fields: [userId], references: [id])
  userId                  String?
  referenceId             String?
  createdAt               DateTime? @db.Timestamptz(3)
  updatedAt               DateTime? @db.Timestamptz(3)
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]
  tokenEndpointAuthMethod String?
  grantTypes              String[]
  responseTypes           String[]
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?
  metadata                Json?

  /// Wie hier mag inloggen; zie SsoAccessMode. Staat bewust op deze tabel en
  /// niet in een aparte VTK-tabel: de poort draait op het hete pad van élke
  /// autorisatie en moet zonder join te beantwoorden zijn. De plugin negeert
  /// kolommen die ze niet kent.
  accessMode          SsoAccessMode @default(OPEN)
  /// Prefix waarop de permissiecodes van deze client gevalideerd worden
  /// ("wiki" -> wiki.read, wiki.access). Null zolang er geen vocabulaire is.
  permissionNamespace String?

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  clientPermissions  SsoClientPermission[]

  @@map("oauthClient")
}

/// Het permissievocabulaire dat één client zelf definieert (`wiki.read`,
/// `cudi.admin`). Bewust géén VTK-permissies: dit zegt wat een lid mag binnen
/// die ene applicatie, niet wat het binnen VTK mag.
model SsoClientPermission {
  id       String      @id @default(cuid())
  client   OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientId String

  code          String
  labelNl       String
  labelEn       String
  descriptionNl String?
  descriptionEn String?

  /// De `<namespace>.access`-rij die toegang verleent tot een RESTRICTED client.
  /// Wordt automatisch aangemaakt en mag niet verwijderd worden zolang de client
  /// beperkt is: ze weghalen sluit iedereen buiten.
  system     Boolean @default(false)
  /// Verbergt de code in toekenningsformulieren maar laat bestaande
  /// toekenningen werken. Veiliger dan verwijderen; zie ontwerp 9.7.
  deprecated Boolean @default(false)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userGrants  SsoUserClientPermission[]
  roleGrants  SsoRoleClientPermission[]
  groupGrants SsoGroupClientPermission[]

  @@unique([clientId, code])
  @@index([clientId, deprecated])
}

/// Directe toekenning aan één lid. Deze reset NIET op 15 juli: een grant aan de
/// ene persoon die een integratie onderhoudt is geen werkingsjaar-begrip, en
/// elke partnertoepassing 's nachts leegmaken is een storing die niemand zag
/// aankomen. Gebruik `expiresAt` voor wat wél tijdelijk is. Zie ontwerp 9.5.
model SsoUserClientPermission {
  id           String              @id @default(cuid())
  permission   SsoClientPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  /// Gedenormaliseerd zodat de hete query (userId + clientId) één indexlookup is.
  clientId     String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?
  note            String?

  @@unique([permissionId, userId])
  @@index([userId, clientId])
  @@index([clientId])
  @@index([expiresAt])
}

/// Toekenning via een VTK-rol. Werkingsjaar-gescoped via UserRole, dus deze
/// erft de 15-juli-reset.
model SsoRoleClientPermission {
  id           String              @id @default(cuid())
  permission   SsoClientPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  clientId     String
  role         Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String

  grantedByUserId String?
  grantedAt       DateTime @default(now())

  @@unique([permissionId, roleId])
  @@index([roleId, clientId])
}

/// Toekenning via een post. LEADER geldt enkel voor de verantwoordelijke,
/// exact zoals GroupRole dat voor rollen doet. Ook werkingsjaar-gescoped.
model SsoGroupClientPermission {
  id           String              @id @default(cuid())
  permission   SsoClientPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  clientId     String
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      String
  kind         RoleGrantKind       @default(DEFAULT)

  grantedByUserId String?
  grantedAt       DateTime @default(now())

  @@unique([permissionId, groupId, kind])
  @@index([groupId, clientId])
}

model OauthRefreshToken {
  id                String             @id
  token             String             @unique
  client            OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientId          String
  session           Session?           @relation(fields: [sessionId], references: [id])
  sessionId         String?
  user              User               @relation(fields: [userId], references: [id])
  userId            String
  referenceId       String?
  scopes            String[]
  revoked           DateTime?          @db.Timestamptz(3)
  authTime          DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @db.Timestamptz(3)
  expiresAt         DateTime           @db.Timestamptz(3)
  oauthAccessTokens OauthAccessToken[]

  // De plugin declareert deze indexen wel, de Prisma-modellen droegen ze niet.
  // Ze bedienen de hete paden: token-uitwisseling zoekt op clientId/userId, en
  // de opkuis van verlopen tokens scant op expiresAt.
  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id          String             @id
  token       String             @unique
  client      OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientId    String
  session     Session?           @relation(fields: [sessionId], references: [id])
  sessionId   String?
  refresh     OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  refreshId   String?
  user        User?              @relation(fields: [userId], references: [id])
  userId      String?
  referenceId String?
  scopes      String[]
  createdAt   DateTime           @db.Timestamptz(3)
  expiresAt   DateTime           @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([refreshId])
  @@index([expiresAt])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id          String      @id
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  clientId    String
  referenceId String?
  scopes      String[]
  createdAt   DateTime    @db.Timestamptz(3)
  updatedAt   DateTime    @db.Timestamptz(3)

  // De uniciteit van een toestemming (clientId, userId, referenceId) staat NIET
  // hier maar als expressie-index in de migratie: Postgres beschouwt NULL's als
  // onderling verschillend, dus een gewone @@unique zou net het courante geval
  // (referenceId IS NULL) ongemoeid laten en duplicaten toelaten. De migratie
  // gebruikt COALESCE("referenceId",'').
  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

/// Wie heeft wat gewijzigd aan welke OAuth-client. Bewust geen veld-diffs: het
/// SSO-team is klein, en de vraag is in de praktijk "wie zette dit aan en
/// wanneer", niet "welke byte veranderde".
///
/// Deze log is de enige verantwoording die er is: iedereen met
/// `oauth.client.edit` mag elke client bewerken, dus er is geen eigenaar of
/// fijnmazig recht dat een wijziging nog tegenhoudt.
model SsoAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  /// Naam op het moment van de actie. Los van de relatie, zodat de regel
  /// leesbaar blijft nadat het lid verwijderd is.
  actorName String

  /// Geen relatie naar OauthClient: een verwijderde client moet juist in de log
  /// blijven staan, en een FK zou die regel mee weggooien of het verwijderen
  /// blokkeren.
  clientId   String
  clientName String

  /// create | update | rotate-secret | enable | disable | delete | revoke-tokens
  action  String
  /// Korte, leesbare samenvatting, bv. "redirect-URI's gewijzigd".
  summary String?

  @@index([createdAt])
  @@index([clientId])
  @@map("ssoAuditLog")
}

// -----------------------------------------------------------------------------
// Formulieren
//
// Leden beheren formulieren in de admin, bezoekers vullen ze in op de publieke
// site, beheerders bekijken en exporteren de inzendingen. De structuur volgt
// bewust die van ticketing: grants per formulier (persoon én post), NL/EN-
// kolomparen in plaats van een JSON-blob met vertalingen, een auditlog en een
// outbox voor mail. Zie docs/forms.md voor de end-to-end flow en
// docs/design-decisions.md voor de kringkeuzes.
// -----------------------------------------------------------------------------

model Form {
  id              String  @id @default(cuid())
  slug            String  @unique
  /// Optionele koppeling aan een kalenderevenement: het formulier verschijnt dan
  /// bij dat evenement en de bevestigingsmail kan er een .ics bij steken.
  calendarEventId String? @unique
  /// Optionele koppeling aan een contentpagina: het formulier staat dan als
  /// paneel in de tekst van die pagina, op de plaats van de markering
  /// `[[formulier]]` en anders onderaan. Uniek, want een pagina heeft hoogstens
  /// een formulier: twee panelen in dezelfde tekstkolom lezen als een fout, en
  /// de markering zou niet meer weten welke van de twee ze aanwijst.
  pageId          String? @unique
  ownerGroupId    String
  createdById     String?

  titleNl String
  titleEn String?
  /// Markdown, bewerkt met MarkdownEditor en gerenderd in een prose-vtk container.
  introNl String?
  introEn String?

  status        FormStatus     @default(DRAFT)
  audience      FormAudience   @default(PUBLIC)
  /// Staat dit formulier in de publieke lijst op /formulieren? Uit betekent enkel
  /// dat het er niet in staat; wie de link heeft, geraakt er gewoon op. Een
  /// sollicitatieformulier hoort meestal niet in een overzicht.
  listed        Boolean        @default(true)
  localeMode    FormLocaleMode @default(BOTH)
  /// Wat een bezoeker in de niet-aangeboden taal te zien krijgt.
  unavailableNl String?
  unavailableEn String?

  opensAt  DateTime? @db.Timestamptz(3)
  closesAt DateTime? @db.Timestamptz(3)
  timeZone String    @default("Europe/Brussels")

  maxEntries               Int?
  /// Vol, maar toch invulbaar: inzendingen komen dan op de wachtlijst.
  allowWaitlist            Boolean @default(false)
  /// Secties één voor één tonen in plaats van onder elkaar. Nodig om te kunnen
  /// springen: naar een sectie verderop springen heeft geen betekenis wanneer
  /// alles toch al op één pagina staat.
  stepBySections           Boolean @default(false)
  allowMultipleSubmissions Boolean @default(false)
  /// Enkel ingelogde leden kunnen bewerken: een anonieme inzending heeft geen
  /// eigenaar om ze aan terug te geven, en een bewerklink per mail zou
  /// persoonsgegevens ontsluiten aan wie hem doorgestuurd krijgt.
  allowEditAfterSubmit     Boolean @default(false)
  /// Concept opslaan en later verdergaan. Om dezelfde reden alleen voor leden.
  allowDrafts              Boolean @default(false)

  confirmationEnabled        Boolean @default(false)
  confirmationSubjectNl      String?
  confirmationSubjectEn      String?
  confirmationBodyNl         String?
  confirmationBodyEn         String?
  confirmationIncludeAnswers Boolean @default(true)
  confirmationIncludeIcs     Boolean @default(false)

  /// Wie verwittigd wordt bij een inzending, en hoe vaak.
  notifyMode   FormNotifyMode @default(NONE)
  notifyEmails String[]       @default([])

  thankYouNl String?
  thankYouEn String?

  /// Verplichte toestemmingsvraag bovenop de velden, met de link naar het
  /// privacybeleid erbij.
  requireConsent Boolean @default(false)
  consentTextNl  String?
  consentTextEn  String?

  /// Leeg = niet automatisch opruimen; dat is bewust de standaard, want stil
  /// verdwijnende inzendingen zijn erger dan een volle tabel.
  retentionDays Int?

  settings Json @default("{}")

  publishedAt DateTime? @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  page          Page?          @relation(fields: [pageId], references: [id], onDelete: SetNull)
  ownerGroup    Group          @relation("FormOwnerGroup", fields: [ownerGroupId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sections       FormSection[]
  fields         FormField[]
  options        FormFieldOption[]
  conditions     FormFieldCondition[]
  entries        FormEntry[]
  answers        FormAnswer[]
  uploads        FormFileUpload[]
  userGrants     FormUserGrant[]
  groupGrants    FormGroupGrant[]
  auditLogs      FormAuditLog[]
  outboxMessages FormOutboxMessage[]

  @@index([ownerGroupId])
  @@index([status, opensAt, closesAt])
}

/// Secties maken een lang formulier leesbaar en geven de voortgangsbalk haar
/// stappen. Velden zonder sectie horen bovenaan, vóór de eerste sectie.
model FormSection {
  id            String  @id @default(cuid())
  formId        String
  sortOrder     Int     @default(0)
  titleNl       String
  titleEn       String?
  descriptionNl String?
  descriptionEn String?

  /// Waar de bezoeker na deze sectie belandt wanneer geen enkel antwoord iets
  /// anders zegt. Leeg = gewoon de volgende sectie in volgorde.
  nextSectionId String?
  /// Het formulier eindigt na deze sectie, ook al volgen er nog secties.
  endsForm      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  form         Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields       FormField[]
  /// Zelfverwijzing voor de standaardsprong. SetNull: wie de doelsectie
  /// verwijdert, laat de bezoeker gewoon weer naar de volgende sectie gaan in
  /// plaats van naar een sectie die niet meer bestaat.
  nextSection  FormSection?      @relation("FormSectionNext", fields: [nextSectionId], references: [id], onDelete: SetNull)
  previousOf   FormSection[]     @relation("FormSectionNext")
  optionRoutes FormFieldOption[] @relation("FormOptionNextSection")

  @@unique([id, formId])
  @@index([formId, sortOrder])
  @@index([nextSectionId])
}

model FormField {
  id        String        @id @default(cuid())
  formId    String
  sectionId String?
  /// Stabiele sleutel: de kolomnaam in de CSV en de sleutel in een prefill-link.
  /// Het label hernoemen laat deze ongemoeid, zodat een export nooit van kolom
  /// verspringt en een oud antwoord bij zijn eigen vraag blijft horen.
  code      String
  type      FormFieldType
  sortOrder Int           @default(0)

  labelNl String
  labelEn String?
  helpNl  String?
  helpEn  String?

  required Boolean @default(false)
  /// Typespecifiek: maxLength, multiline, min/max, pattern met eigen
  /// foutmelding, minChecked/maxChecked, maxFiles, toegelaten extensies,
  /// schaalbereik, "Andere, namelijk", husselen, imageKey. Wordt door
  /// lib/forms/schema.ts gevalideerd en nooit rauw vertrouwd.
  config   Json    @default("{}")

  /// Soft delete. Een veld met antwoorden verdwijnt van het formulier maar houdt
  /// zijn kolom in de export; hard verwijderen zou bestaande inzendingen
  /// uithollen.
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  form             Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  section          FormSection?         @relation(fields: [sectionId, formId], references: [id, formId], onDelete: Restrict)
  options          FormFieldOption[]
  answers          FormAnswer[]
  uploads          FormFileUpload[]
  conditions       FormFieldCondition[] @relation("FormFieldConditionTarget")
  conditionSources FormFieldCondition[] @relation("FormFieldConditionSource")

  @@unique([formId, code])
  @@unique([id, formId])
  @@index([formId, sortOrder])
  @@index([sectionId])
}

/// Keuzeopties zijn rijen en geen JSON-lijst: een quotum per optie moet
/// race-veilig afgeteld kunnen worden (zoals TicketInventoryPool doet), en een
/// geschrapte optie moet zichtbaar blijven zolang iemand ze aangeduid heeft.
model FormFieldOption {
  id        String  @id @default(cuid())
  formId    String
  fieldId   String
  /// Stabiel, net als FormField.code: dit is wat er in het antwoord belandt.
  code      String
  labelNl   String
  labelEn   String?
  sortOrder Int     @default(0)

  /// Leeg = onbeperkt. `quotaUsed` en `version` maken het aftellen race-veilig.
  quotaLimit    Int?
  quotaUsed     Int     @default(0)
  version       Int     @default(0)
  /// Vol, maar toch kiesbaar: de inzending komt dan op de wachtlijst in plaats
  /// van geweigerd te worden.
  allowWaitlist Boolean @default(false)

  /// Springt naar deze sectie wanneer de bezoeker deze optie kiest.
  nextSectionId String?
  /// Beëindigt het formulier meteen bij deze keuze.
  endsForm      Boolean @default(false)

  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  field       FormField    @relation(fields: [fieldId, formId], references: [id, formId], onDelete: Cascade)
  nextSection FormSection? @relation("FormOptionNextSection", fields: [nextSectionId], references: [id], onDelete: SetNull)

  @@unique([fieldId, code])
  @@unique([id, formId])
  @@index([formId])
  @@index([fieldId, sortOrder])
}

/// Veld X is enkel zichtbaar wanneer veld Y een bepaald antwoord heeft. Meerdere
/// condities op hetzelfde veld gelden samen (AND). De server herberekent dit bij
/// het indienen: een onzichtbaar veld is nooit verplicht en aanvaardt geen
/// antwoord, ongeacht wat de client opstuurt.
model FormFieldCondition {
  id            String                     @id @default(cuid())
  formId        String
  /// Het veld dat getoond of verborgen wordt.
  fieldId       String
  /// Het veld waarvan het antwoord beslist.
  sourceFieldId String
  operator      FormFieldConditionOperator @default(EQUALS)
  /// Optiecode of vrije waarde; leeg bij IS_ANSWERED.
  value         String?
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now()) @db.Timestamptz(3)

  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  field       FormField @relation("FormFieldConditionTarget", fields: [fieldId, formId], references: [id, formId], onDelete: Cascade)
  sourceField FormField @relation("FormFieldConditionSource", fields: [sourceFieldId, formId], references: [id, formId], onDelete: Cascade)

  @@index([formId])
  @@index([fieldId])
  @@index([sourceFieldId])
}

model FormEntry {
  id     String @id @default(cuid())
  formId String

  status       FormEntryStatus  @default(DRAFT)
  reviewStatus FormReviewStatus @default(NEW)
  reviewerId   String?
  internalNote String?

  submittedById  String?
  /// Naam en e-mail zoals ingevuld of overgenomen uit het profiel. Apart bewaard
  /// zodat mailen en ontdubbelen niet elke keer door de antwoorden moet lopen.
  submitterName  String?
  submitterEmail String?
  locale         Locale  @default(NL)

  /// Testinzending: telt niet mee in tellingen, quota of export tenzij expliciet
  /// gevraagd, zodat een beheerder zijn eigen formulier kan uitproberen.
  isTest Boolean @default(false)

  /// Op de wachtlijst: wel ingediend, maar zonder plaats. Zo'n inzending claimt
  /// geen quotum; een beheerder haalt ze erbij wanneer er iets vrijkomt.
  waitlisted   Boolean   @default(false)
  waitlistedAt DateTime? @db.Timestamptz(3)

  /// Enkel om misbruik te herkennen; de retentie kuist dit op.
  requestFingerprint String?

  submittedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  form        Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy User? @relation("FormEntrySubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewer    User? @relation("FormEntryReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  answers FormAnswer[]
  uploads FormFileUpload[]

  @@unique([id, formId])
  @@index([formId, status, submittedAt])
  @@index([formId, submittedById])
  @@index([submittedById])
  @@index([reviewerId])
  @@index([submitterEmail])
}

model FormAnswer {
  id        String @id @default(cuid())
  formId    String
  entryId   String
  fieldId   String
  /// Momentopname van FormField.code. De export leest deze en niet de huidige
  /// code, zodat een hernoemd of gearchiveerd veld zijn kolom houdt.
  fieldCode String

  valueText    String?
  valueNumber  Float?
  valueDate    DateTime? @db.Timestamptz(3)
  valueBool    Boolean?
  /// Optiecodes bij een keuzeveld.
  valueOptions String[]  @default([])
  /// De vrije tekst bij "Andere, namelijk ...".
  otherText    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  form  Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  entry FormEntry @relation(fields: [entryId, formId], references: [id, formId], onDelete: Cascade)
  field FormField @relation(fields: [fieldId, formId], references: [id, formId], onDelete: Cascade)

  @@unique([entryId, fieldId])
  @@index([formId, fieldId])
  @@index([entryId])
}

/// Bestanden landen in de objectopslag (packages/storage), nooit op het
/// filesystem. Downloaden loopt door een route die de grants checkt.
model FormFileUpload {
  id           String   @id @default(cuid())
  formId       String
  entryId      String
  fieldId      String
  storageKey   String
  originalName String
  contentType  String?
  sizeBytes    Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  form  Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  entry FormEntry @relation(fields: [entryId, formId], references: [id, formId], onDelete: Cascade)
  field FormField @relation(fields: [fieldId, formId], references: [id, formId], onDelete: Cascade)

  @@index([entryId])
  @@index([formId, fieldId])
}

model FormUserGrant {
  id          String        @id @default(cuid())
  formId      String
  userId      String
  role        FormGrantRole
  grantedById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  form      Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User  @relation("FormGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("FormGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([formId, userId])
  @@index([userId])
}

model FormGroupGrant {
  id          String              @id @default(cuid())
  formId      String
  groupId     String
  role        FormGrantRole
  scope       FormGroupGrantScope @default(ALL_MEMBERS)
  grantedById String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  form      Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("FormGroupGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([formId, groupId])
  @@index([groupId])
}

/// Wie wijzigde welk formulier, wie verwijderde welke inzending. In de stijl van
/// TicketAuditLog; de retentie wist het IP-adres en de ruwe metadata.
model FormAuditLog {
  id          String   @id @default(cuid())
  formId      String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  form      Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  actorUser User? @relation("FormAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([formId, entityType, entityId])
  @@index([actorUserId])
}

/// Eigen outbox naast die van ticketing, en bewust geen gedeelde tabel: die
/// hangt met verplichte FK's aan TicketEvent en TicketOrder, en die
/// generaliseren zou de ticketmodule moeten migreren. Het patroon is identiek:
/// een unieke dedupeKey, herpogingen met uitstel, en een status per bericht.
model FormOutboxMessage {
  id          String           @id @default(cuid())
  formId      String?
  entryId     String?
  type        String
  dedupeKey   String           @unique
  recipient   String?
  payload     Json
  status      FormOutboxStatus @default(PENDING)
  attempts    Int              @default(0)
  availableAt DateTime         @default(now()) @db.Timestamptz(3)
  lockedAt    DateTime?        @db.Timestamptz(3)
  lockedBy    String?
  lastError   String?
  sentAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  form Form? @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([formId])
}

// -----------------------------------------------------------------------------
// 24urenloop-app: wie de desktop-app mag downloaden
// -----------------------------------------------------------------------------

/// De app wordt gedeeld met andere kringen, niet met onze eigen leden, dus de
/// toegang hangt aan een e-mailadres en niet aan een `User`. Beheerd in
/// Admin -> IT -> 24UL App Download.
model UrenloopDownloadEmail {
  id        String   @id @default(cuid())
  /// Altijd in kleine letters bewaard; het adres is de sleutel waarop de
  /// codeaanvraag matcht en "Jan@..." en "jan@..." zijn dezelfde inbox.
  email     String   @unique
  /// Vrije notitie, bv. de kring waar het adres bij hoort.
  note      String?
  addedById String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  addedBy User? @relation("UrenloopDownloadEmailAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([email])
}

/// Per computer één token, waarmee de Windows-app zijn updates ophaalt.
///
/// De updater kan geen mail lezen en geen code intikken, dus koppelt de app zich
/// één keer per computer: hetzelfde adres, dezelfde code, en daarna dit token in
/// een `Authorization`-header (electron-updater `addAuthHeader`). Zo hangen de
/// updates aan dezelfde lijst als de downloads, in plaats van aan een gedeeld
/// geheim dat je niet per kring kan intrekken.
///
/// Enkel de SHA-256-hash wordt bewaard; het ruwe token bestaat na het koppelen
/// alleen nog op die computer. 32 willekeurige bytes zijn niet te raden, dus een
/// kale hash volstaat hier waar de code van zes cijfers HMAC nodig had.
model UrenloopDeviceToken {
  id         String    @id @default(cuid())
  /// Het adres dat koppelde. Verdwijnt dat van de lijst, dan stopt dit token.
  email      String
  tokenHash  String    @unique
  /// Computernaam, zodat de admin ziet welke laptop dit is.
  label      String
  /// Versie die deze computer bij de laatste controle draaide.
  appVersion String?
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, revokedAt])
}

/// Eenmalige code per aanvraag. Enkel de SHA-256-hash wordt bewaard, zoals bij
/// `DoorShortcutToken`: de code zelf staat in de mailbox van de ontvanger en
/// hoort nergens anders te bestaan.
model UrenloopDownloadCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  /// Aantal foute pogingen op deze code; na `URENLOOP_CODE_MAX_ATTEMPTS` is ze
  /// verbrand, anders is een code van zes cijfers in een uur uit te proberen.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Lesbezoeken: een organisatie komt bij het begin van een les kort iets
// aankondigen. Met de faculteit is afgesproken dat VTK Onderwijs dit coördineert,
// zodat professoren niet rechtstreeks aangeschreven worden.
//
// Vervangt de Google Form + Sheet + mailmerge. De weg van een aanvraag:
//
//   publiek formulier (/lesbezoeken, geen login)
//     -> PENDING   VTK Onderwijs kijkt na op duplicaten en voorkeuren
//     -> REJECTED  meteen geweigerd, met reden naar de aanvrager
//     -> ASKED     mail naar de professor vertrokken, wachten op antwoord
//          -> APPROVED / DECLINED, telkens teruggekoppeld naar de aanvrager
//
// De professor antwoordt per mail, niet in deze app: die kennen we niet en die
// gaan we geen account geven. Wie beoordeelt, zet het antwoord hier zelf om in
// een status. Zie docs/design-decisions.md ("Lesbezoeken").
// -----------------------------------------------------------------------------

enum LesbezoekStatus {
  /// Net binnengekomen; VTK Onderwijs moet nog beslissen of de vraag doorgaat.
  PENDING
  /// De vraag staat bij de professor. `professorMailedAt` zegt sinds wanneer.
  ASKED
  /// De professor gaf groen licht.
  APPROVED
  /// De professor wil het niet.
  DECLINED
  /// VTK Onderwijs stuurde de vraag niet door (duplicaat, een professor die
  /// nooit lesbezoeken toelaat, een organisatie die te veel aanvraagt).
  REJECTED
  /// De aanvrager trok de vraag in, of ze werd achteraf geannuleerd.
  CANCELLED
}

/// Wie het lesbezoek komt geven: een post, een werkgroep, een andere kring, een
/// externe organisatie.
///
/// Een eigen tabel en geen vrij tekstveld op het bezoek zelf, om twee redenen:
/// de kleur in de kalender moet bij dezelfde organisatie blijven horen (en niet
/// afhangen van de volgorde waarin de rijen toevallig binnenkomen), en
/// "VTK Onderwijs" en "VTK - Onderwijs" horen één lijn in de kalender te zijn.
model LesbezoekOrganisation {
  id           String   @id @default(cuid())
  name         String   @unique
  /// Hex, zoals bij `CalendarCategory.colour`; de kalender zet ze als CSS-var.
  colour       String   @default("#3B82F6")
  /// Vast contactadres van de organisatie, als er een is. De aanvrager vult in
  /// het formulier daarnaast altijd zijn eigen adres in.
  contactEmail String?
  /// Interne notitie, enkel zichtbaar in het beheer. Hier komt het
  /// "Shame"-tabblad van de Sheet terecht ("kwam niet opdagen", "vraagt te veel
  /// aan"): dat hoort bij de aanvraag te staan, zodat wie beoordeelt het ziet
  /// zonder een ander bestand open te doen.
  note         String?
  /// Uit = verdwijnt uit de keuzelijst van het publieke formulier. Bestaande
  /// bezoeken blijven staan, want de historiek mag niet mee veranderen.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  visits Lesbezoek[]

  @@index([active, name])
}

/// Eén aangevraagd of ingepland lesbezoek. De velden volgen het formulier dat
/// dit vervangt, zodat een aanvraag niet minder informatie draagt dan vroeger.
model Lesbezoek {
  id             String @id @default(cuid())
  organisationId String

  /// Instants; de weergave rekent naar Brussel-wandklok (lib/brussels.ts).
  /// `endsAt` volgt uit `longVisit`, maar staat los opgeslagen zodat een
  /// beheerder een afwijkende duur kan zetten (of het uur dat de professor
  /// voorstelde) zonder de vraag zelf te herschrijven.
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  /// "Duurt het lesbezoek langer dan vijf minuten?" uit het formulier. Bepaalt
  /// ook welke mailtemplate de professor krijgt (kort of lang bezoek).
  longVisit Boolean  @default(false)

  /// De les. `audience` is de doelgroep ("3e Bach, Computerwetenschappen"),
  /// `course` het vak. Beide vrije tekst: het OPO-aanbod van de faculteit staat
  /// nergens in deze database, en het formulier had niet voor niets een
  /// "Anders"-optie.
  audience String
  course   String

  /// Waar het bezoek over gaat, en de toelichting die letterlijk in de mail naar
  /// de professor terechtkomt. Die tekst is er om de professor te overtuigen, dus
  /// ze wordt niet samengevat of afgekapt.
  subject     String
  teacherNote String

  /// De professor. Het adres is het beslissende gegeven (daar vertrekt de vraag
  /// naartoe); de naam staat in de aanhef van de mail en in de kalender. De naam
  /// wordt uit het adres afgeleid en is daarna handmatig te verbeteren, want
  /// samengestelde voor- en achternamen lopen daar mis.
  teacherEmail String
  teacherName  String?

  /// De aanvrager uit het publieke formulier. Blijft leeg wanneer een beheerder
  /// een bezoek zelf inplant.
  requesterName  String?
  requesterEmail String?
  requesterPhone String?

  status LesbezoekStatus @default(PENDING)

  /// Waarom geweigerd, of wat de professor antwoordde. Gaat mee in de mail naar
  /// de aanvrager, dus schrijf hier een zin en geen code.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(3)

  /// Wanneer de vraag naar de professor vertrok, wanneer er gepord werd, en
  /// wanneer de aanvrager de uitkomst hoorde. Zonder deze drie is "heb ik dit al
  /// gedaan?" niet te beantwoorden, en dat was in de Sheet een hulpkolom.
  professorMailedAt   DateTime? @db.Timestamptz(3)
  professorNudgedAt   DateTime? @db.Timestamptz(3)
  requesterNotifiedAt DateTime? @db.Timestamptz(3)

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  organisation LesbezoekOrganisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reviewedBy   User?                 @relation("LesbezoekReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("LesbezoekCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  scheduledMails LesbezoekScheduledMail[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([organisationId, startsAt])
  /// Voedt de dubbelaanvraag-waarschuwing: dezelfde professor op dezelfde dag.
  @@index([teacherEmail, startsAt])
}

/// Een ingeplande mail rond een lesbezoek (bv. vraag naar een docent die pas
/// de volgende ochtend tijdens kantooruren verstuurd mag worden).
model LesbezoekScheduledMail {
  id          String  @id @default(cuid())
  lesbezoekId String
  kind        String
  to          String
  cc          String?
  subject     String
  body        String

  /// De overige lesbezoeken die in dezelfde gebundelde mail zitten. Een
  /// terugkoppeling naar een aanvrager met twintig bezoeken is één mail, maar ze
  /// moet wel twintig keer `requesterNotifiedAt` zetten. `lesbezoekId` blijft de
  /// eerste van de reeks, zodat de cascade en de weergave in het paneel werken;
  /// wie de mail bij een bezoek zoekt, kijkt dus naar beide velden.
  bundledIds String[] @default([])

  /// Wanneer de mail volgens planning verstuurd moet worden.
  sendAt       DateTime  @db.Timestamptz(3)
  /// Wanneer de mail daadwerkelijk verstuurd werd (null = nog in wachtrij).
  sentAt       DateTime? @db.Timestamptz(3)
  /// Foutregistratie indien versturen mislukte.
  failedAt     DateTime? @db.Timestamptz(3)
  failedReason String?

  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lesbezoek Lesbezoek @relation(fields: [lesbezoekId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("LesbezoekScheduledMailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sendAt, sentAt])
  @@index([lesbezoekId])
}

/// Wat je van een professor, een vak of een faculteit moet weten vóór je een
/// aanvraag doorstuurt: "keurt alles af", "enkel op het einde van de les",
/// "spookvak", "één lesbezoek per organisatie", "enkel VTK".
///
/// Dit was het "Peculiarities"-tabblad van de Sheet, en het is precies de kennis
/// die verdwijnt wanneer de verantwoordelijke van vorig jaar vertrekt. Het staat
/// daarom in de database: bij het beoordelen zoekt het scherm zelf de regels op
/// die bij deze aanvraag horen, in plaats van te hopen dat iemand een ander
/// tabblad opent.
model LesbezoekPeculiarity {
  id      String @id @default(cuid())
  /// Waar deze regel op slaat: een naam, een mailadres, een vak of een
  /// faculteit. Wordt hoofdletterongevoelig vergeleken met de professor en het
  /// vak van een aanvraag.
  subject String
  note    String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([subject])
}

// -----------------------------------------------------------------------------
// VTK-app (Expo, iOS + Android)
// -----------------------------------------------------------------------------

/// Een toestel waarop de VTK-app geïnstalleerd staat en dat pushberichten wil.
///
/// De tabel bestaat al voordat er iets verstuurd wordt. Dat is met opzet: een
/// pushtoken vraagt native code (`expo-notifications`), en die kan niet via een
/// OTA-update bijgezet worden. Zou dit pas later komen, dan had iedereen op dat
/// moment een nieuwe build uit de store nodig; nu registreert de app vanaf haar
/// eerste versie en kan de verzendkant er later gewoon naast komen.
///
/// Het token is de sleutel en niet de gebruiker: één lid kan meerdere toestellen
/// hebben, en Expo geeft na een herinstallatie een nieuw token voor hetzelfde
/// toestel. Opruimen gebeurt bij het verzenden, wanneer Expo een token als
/// `DeviceNotRegistered` afkeurt.
model AppPushDevice {
  id     String @id @default(cuid())
  userId String
  /// Het Expo-pushtoken, in de vorm `ExponentPushToken[...]`.
  token  String @unique

  platform   AppPushPlatform
  /// Versie van de app die dit token registreerde; enkel om te kunnen zien wie
  /// waarop zit wanneer er iets misgaat.
  appVersion String?

  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Wordt bijgewerkt bij elke registratie, dus feitelijk bij elke start van de
  /// app. Een toestel dat maanden niet meer opstartte, mag opgeruimd worden.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation("AppPushDeviceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

enum AppPushPlatform {
  ios
  android
}

// -----------------------------------------------------------------------------
// De VTK-app: interesse, meldingen en bonnetjes aan de toog
//
// Alles hieronder bestaat omdat een app iets kan wat een website niet kan: op
// het juiste moment iets van zich laten horen, en aan een balie iets tonen dat
// iemand anders scant. De regels zelf blijven staan waar ze al stonden; dit zijn
// enkel de rijen die daarvoor nodig zijn.
// -----------------------------------------------------------------------------

/// "Ik ga hier waarschijnlijk naartoe."
///
/// Bewust geen inschrijving: er hangt geen plaats, geen betaling en geen
/// deelnemerslijst aan. Het is een private markering waarmee een lid zijn eigen
/// kalender maakt en waarop de herinnering van de dag zelf hangt. Wie echt moet
/// inschrijven, doet dat via een formulier of een ticket.
model CalendarEventInterest {
  id      String @id @default(cuid())
  userId  String
  eventId String

  /// Alumni-informatie voor dit ene evenement. Ze wordt bewust niet uit het
  /// profiel gelezen: iemand kan per activiteit een andere naam gebruiken en
  /// kiest hier ook per veld wat andere bezoekers mogen zien.
  displayName    String?
  graduationYear Int?
  wasInVtk       Boolean @default(false)

  /// Wat dit lid publiek wil tonen in de aanwezigheidslijst. Alles staat
  /// standaard uit, zodat "ik kom" ook volledig anoniem kan blijven.
  showName           Boolean @default(false)
  showGraduationYear Boolean @default(false)
  showWasInVtk       Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// Wanneer de herinnering voor dit evenement vertrokken is. Zelfde
  /// claim-dan-versturen-aanpak als bij de broodjes: eerst de markering in een
  /// voorwaardelijke update, dan pas het bericht.
  remindedAt DateTime? @db.Timestamptz(3)

  user  User          @relation("CalendarInterestUser", fields: [userId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([remindedAt])
}

/// "Ik kom naar dit alumni-evenement", aangeduid door iemand zonder account.
///
/// Bestaat enkel voor **alumni-evenementen**. Een afgestudeerde van 2004 heeft
/// geen KU Leuven-login meer en vaak ook geen zin om er een account bij te
/// maken; hem dwingen te registreren voor hij mag zeggen dat hij komt, is
/// precies de drempel die we willen weghalen. Voor gewone evenementen bestaat
/// deze weg bewust níét: daar is interesse een ledenmarkering en zou een
/// anonieme rij de teller waardeloos maken.
///
/// Naam, afstudeerjaar en VTK-verleden blijven optioneel. De bezoeker kan dus
/// ook alleen de teller verhogen, en beslist per veld of het in de publieke
/// aanwezigheidslijst verschijnt.
model CalendarEventGuestInterest {
  id      String @id @default(cuid())
  eventId String

  /// Hash van een cookie dat de bezoeker bij zijn eerste aanmelding krijgt.
  /// Daarmee kan hij zijn keuze terugnemen en telt hetzelfde toestel niet twee
  /// keer. Bewust enkel de hash: het cookie is een geheim dat we niet hoeven te
  /// bewaren, en zo staat er geen bruikbare identifier in de tabel. Dit is geen
  /// waterdichte fraudebescherming; die bestaat niet zonder login.
  deviceHash String

  /// Zelf ingevulde informatie voor dit ene evenement.
  displayName    String?
  graduationYear Int?
  wasInVtk       Boolean @default(false)

  /// Wat er in de publieke aanwezigheidslijst mag staan.
  showName           Boolean @default(false)
  showGraduationYear Boolean @default(false)
  showWasInVtk       Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, deviceHash])
  @@index([eventId])
}

/// Een alumnus in de mailinglijst, zonder dat er een account aan hangt.
///
/// De opt-in-mailinglijsten (`MailCategory`) vallen weg zodra iemand zijn studie
/// niet meer bevestigt; voor een afgestudeerde is dat per definitie altijd. Deze
/// tabel is daarom geen variant op die lijsten maar een eigen adresboek: namen
/// die de kring van reünies, oud-praesidia en inschrijvingslijsten overhoudt,
/// per lichting bijgehouden.
///
/// Site-accounts met `alumni = true` staan hier **niet** in. Die worden bij de
/// export samengevoegd en op e-mailadres ontdubbeld (zie lib/alumni.ts), zodat
/// niemand dezelfde mail twee keer krijgt en een alumnus die later toch een
/// account maakt niet handmatig verwijderd hoeft te worden.
model AlumniContact {
  id String @id @default(cuid())

  firstName String
  lastName  String
  /// Uniek en lowercase bewaard: het e-mailadres is de sleutel waarop de export
  /// ontdubbelt tegen de site-accounts.
  email     String @unique

  graduationYear Int?
  wasInVtk       Boolean @default(false)
  note           String?

  /// Uitgeschreven. Blijft bewust in de tabel staan: verwijderen zou betekenen
  /// dat de volgende import van een oude lijst hem stilletjes weer toevoegt.
  /// Valt uit elke export en uit de Brevo-sync.
  unsubscribedAt DateTime? @db.Timestamptz(3)

  createdById String?
  createdBy   User?   @relation("AlumniContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([graduationYear])
  @@index([lastName, firstName])
}

/// Een lid volgt een kalendercategorie en wil weten wanneer er iets bijkomt.
///
/// Dit is de enige plek waar de app iets stuurt dat geen "je moet nu iets doen"
/// is (zie docs/design-decisions.md). Het mag, precies omdat het lid er zelf om
/// gevraagd heeft, per categorie, en het met één tik weer uit kan.
model CalendarCategoryFollow {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user     User             @relation("CalendarFollowUser", fields: [userId], references: [id], onDelete: Cascade)
  category CalendarCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
}

/// Aan- of uitgezette meldingssoort per lid.
///
/// Enkel afwijkingen staan hier: geen rij betekent de standaard uit
/// `APP_NOTIFICATION_TOPICS`. Zo hoeft er bij een nieuw soort bericht niets
/// gemigreerd te worden, en blijft de tabel klein.
model AppNotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  /// Sleutel uit `APP_NOTIFICATION_TOPICS` in lib/app-api/contract.ts.
  topic   String
  enabled Boolean

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("AppNotificationPrefUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
}

/// Eén betaling met openstaande shiftbonnetjes, buiten de Theokot-afhaalbalie om.
///
/// De afhaalbalie heeft haar eigen auditrij (`TheokotVoucherRedemption`) omdat
/// die aan een bestelling hangt en altijd exact twee bonnetjes kost. Dit is de
/// vrije variant: aan de toog van de fakbar tikt iemand een bedrag in. Het saldo
/// zelf blijft `Shift.reward` min `ShiftParticipant.rewardPaid`; deze tabel is
/// het logboek, niet de waarheid.
model ShiftRewardRedemption {
  id            String  @id @default(cuid())
  userId        String
  processedById String?
  amount        Int
  /// Waar het gebeurde, ingetikt door wie aanvaardt ("Fakbar", "Theokot").
  place         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user        User  @relation("ShiftRewardRedemptionUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("ShiftRewardRedemptionProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Samen blokken: studietijd meten en naast die van je vrienden zetten
// -----------------------------------------------------------------------------

/// Eén keer gaan zitten studeren.
///
/// **De duur staat niet in één veld.** Een sessie loopt, pauzeert en loopt weer;
/// wat telt is `endedAt - startedAt` min de pauzes, en pas bij het afsluiten
/// wordt dat als `seconds` vastgelegd. Zolang ze loopt rekent de server het bij
/// elke vraag opnieuw uit, want een lopende sessie heeft geen eindtijd om vanaf
/// te rekenen.
///
/// `lastSeenAt` is het levensteken van de app. Het doet twee dingen: het bepaalt
/// of iemand "nu aan het studeren" is in de zaal van zijn groep, en het is de
/// bovengrens waarop een vergeten sessie afgekapt wordt. Zonder dat zou een
/// telefoon die 's avonds leegloopt de volgende ochtend veertien uur studietijd
/// opleveren.
///
/// Een lid hoort er hoogstens één open te hebben. Dat staat niet als
/// databankregel (Postgres kan dat enkel met een partiële unieke index, en die
/// kan Prisma niet uitdrukken); `startStudySession` sluit daarom eerst af wat nog
/// openstond, in dezelfde transactie.
model StudySession {
  id            String  @id @default(cuid())
  userId        String
  /// Het vak, vrij ingetikt door het lid zelf. Geen lijst uit de cursusdienst:
  /// mensen blokken ook voor dingen die daar niet in staan.
  subject       String?
  /// Verbergt het vak voor groepsgenoten. De tijd blijft wel meetellen.
  subjectHidden Boolean @default(false)

  startedAt     DateTime  @db.Timestamptz(3)
  endedAt       DateTime? @db.Timestamptz(3)
  /// Wanneer de huidige pauze begon; niet null betekent "nu gepauzeerd".
  pausedAt      DateTime? @db.Timestamptz(3)
  /// De som van de pauzes die al voorbij zijn, in seconden.
  pausedSeconds Int       @default(0)
  lastSeenAt    DateTime  @db.Timestamptz(3)
  /// Netto seconden. Pas ingevuld bij het afsluiten.
  seconds       Int?
  /// `user` (zelf gestopt), `timeout` (levensteken bleef weg) of `cap` (over de
  /// maximumduur). Staat er voor de uitleg aan het lid, niet voor statistiek.
  endedReason   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("StudySessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([endedAt, lastSeenAt])
}

/// Een groep waarin vrienden hun studietijd naast elkaar zetten.
///
/// Er is bewust geen VTK-brede ranglijst: studietijd is persoonlijk, en een
/// kringbrede lijst meet vooral wie geen leven heeft. Je totalen zijn zichtbaar
/// voor wie in dezelfde groep zit en voor niemand anders; stap je eruit, dan ben
/// je weg uit de lijst. Zie docs/design-decisions.md.
model StudyGroup {
  id                String    @id @default(cuid())
  name              String
  /// De code die je deelt. Hoofdletters en cijfers zonder de tekens die je
  /// verkeerd overtikt, zie `lib/app-api/studyGroups.ts`.
  code              String    @unique
  ownerId           String?
  /// Samen zoveel minuten per week halen. Null betekent: geen doel afgesproken.
  weeklyGoalMinutes Int?
  /// Wanneer voor deze groep laatst een "de eerste is begonnen"-bericht vertrok.
  /// Claim-dan-versturen: acht leden die tegelijk starten geven niet acht
  /// berichten, en één per dag is genoeg.
  startPushAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner   User?              @relation("StudyGroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members StudyGroupMember[]
}

/// Wie in welke groep zit. `owner` mag hernoemen, het doel zetten en iemand
/// verwijderen; verder is iedereen gelijk.
model StudyGroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  role    String @default("member")

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation("StudyGroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// Wat een lid voor zichzelf instelde. Bestaat pas zodra iemand iets wijzigt.
model StudyProfile {
  userId           String @id
  /// Het dagdoel in minuten; de reeks telt de dagen waarop je dat haalde.
  dailyGoalMinutes Int    @default(240)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation("StudyProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Rekeningen (het oude billsheet)
//
// Een lid koopt iets voor VTK, met de kaart van de kring of met zijn eigen, en
// dient het bonnetje hier in. De boekhouder wil dat als PDF op één vast blad, dus
// blijft `blad.pdf` het sjabloon en plakken we het bonnetje eronder; zie
// `lib/rekeningen/report.ts`.
// -----------------------------------------------------------------------------

/// Waarmee er betaald werd. VTK_CARD heeft geen terugbetaling nodig (het geld
/// ging nooit uit de zak van het lid), PERSONAL wel: dan is `iban` verplicht.
enum ExpensePaymentMethod {
  VTK_CARD
  PERSONAL
}

model Expense {
  id String @id @default(cuid())

  /// Werkingsjaar waarin de uitgave viel (2026 = "26-27"), afgeleid uit
  /// `spentOn` met dezelfde 15-juli-grens als de rest van de site. Bewust
  /// opgeslagen en niet berekend: de boekhouding sluit een jaar af, en dan mag
  /// een rekening niet van jaar veranderen omdat iemand haar datum corrigeert
  /// nadat het jaar om is.
  workingYear Int

  /// De post die de kost draagt. `SetNull` en niet `Cascade`: een gedeactiveerde
  /// of verwijderde post mag de boekhouding niet meenemen.
  groupId   String?
  /// Naam van de post op het moment van indienen. Staat zo op het blad dat naar
  /// de boekhouder gaat, en blijft dus staan ook als de post later hernoemt.
  postLabel String

  submittedById String?
  /// Wie het betaalde. Standaard de indiener, maar iemand mag het bonnetje van
  /// een medelid indienen, en dan hoort diens naam op het blad.
  payerName     String

  activity    String
  description String
  /// Datum van de uitgave (de datum op het bonnetje), niet van het indienen.
  spentOn     DateTime @db.Date
  amountCents Int

  paymentMethod ExpensePaymentMethod
  /// Enkel bij PERSONAL. Dit blijft een momentopname per rekening: het formulier
  /// vult `User.defaultIban` vooraf in, maar de indiener kan hier afwijken en een
  /// latere wijziging aan de profielstandaard verandert deze rij nooit.
  iban          String?

  /// Het bonnetje in object storage. Onder `bonnetjes/`, en enkel te lezen via
  /// de afgeschermde route: `/api/media` is publiek, en dit zijn financiële
  /// stukken met namen en rekeningnummers erop.
  receiptKey  String
  receiptName String
  receiptMime String
  receiptSize Int

  /// Terugbetaald aan het lid. Bij VTK_CARD staat dit meteen gevuld: er valt
  /// niets terug te betalen, en zo blijft "openstaand" precies de lijst waar
  /// nog geld naartoe moet.
  paidAt     DateTime? @db.Timestamptz(3)
  paidById   String?
  /// Bevestigd door de boekhouder dat ze in de boeken staat.
  bookedAt   DateTime? @db.Timestamptz(3)
  bookedById String?
  /// Wanneer het blad naar de boekhouding vertrok, en naar welk adres.
  sentAt     DateTime? @db.Timestamptz(3)
  sentTo     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  group       Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  submittedBy User?  @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  paidBy      User?  @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  bookedBy    User?  @relation("ExpenseBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)

  @@index([workingYear])
  @@index([groupId])
  @@index([submittedById])
  @@index([spentOn])
  @@index([paidAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Fakbar App
// -----------------------------------------------------------------------------

enum FakbarItemCategory {
  VAT
  BIER_WIJN
  FRISDRANK
  STERK
}

model FakbarItem {
  id         String             @id @default(cuid())
  name       String
  category   FakbarItemCategory
  salesPrice Int // In cents (theoretical income per unit)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  consumptions FakbarConsumption[]
  stockCounts  FakbarStockCount[]
  specials     FakbarEveningSpecial[]
}

enum FakbarWeekStatus {
  OPEN
  CLOSED
}

model FakbarWeek {
  id         String           @id @default(cuid())
  weekNumber Int
  year       Int
  startDate  DateTime         @db.Date
  endDate    DateTime         @db.Date
  status     FakbarWeekStatus @default(OPEN)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  evenings    FakbarEvening[]
  stockCounts FakbarStockCount[]

  @@unique([year, weekNumber])
}

model FakbarEvening {
  id                 String   @id @default(cuid())
  weekId             String
  date               DateTime @db.Date
  dayOfWeek          String // Zondag, Maandag, etc.
  hoofdtapperId      String?
  specialeActiviteit String?
  bancontactRevenue  Int      @default(0) // In cents
  cashToSafe         Int      @default(0) // "Naar kluis" in cents

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  week        FakbarWeek               @relation(fields: [weekId], references: [id], onDelete: Cascade)
  hoofdtapper User?                    @relation("FakbarHoofdtapper", fields: [hoofdtapperId], references: [id], onDelete: SetNull)
  cashCount   FakbarCashRegisterCount?
  consumption FakbarConsumption[]
  rental      FakbarRental?
  specials    FakbarEveningSpecial[]

  @@index([date])
}

model FakbarCashRegisterCount {
  eveningId String @id

  // All amounts are counts (how many pieces)
  cnt_0_05   Int @default(0)
  cnt_0_10   Int @default(0)
  cnt_0_20   Int @default(0)
  cnt_0_50   Int @default(0)
  cnt_1_00   Int @default(0)
  cnt_2_00   Int @default(0)
  cnt_5_00   Int @default(0)
  cnt_10_00  Int @default(0)
  cnt_20_00  Int @default(0)
  cnt_50_00  Int @default(0)
  cnt_100_00 Int @default(0)

  cnt_elixirbon      Int @default(0)
  cnt_guidogids      Int @default(0)
  cnt_medewerkersbon Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  evening FakbarEvening @relation(fields: [eveningId], references: [id], onDelete: Cascade)
}

enum FakbarConsumptionCategory {
  TAPPERSDRANK
  VERJAARDAGEN
  ZAKPINTJES
  MISLUKTE_PINTEN
  KLANTENKAART
  SUCCESPINTEN
  VERKOOP
}

model FakbarConsumption {
  id        String                    @id @default(cuid())
  eveningId String
  itemId    String
  category  FakbarConsumptionCategory
  quantity  Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  evening FakbarEvening @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  item    FakbarItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([eveningId])
}

model FakbarStockCount {
  id           String @id @default(cuid())
  weekId       String
  itemId       String
  beginOpslag  Int    @default(0)
  levering     Int    @default(0)
  naarPost     Int    @default(0)
  naarFrigo    Int    @default(0)
  eindOpslag   Int    @default(0)
  beginTelling Int    @default(0)
  eindTelling  Int    @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  week FakbarWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  item FakbarItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([weekId, itemId])
}

/// Wat er één avond extra is: een drank die er anders niet staat, of een actie
/// aan de toog ("2+1 gratis Stella").
///
/// **Dit is iets anders dan `FakbarEvening.specialeActiviteit`.** Dat veld zegt
/// *wat* die avond is (een cantus, een TD, een verhuur); dit zegt wat er die
/// avond aan de toog anders is. Een gewone donderdag kan een actie hebben zonder
/// dat er een activiteit is, en een cantus kan er drie hebben.
enum FakbarSpecialKind {
  /// Een drank die er die avond bij is en niet op de vaste kaart staat.
  DRANK
  /// Een actie of korting op wat er al staat.
  ACTIE
}

model FakbarEveningSpecial {
  id        String            @id @default(cuid())
  eveningId String
  kind      FakbarSpecialKind

  /// Wat er op het bord komt: "2+1 gratis Stella", "Cocktail van de maand".
  title String
  /// Optionele toelichting, bv. de voorwaarden van de actie.
  note  String?

  /// Het artikel waar de actie over gaat, wanneer het er één is. Null voor een
  /// actie over de hele toog of een drank die niet op de kaart staat. Bewust
  /// `SetNull` en geen `Cascade`: gaat het artikel van de kaart, dan blijft de
  /// actie in de historiek staan met haar eigen titel.
  itemId String?
  /// De prijs die die avond geldt, in cent. Null betekent: de gewone prijs, of
  /// niet van toepassing (bij een actie zoals 2+1).
  price  Int?

  /// Volgorde op het bord en op de site.
  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  evening FakbarEvening @relation(fields: [eveningId], references: [id], onDelete: Cascade)
  item    FakbarItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([eveningId])
}

model FakbarRental {
  eveningId       String @id
  rentalFee       Int    @default(25000) // Default 250 EUR in cents
  expectedRevenue Int    @default(0) // In cents
  effectiveProfit Int    @default(0) // In cents

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  evening FakbarEvening @relation(fields: [eveningId], references: [id], onDelete: Cascade)
}

/// Welke galerij een verwijderverzoek betreft. Eén tabel voor beide, net zoals
/// het één Immich-installatie is; de scheiding zit in dit veld en in de query.
enum PhotoTakedownGallery {
  MAIN
  FAKBAR
}

enum PhotoTakedownReason {
  /// De melder staat zelf op de foto.
  ON_PHOTO
  /// Auteursrecht of een andere claim op het beeld zelf.
  COPYRIGHT
  OTHER
}

enum PhotoTakedownStatus {
  /// Nog te behandelen.
  NEW
  /// Ingewilligd; de foto is uit de galerij gehaald.
  DELETED
  /// Bewust niet ingewilligd, met een notitie waarom.
  KEPT
}

/// Een vraag van iemand om een foto uit een galerij te halen.
///
/// Dit is de bezwaar- en verwijderroute uit `docs/compliance-audit-2026-07-18.md`
/// (art. 17 en 21 AVG), en tegelijk de gewone portretrecht-knop: wie op een
/// fakbarfoto staat wil die soms weg, los van alle regelgeving.
///
/// **De rij is de waarheid, de mail is een seintje.** Er wordt eerst hier
/// geschreven en pas daarna gemaild, zodat een hikkende mailserver geen verzoek
/// laat verdwijnen; `mailDelivered` maakt in het beheer zichtbaar wat nooit
/// vertrokken is.
model PhotoTakedownRequest {
  id      String               @id @default(cuid())
  gallery PhotoTakedownGallery

  /// Waar de foto stond. De slug is de publieke sleutel van het album, het
  /// asset-id dat van Immich.
  albumSlug String
  assetId   String

  /// Momentopnames, want na afhandeling bestaat de foto niet meer. Zonder deze
  /// twee toont de historiek een verzoek over een asset-id dat nergens meer
  /// naar verwijst.
  albumTitle    String
  photoFilename String

  reporterName  String
  reporterEmail String
  reason        PhotoTakedownReason
  /// Vrije toelichting van de melder.
  message       String?

  status       PhotoTakedownStatus @default(NEW)
  handledById  String?
  handledAt    DateTime?           @db.Timestamptz(3)
  /// Waarom het verzoek zo afgehandeld is. Verplicht wanneer de foto blijft.
  handlingNote String?

  /// Is de meldingsmail naar de post vertrokken? Onwaar betekent dat het
  /// verzoek enkel hier staat en dat niemand er een seintje van kreeg.
  mailDelivered Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// De beheerder die het afhandelde. `SetNull`: verlaat die persoon de kring,
  /// dan blijft de afhandeling zelf bestaan.
  handledBy User? @relation("PhotoTakedownHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([gallery, status])
  @@index([assetId])
}

/// Een gebouw van de KU Leuven, voor de lokalenzoeker in de app.
///
/// De gegevens komen uit de KU Leuven Access Guide en de KU Leuven kaart;
/// `scripts/scrape-kulag.ts` haalt ze op en `scripts/import-kulag.ts` zet ze
/// hier. De import is create-or-update op `kulagId`, zodat een herimport de
/// velden die VTK zelf invulde niet weggooit. Zie `docs/lokalenzoeker.md`.
model Building {
  id        String  @id @default(cuid())
  /// Het gebouwnummer van de KU Leuven, bv. "490-13". De natuurlijke sleutel.
  kulagId   String  @unique
  /// De korte code waarmee studenten het gebouw aanduiden, bv. "200K". Samen
  /// met het lokaalnummer is dit hoe een lokaal in een uurrooster staat
  /// ("200K 00.06"), en dus waar mensen op zoeken.
  shortCode String?
  name      String
  address   String
  zipcode   String
  city      String

  /// Zwaartepunt van `outline`. De lat/lng op de KULag-pagina zelf is voor elk
  /// gebouw dezelfde (het middelpunt van de kaart) en dus onbruikbaar.
  lat     Float?
  lng     Float?
  /// De contour als [[lat, lng], ...]. Leeg voor de terreinen, die geen
  /// voetafdruk hebben; die horen niet op de kaart.
  outline Json   @default("[]")

  photoUrl String?
  kulagUrl String
  /// De toegankelijkheidsplannen als [{ title, url }].
  plans    Json    @default("[]")

  /// Door VTK toegevoegd. Blijft staan bij een herimport.
  notes String?

  rooms Room[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([shortCode])
}

/// Een lokaal in een gebouw.
///
/// KULag is een toegankelijkheidsgids en geen lokalenregister: enkel gescreende
/// lokalen staan erin. Dat dekt in de praktijk de aula's en leslokalen, maar
/// niet elk bureau of labo. De app zegt dat ook, en verwijst wie niets vindt
/// door naar KULag zelf.
model Room {
  id         String  @id @default(cuid())
  /// Het KULag-id van het lokaal, bv. "490-13-000006". De natuurlijke sleutel.
  kulagId    String  @unique
  buildingId String
  /// Het lokaalnummer zoals het aan de deur hangt, bv. "00.06".
  code       String?
  /// De omschrijving zonder het nummer, bv. "Aula Rosalind Franklin".
  name       String
  /// De rubriek van KULag, bv. "Aula (auditorium)" of "Les- en vergaderlokaal".
  category   String
  /// Afgeleid uit `code`: "00.06" wordt 0, "01.01" wordt 1. Null wanneer het
  /// nummer die vorm niet heeft.
  floor      Int?
  kulagUrl   String

  /// Namen die mensen echt gebruiken en die niet in KULag staan ("Aula K",
  /// "de grote aula"). Dit is wat de zoekfunctie bruikbaar maakt; niemand zoekt
  /// op een KULag-id. Wordt door VTK ingevuld en overleeft een herimport.
  aliases String[] @default([])

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([buildingId])
  @@index([code])
}
