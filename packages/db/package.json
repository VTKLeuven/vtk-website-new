{
  "name": "@vtk/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./groups": "./src/groups.ts",
    "./permissions": "./src/permissions.ts",
    "./slug": "./src/slug.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "push": "dotenv -e ../../.env -- prisma db push",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "sync": "dotenv -e ../../.env -- tsx prisma/sync.ts",
    "sync:check": "dotenv -e ../../.env -- tsx prisma/sync.ts --dry-run",
    "db:setup": "npm run migrate:deploy && npm run seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "build": "dotenv -e ../../.env -- prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@vtk/tsconfig": "*",
    "dotenv-cli": "^7.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
