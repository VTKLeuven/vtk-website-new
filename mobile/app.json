{
  "expo": {
    "name": "VTK",
    "slug": "vtk-app",
    "owner": "vtk-it",
    "privacy": "unlisted",
    "scheme": "vtk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1A36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.vtk.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E1A36"
      },
      "package": "be.vtk.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FFD23F"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "VTK bewaart een foto uit een album in je fotobibliotheek.",
          "photosPermission": "VTK bewaart een foto uit een album in je fotobibliotheek.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VTK gebruikt je camera enkel om een QR-code te scannen: een ticket aan de deur, een uitnodiging om te mogen scannen, de code aan de fakbar of de pas van een student.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "VTK zet een evenement in je agenda wanneer je daarop tikt. Er wordt niets gelezen of gewijzigd zonder dat je het vraagt."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2858ac35-d566-4e4d-8351-3c36bed26693"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "url": "https://u.expo.dev/2858ac35-d566-4e4d-8351-3c36bed26693"
    }
  }
}
