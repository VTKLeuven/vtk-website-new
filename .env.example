# Copy to .env (at repo root) and fill in.

# Postgres
DATABASE_URL="postgresql://vtk:vtk@localhost:5432/vtk?schema=public"
POSTGRES_USER="vtk"
POSTGRES_PASSWORD="vtk"
POSTGRES_DB="vtk"

# Session cookie that is shared across subdomains. Use ".vtk.be" in production.
SESSION_COOKIE_DOMAIN=""

# Base URL of the main web app. Used by submodules to verify sessions remotely.
VTK_MAIN_URL="http://localhost:3000"

# Hetzner S3 object storage.
# Preferably configured at runtime via Admin -> IT (stored in the DB, secret
# encrypted). These env vars are only a fallback. Leave them empty after the
# Admin -> IT configuration is saved. Hetzner uses path-style URLs.
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION="fsn1"
S3_FORCE_PATH_STYLE="true"

# Optional: create a first superadmin on `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Immich gallery shown on the public Media page. Compose overrides the internal
# API/database hostnames; these localhost defaults are useful for `npm run dev`.
# The API key stays server-side.
# Production media storage is mounted separately; set this to /mnt/immich on
# the cloud server. When unset, Compose uses infra/immich/data/library locally.
IMMICH_MEDIA_LOCATION=""
GALLERY_IMMICH_API_URL="http://localhost:2283/api"
GALLERY_IMMICH_API_KEY=""
GALLERY_PUBLIC_PROXY_URL="http://localhost:3014"
GALLERY_ALBUM_MARKER="[gallery]"
GALLERY_CACHE_TTL_SECONDS="60"
GALLERY_DATABASE_HOST="localhost"
GALLERY_DATABASE_PORT="5432"
GALLERY_DATABASE_NAME="immich"
GALLERY_DATABASE_USER="immich"
# In Compose this is overlaid from infra/immich/.env.
GALLERY_DATABASE_PASSWORD=""
# Keep disabled until VTK has approved the DPIA, explicit-consent wording,
# participant/album notice and the Immich retention/access configuration.
GALLERY_FACE_SEARCH_ENABLED="false"
GALLERY_FACE_SEARCH_MAX_UPLOAD_BYTES="8388608"
GALLERY_FACE_SEARCH_TIMEOUT_SECONDS="240"
GALLERY_FACE_SEARCH_POLL_INTERVAL_MS="2500"
GALLERY_FACE_SEARCH_MAX_JOBS="50"
GALLERY_FACE_SEARCH_MIN_FACE_AREA_RATIO="0.008"
GALLERY_FACE_SEARCH_DOMINANT_FACE_AREA_RATIO="2.2"
GALLERY_FACE_MATCH_MAX_DISTANCE="0.42"
GALLERY_FACE_MATCH_MAX_RESULTS="80"

# GDPR retention maintenance. Schedule an authenticated POST to
# /api/privacy/maintenance (for example daily) with this value as Bearer token.
PRIVACY_MAINTENANCE_SECRET=""
PRIVACY_ACCESS_LOG_DAYS="365"
PRIVACY_RAW_PAYLOAD_DAYS="90"
PRIVACY_FINGERPRINT_DAYS="30"

# The web container runs `prisma migrate deploy` on every start, but only runs
# the seed when RUN_SEED=true. Leave it unset/false in normal operation so a
# redeploy never re-asserts seeded content over edits made in /admin. Set it to
# "true" for a single start to initialise a fresh DB, then remove it again.
RUN_SEED=""

# SMTP for transactional mail (o.a. Theokot no-show-waarschuwingen). Laat SMTP_HOST
# leeg om mails enkel te loggen i.p.v. te versturen (handig lokaal).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Theokot VTK <theokot@vtk.be>"

# Better auth variables
# openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me-with-a-secret"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
BETTER_AUTH_COOKIE_DOMAIN=".vtk.be"

# VTK als OAuth2/OIDC-provider. Optioneel: laat leeg en elke client krijgt
# dezelfde `sub` per lid (subject_type "public"). Zet je hem wel, dan kan een
# client op "pairwise" en krijgt die een eigen, niet-correleerbare `sub`.
# Minstens 32 tekens (openssl rand -base64 32), anders start de app niet.
# Even kritiek als BETTER_AUTH_SECRET: verlies je hem, dan breekt in één keer
# elke accountkoppeling van elke pairwise client.
OAUTH_PAIRWISE_SECRET=""

# KU Leuven SSO (OpenID Connect). Leave blank to disable the "Sign in with
# KU Leuven" button and run with email/password only. KU Leuven uses the
# Shibboleth OIDC OP of the Associatie KU Leuven, so the discovery URL is the
# Shibboleth issuer (ICTS gives you the exact value), e.g.
#   https://idp.kuleuven.be/.well-known/openid-configuration
KUL_OIDC_DISCOVERY_URL=""
# KUL_OIDC_CLIENT_ID is also the "Entity ID" you enter in the Shibboleth tool.
# It is a stable identifier and should stay the same across deployments.
KUL_OIDC_CLIENT_ID=""
KUL_OIDC_CLIENT_SECRET=""
# The redirect/callback URI is derived automatically from BETTER_AUTH_URL as
#   <BETTER_AUTH_URL>/api/auth/better/oauth2/callback/kuleuven
# Only set this to override it. Visit /sso-metadata (as superadmin) to see the
# exact values to register for the current deployment.
KUL_OIDC_REDIRECT_URI=""

# Integrated ticketing. Development defaults to the built-in mock provider;
# production must use `mollie` and a real API key.
TICKETING_PAYMENT_PROVIDER="mock"
TICKETING_PUBLIC_URL="http://localhost:3000"
TICKETING_RESERVATION_MINUTES="31"
# Generate each independently with `openssl rand -base64 48` before production.
TICKETING_TOKEN_SECRET=""
TICKETING_MAINTENANCE_SECRET=""
# Mollie payment provider. Use a `test_...` key for development/staging and a
# `live_...` key in production. The webhook is served at
# <TICKETING_PUBLIC_URL>/api/tickets/mollie/webhook and must be publicly
# reachable (Mollie rejects localhost); it is skipped automatically when
# TICKETING_PUBLIC_URL points at localhost.
MOLLIE_API_KEY=""

# Apple/Google Wallet tickets, in the same theme as the A4 PDF. Both button
# rows on a ticket only render once their config is present; leave everything
# below empty to skip wallet passes entirely. See docs/design-decisions.md for
# the direct-vs-third-party trade-off.
#
# Direct Apple: requires a paid ($99/year) Apple Developer Program account and
# a Pass Type ID certificate created in it. Export the signer cert/key as PEM
# (e.g. from the .p12 via `openssl pkcs12`) and get the WWDR intermediate
# certificate from https://www.apple.com/certificateauthority/. Certs/keys can
# be single-line with literal `\n` in place of newlines.
WALLET_APPLE_TEAM_ID=""
WALLET_APPLE_PASS_TYPE_ID=""
WALLET_APPLE_ORG_NAME="VTK Leuven"
WALLET_APPLE_SIGNER_CERT=""
WALLET_APPLE_SIGNER_KEY=""
WALLET_APPLE_SIGNER_KEY_PASSPHRASE=""
WALLET_APPLE_WWDR_CERT=""
# Direct Google: requires a Google Wallet Issuer account (apply at
# https://pay.google.com/business/console, needs Google's approval) and a
# service account with the Wallet Object Issuer role; use its JSON key's
# `client_email` and `private_key`.
WALLET_GOOGLE_ISSUER_ID=""
WALLET_GOOGLE_CLIENT_EMAIL=""
WALLET_GOOGLE_PRIVATE_KEY=""
# Third-party fallback (walletwallet.dev): issues both Apple and Google passes
# through their own Apple registration, so neither of the above is needed. Set
# only this to use it. If a direct Apple/Google config above is also set, the
# direct one wins for that platform. Free tier: 1000 passes/month, presets
# only for colours/logo; their Pro plan unlocks VTK's real theme colours and
# logo. Get a key at https://www.walletwallet.dev/.
WALLET_WALLETWALLET_API_KEY=""

# Uitleendienst (apps/logistiek, logistiek.vtk.be). Same conventions as the
# ticketing block above; the Mollie webhook lives at
# <LOGISTIEK_PUBLIC_URL>/api/uitleen/mollie/webhook and the MOLLIE_API_KEY is
# shared with ticketing.
LOGISTIEK_PAYMENT_PROVIDER="mock"
LOGISTIEK_PUBLIC_URL="http://localhost:3100"
# Generate with `openssl rand -base64 48` before production.
LOGISTIEK_MAINTENANCE_SECRET=""

# Test-login voor de uitleendienst. Logistiek heeft zelf geen auth; het valideert
# normaal de gedeelde vtk.be-cookie. Op een testomgeving (lokaal, dev.vtk.be) kan
# de echte KU Leuven-login lastig zijn, dus zet dit op "true" om via /test-login
# als een vast test-profiel in te loggen (logistiek, IT, post, werkgroep, student).
# LAAT DIT LEEG/"false" IN PRODUCTIE: de profielen geven echte permissies
# (inclusief superadmin) zonder wachtwoord. Leeg = enkel de gewone website-login.
LOGISTIEK_TEST_LOGIN=""

# SMTP used by the durable ticket mail outbox. In development, messages are
# logged when SMTP_HOST is empty.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="VTK Tickets <tickets@vtk.be>"
MAIL_REPLY_TO="info@vtk.be"

# Contactformulier (/contact). Alles gaat naar één bestemming; er is geen
# routering per onderwerp. De afzender is bewust een eigen adres en niet
# MAIL_FROM: een contactvraag hoort niet als "VTK Tickets" in de inbox te landen.
# Het adres van de bezoeker komt in de reply-to, niet in de from: onze mailserver
# mag zijn domein niet ondertekenen en SPF/DKIM zou dat bericht in de spam gooien.
CONTACT_MAIL_TO="info@vtk.be"
MAIL_FROM_CONTACT="VTK website <info@vtk.be>"

# KU Leuven kaartverificatie (Theokot-afhaalbalie: studentenkaart scannen).
# APARTE client-credentials van de OIDC-login hierboven — dit zijn de credentials
# voor de idverification-API (account.kuleuven.be). Laat leeg om enkel het
# handmatige r-nummerveld te gebruiken; de scanknop geeft dan een nette foutmelding.
KUL_CARD_CLIENT_ID=""
KUL_CARD_CLIENT_SECRET=""
# Optioneel: overschrijf de standaard-endpoints (defaults zijn de KU Leuven-productie).
KUL_CARD_AUTH_ENDPOINT="https://idp.kuleuven.be/auth/realms/kuleuven/protocol/openid-connect/token"
KUL_CARD_ID_ENDPOINT="https://account.kuleuven.be/api/v1/idverification"

# Deurscanner (KU Leuven-kaartscanner op de deur, bediend door een Raspberry Pi).
# Bij voorkeur beheerd via Admin -> IT (in de DB, secret versleuteld); deze env-vars
# zijn enkel een FALLBACK tot een superadmin het invult. Het device-secret
# authenticeert beide richtingen: de Pi -> /api/door/* en de server -> de Pi z'n
# /open-listener over Tailscale. Zet hetzelfde secret op de Pi (DOOR_DEVICE_SECRET).
# Genereer met: openssl rand -hex 24
DOOR_DEVICE_SECRET=""
# Basis-URL van de Pi z'n listener over Tailscale (zonder trailing slash), bv.
# http://door-pi:8080 (MagicDNS) of http://100.x.y.z:8080.
DOOR_PI_URL=""
# Hoelang de lock open blijft per opening (seconden).
DOOR_UNLOCK_SECONDS="5"

# Sentry (error monitoring / tracing / session replay voor apps/web).
# De DSN kun je nu beheren via Admin -> IT (in de DB); deze env-DSN's zijn enkel
# nog een FALLBACK. Laat alles leeg om Sentry uit te schakelen (SDK blijft inert).
NEXT_PUBLIC_SENTRY_DSN=""   # publiek; gebruikt in de browser (fallback)
SENTRY_DSN=""              # server/edge (fallback; mag dezelfde DSN zijn)
# BLIJVEN in .env: alleen nodig voor source-map-upload bij `next build`. Dit is
# build-time en kan niet naar een runtime-instelling (de build draait voor de DB
# bestaat). SENTRY_AUTH_TOKEN is het gevoelige, build-time secret.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Bezoekersstatistieken (Umami, op onze eigen server; zie docs/design-decisions.md).
# Cookieloos, geen persoonsgegevens, en het script laadt enkel na toestemming in
# de cookiebanner. Alles leeg = geen statistieken: de container draait leeg en de
# website laadt geen script.
#
# UMAMI_APP_SECRET zet de container aan (openssl rand -hex 32). Umami krijgt een
# eigen database in de bestaande Postgres; die wordt bij de eerste start
# aangemaakt door de umami-db-init-stap in infra/docker-compose.yml.
#
# LET OP, dit secret alleen volstaat niet. Umami staat achter het compose-profiel
# `umami`, zodat een gewone deploy zijn image niet hoeft op te halen zolang de
# dienst uit staat. Aanzetten vraagt dus twee bestanden:
#   1. dit bestand (root .env): UMAMI_APP_SECRET, UMAMI_PUBLIC_URL, UMAMI_WEBSITE_ID
#   2. infra/.env:              COMPOSE_PROFILES=umami
# Die tweede is nodig omdat compose zijn eigen interpolatie uit infra/.env leest
# en niet uit dit bestand; dit bestand gaat enkel naar de containers toe.
UMAMI_APP_SECRET=""
# Publieke URL van onze Umami (Caddy voor 127.0.0.1:3016), zonder afsluitende
# slash. Hiervandaan haalt de browser /script.js.
UMAMI_PUBLIC_URL=""
# Website-ID uit het Umami-dashboard (Settings -> Websites). Samen met de URL
# hierboven bepaalt dit of het script op de site verschijnt.
UMAMI_WEBSITE_ID=""
# Share-ID om de cijfers weer op te halen, voor de statistieken bovenaan
# /admin/media. Zet in Umami bij de website "Share URL" aan; het laatste stuk van
# die link (na /share/) is deze waarde. Bewust een share-id en geen
# beheerderswachtwoord: dit geeft enkel leesrecht en je trekt het met één klik in
# Umami weer in. Leeg = het beheer toont geen cijfers; meten blijft wel gewoon
# doorlopen.
UMAMI_SHARE_ID=""

# Cursusdienst-shiften (cudi.vtk.be) worden naar de main site gespiegeld via
# POST /api/integrations/cudi/shifts. Gedeeld bearer-secret: zet exact dezelfde
# waarde als MAIN_SITE_SHIFT_SYNC_SECRET op cudi. Leeg = endpoint weigert alles
# (spiegeling uit). Zie docs/design-decisions.md, "Cursusdienst-shiften op de main site".
CUDI_SYNC_SECRET=""

# Brevo (mailinglijsten). Met een API-key gaan de opt-in mailinglijsten
# automatisch naar Brevo: real-time bij elke profielwijziging plus een dagelijkse
# reconciliatie. Leeg = integratie uit; dan blijft enkel de handmatige CSV-export
# in /admin/mailinglijsten. Zie docs/design-decisions.md, "Mailinglijsten in Brevo".
BREVO_KEY=""
# Bearer-secret voor de reconciliatie-cron (POST /api/admin/mailinglijsten/sync).
# Laat een dagelijkse cron/uptime-pinger die route aanroepen met
# `Authorization: Bearer $BREVO_SYNC_SECRET`. Leeg = die trigger weigert alles
# (de real-time push werkt dan nog wel).
BREVO_SYNC_SECRET=""

# Barstatus 't ElixIr (Munisense geluidsmeter). We hebben geen API-sleutel, dus
# de worker logt in met een account op login.munisense.net en hergebruikt de
# sessiecookies. Leeg = integratie uit; de homepage-kaart valt dan terug op het
# vaste uurrooster. Zie docs/elixir-barstatus.md.
MUNISENSE_USERNAME=""
MUNISENSE_PASSWORD=""
# Bearer-secret voor de worker (POST /api/elixir/maintenance, elke 3 min door de
# elixir-worker in docker-compose). Leeg = die trigger weigert alles.
ELIXIR_MAINTENANCE_SECRET=""

# Shiften
# -----------------------------------------------------------------------------
# Bearer-secret voor de shift-worker (POST /api/shift/maintenance, elke 5 min),
# die de herinneringen verstuurt: een dag vooraf en twee uur vooraf, per lid
# uitzetbaar in het profiel. Leeg = geen herinneringen; de rest van de shiften
# blijft gewoon werken.
SHIFT_MAINTENANCE_SECRET=""
