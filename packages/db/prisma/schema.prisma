// VTK website Prisma schema.
// Generated client lands in @vtk/db/node_modules/.prisma/client for each package.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Locale {
  NL
  EN
}

enum MembershipRole {
  MEMBER
  LEAD
}

// Soort Group. PRAESIDIUM = een praesidiumpost (op /praesidium). WERKGROEP = een
// werkgroep (BEST, Revue, ...): dezelfde leden/rollen-machinerie, maar niet op
// /praesidium; ze verschijnen op /werkgroepen met een eigen infotekst + website.
enum GroupType {
  PRAESIDIUM
  WERKGROEP
}

// Hoe een post (Group) een rol toekent aan haar leden.
// DEFAULT: elk lid van de post krijgt de rol. LEADER: enkel de
// verantwoordelijke (membership.role == LEAD) krijgt de rol, bovenop de
// DEFAULT-rollen van de post.
enum RoleGrantKind {
  DEFAULT
  LEADER
}

// Wie mag inloggen bij een OAuth-client.
// OPEN: elk actief lid; permissies bepalen enkel wat je er méér mag (de
// cudi-tool). RESTRICTED: enkel wie de `<namespace>.access`-permissie van die
// client houdt, geraakt er binnen (de interne wiki). De blokkade zit in de
// autorisatieflow zelf, niet in de applicatie.
enum SsoAccessMode {
  OPEN
  RESTRICTED
}

enum PageAssetKind {
  EMBEDDED_PDF
  DOWNLOAD
}

enum DashboardTileScope {
  GLOBAL
  GROUP
  USER
}

enum TicketEventStatus {
  DRAFT
  PUBLISHED
  SALES_PAUSED
  SALES_CLOSED
  CANCELLED
  ARCHIVED
}

enum TicketAudience {
  PUBLIC
  MEMBERS
  /// Enkel voor ereleden (`User.honoraryMember`). Zo'n ticketsoort is voor
  /// iedereen anders onzichtbaar: ze staat niet in de lijst, en de checkout
  /// weigert ze. Bedoeld voor wat de kring aan ereleden geeft (bv. gratis
  /// naar een cantus) zonder dat de rest van de site die uitzondering ziet.
  HONORARY
}

enum TicketQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
}

enum TicketGrantRole {
  OWNER
  MANAGER
  FINANCE
  SCANNER
  REPORTER
}

enum TicketGroupGrantScope {
  ALL_MEMBERS
  LEADS_ONLY
}

enum TicketOrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TicketPaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum TicketRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TicketStatus {
  VALID
  VOID
  REFUNDED
}

enum TicketScanResult {
  ACCEPTED
  ALREADY_USED
  WRONG_EVENT
  INVALID
  VOID
  REFUNDED
  EXPIRED
  REVERSED
}

enum TicketOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

// -----------------------------------------------------------------------------
// Formulieren (zie de modellen onderaan en docs/forms.md)
// -----------------------------------------------------------------------------

// Geen aparte "actief"-boolean ernaast: twee waarheden over "staat dit open"
// lopen gegarandeerd uiteen. PUBLISHED plus opensAt/closesAt beslist het.
enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FormAudience {
  PUBLIC
  MEMBERS
}

/// Welke talen dit formulier bewust aanbiedt. Wie een formulier maar in één taal
/// invult, toont in de andere taal een eigen bericht ("enkel voor
/// internationals") in plaats van een halfleeg formulier of een 404.
enum FormLocaleMode {
  BOTH
  NL_ONLY
  EN_ONLY
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  BOOLEAN
  EMAIL
  NUMBER
  DATE
  TIME
  PHONE
  URL
  // Lineaire schaal. Sterren zijn dezelfde schaal met een andere weergave
  // (`display` in de config), geen apart type.
  SCALE
  FILE
  CONSENT
  // Komt uit het profiel van het ingelogde lid (r-nummer, studierichting, jaar);
  // welk veld precies staat in de config.
  PROFILE
}

enum FormFieldConditionOperator {
  EQUALS
  NOT_EQUALS
  INCLUDES
  IS_ANSWERED
}

enum FormGrantRole {
  VIEWER
  EDITOR
  MANAGER
}

enum FormGroupGrantScope {
  ALL_MEMBERS
  LEADS_ONLY
}

enum FormEntryStatus {
  DRAFT
  SUBMITTED
}

/// Opvolging van een inzending, los van haar levenscyclus: een sollicitatie is
/// ingediend (status) én nog niet beoordeeld (reviewStatus).
enum FormReviewStatus {
  NEW
  ACCEPTED
  REJECTED
}

enum FormNotifyMode {
  NONE
  EACH
  DAILY
}

enum FormOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum TheokotOrderStatus {
  RESERVED // gereserveerd, nog niet opgehaald
  PICKED_UP // afgehaald aan de balie
  NO_SHOW // niet opgehaald na sluitingstijd + grace
  CANCELLED // door de student geannuleerd voor de deadline
}

/// Terugkerende vergadering waarvoor vooraf een broodje en een drankje besteld
/// kan worden. De twee soorten verschillen enkel in publiek en beheer, niet in
/// werking (zie `Meeting`).
enum MeetingKind {
  GROCOMEET // wekelijks, enkel postverantwoordelijken + Groep 5
  BUREAU // tweewekelijks, elke student via een gedeelde link
}

enum MeetingReservationStatus {
  ACTIVE
  INVALIDATED // het gekozen broodje staat niet (meer) op het aanbod van die dag
}

enum UitleenReservationStatus {
  REQUESTED // aangevraagd, wacht op beslissing van Logistiek
  APPROVED // goedgekeurd; telt mee voor de voorraad
  REJECTED // afgewezen door Logistiek
  CANCELLED // door het lid geannuleerd
  PICKED_UP // materiaal afgehaald
  RETURNED // materiaal teruggebracht; reservatie afgerond
}

/// Beslissing per lijn van een materiaalaanvraag. Logistiek keurt drie van de
/// vijf items goed en laat de andere twee vallen; dat kon vroeger enkel op de
/// hele aanvraag, waardoor een aanvraag met één onbeschikbaar item volledig
/// afgewezen werd of stilzwijgend uitgekleed.
///
/// De aanvraag zelf krijgt geen aparte "deels goedgekeurd"-status: dat is af te
/// leiden uit de lijnen, en een extra waarde in `UitleenReservationStatus` zou
/// elke query, filter en voorraadberekening die op status kijkt moeten
/// bijwerken.
enum UitleenLineStatus {
  REQUESTED // gevraagd, nog niet beslist
  APPROVED // toegekend
  REJECTED // niet toegekend; blijft zichtbaar met de reden erbij
}

enum UitleenTransportBookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED // rit uitgevoerd
}

// Namens wie een aanvraag gebeurt. De drie kanalen uit de Logi-werking met elk
// een eigen behandelaar: interne posten, werkgroepen/jaarwerkingen, externen.
enum UitleenRequesterType {
  INTERN // eigen post (praesidium)
  WERKGROEP // werkgroep of jaarwerking
  EXTERN // extern of individueel
}

// Hoe de prijs van een voertuig berekend wordt. Team-configureerbaar per
// voertuig, want de kring bevestigt de tarieven nog.
enum UitleenPricingMode {
  FREE // gratis
  PER_HOUR // rateCents per begonnen uur
  PER_KM // rateCents per kilometer (km ingevuld bij afronden)
  FLAT // vast bedrag = rateCents
}

// Staat van een materiaalstuk. Puur informatief (badge in het beheer); muteert
// nooit automatisch de beschikbaarheid.
/// Grofweg wanneer op een dag. Geen uren: die spreekt het team af, en een
/// uurveld zou doen alsof de app een openingsuur kent dat ze niet kent.
enum UitleenDayPart {
  VOORMIDDAG
  NAMIDDAG
  AVOND
}

enum UitleenItemCondition {
  WERKT
  KAPOT
  TESTEN
  ONVOLLEDIG
}

// Hoe een goedgekeurde reservatie betaald wordt: online via de payment
// provider, of offline (cash/Payconiq) bij afhaling. Keuze van het team
// bij goedkeuring.
enum UitleenPaymentMode {
  ONLINE
  OFFLINE
}

/// Soort gebeurtenis in de historiek van een aanvraag of rit.
enum UitleenAuditKind {
  STATUS_CHANGED // goedgekeurd, afgehaald, teruggebracht, en het terugdraaien daarvan
  PAYMENT_MARKED // betaald aan de balie gezet of teruggedraaid, waarborg terug
  EDITED // het team paste de inhoud van de aanvraag aan
  NOTE // vrije notitie
}

enum UitleenPaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// Waar een uit de mail gelezen Collect&Go-bestelling staat: klaar om te
/// importeren, al in de flesserke-voorraad gezet, of terzijde geschoven.
enum CollectEnGoOrderStatus {
  NEW
  IMPORTED
  IGNORED
}

/// Hoe Collect&Go de hoeveelheid van een lijn uitdrukt. De meeste lijnen zijn
/// "3 stuk(s)", maar losse groenten worden per gewicht verkocht ("1,0 Kg") en
/// hebben dus geen stuksaantal in de mail.
enum CollectEnGoUnit {
  PIECE
  WEIGHT
}

// Hoe een deurgebeurtenis tot stand kwam: een fysieke kaartscan aan de deur, of
// een remote-open vanaf het dashboard.
enum DoorMethod {
  CARD
  REMOTE
}

// De uitkomst van een deurgebeurtenis.
enum DoorLogResult {
  ALLOWED // deur ging open
  DENIED // gekende gebruiker zonder toegang
  UNKNOWN_CARD // kaart geverifieerd maar niet aan een gebruiker gekoppeld
  ERROR // verificatie/lookup mislukt
}

// Welk e-mailadres de kring gebruikt om een lid te contacteren.
enum EmailPreference {
  UNIVERSITY // universiteitsmail (= login-mail via KUL SSO)
  PERSONAL // persoonlijke mail
}

// Mailinglijst-categorieën waarvoor een lid zich (opt-in) kan inschrijven.
enum MailCategory {
  FEEST
  CAREER
  SPORT
  EVENEMENTEN
  ONDERWIJS
  INTERNATIONAAL
  EERSTEJAARS
  BAKSKE
}

// In welk studiejaar een lid zit.
enum StudyYear {
  BACHELOR_1
  BACHELOR_2
  BACHELOR_3
  MASTER_1
  MASTER_2
}

// Studierichtingen (een lid kan er meerdere aanduiden). Labels (NL/EN) leven in
// de i18n-dictionaries, niet in de enum.
enum StudyProgramme {
  ARCHITECTURE
  BIOMEDICAL
  COMMON_BACHELOR
  CIVIL
  CHEMICAL
  COMPUTER_SCIENCE
  CYBERSECURITY
  DIGITAL_HUMANITIES
  ELECTRICAL
  ENERGY
  ARTIFICIAL_INTELLIGENCE
  MATERIALS
  NANO
  URBANISM
  MATHEMATICAL
  MECHANICAL
}

// -----------------------------------------------------------------------------
// Users, groups, permissions
// -----------------------------------------------------------------------------

/// Wat een `@vtk.be`-account mag. Afgeleid uit de posten en de kiesploeg, met
/// een override per persoon; zie docs/design-decisions.md, "Google Workspace".
enum GoogleAccountState {
  /// Kiesploeglid: mailbox stuurt door, verzenden gebeurt via de kiesploegalias.
  RESTRICTED
  /// Volwaardig: eigen mailbox, mag mailen vanaf het eigen adres.
  FULL
}

/// Functie van een lid dat zichzelf als academisch personeel aanduidt. `null`
/// op User betekent dat die status niet van toepassing is.
enum AcademicStaffRole {
  PROFESSOR
  ASSISTANT
  ADMINISTRATIVE
  OTHER
}

model User {
  id                   String    @id @default(cuid())
  // `name` blijft de weergavenaam (en het veld dat better-auth zelf zet bij een
  // SSO-login). `firstName`/`lastName` zijn de gestructureerde variant die de
  // mailinglijst-exports nodig hebben; ze worden ingevuld tijdens de onboarding
  // en in het gebruikersbeheer, en `name` wordt daaruit samengesteld.
  name                 String
  firstName            String?
  lastName             String?
  email                String    @unique
  rNumber              String?   @unique // KU Leuven studentennummer (bvb r0123456), voor zoeken
  // `true` als het r-nummer van de KU Leuven-authenticator komt (bij SSO gezet,
  // zie packages/auth/src/logins/kul.ts). Dan staat het veld read-only in het
  // profielformulier, net als de e-mail; een zelf ingevuld r-nummer (flag false)
  // blijft aanpasbaar.
  rNumberFromKul       Boolean   @default(false)
  // Autoritatieve faculteitsstatus uit KU Leuven OIDC. Bij elke geslaagde
  // userinfo-call wordt 50000486 in eduPersonOrgUnitDN gecontroleerd. De datum
  // wordt enkel bij de eerste controle of een echte booleanwijziging aangepast.
  firwStudent          Boolean   @default(false)
  firwStudentChangedAt DateTime?
  emailVerified        Boolean   @default(false)
  avatarKey            String?
  image                String?

  locale       Locale  @default(NL)
  active       Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  // Gezet door `eraseUserData` (lib/privacy/account.ts). De User-rij zelf kan niet
  // weg: te veel tabellen (theokot, uitleen, shifts) hangen er met een FK aan, dus
  // wordt ze geanonimiseerd tot een tombstone. Dat is bewust iets anders dan
  // `active: false`, wat een gewoon gedeactiveerd lid is dat je in het beheer nog
  // wil zien. Filter `deletedAt: null` in elke lijst die gebruikers toont.
  deletedAt DateTime?

  // Onboarding-profiel (ingevuld bij de eerste KUL SSO-login). Zolang
  // onboardedAt null is, wordt het lid naar de onboarding-flow gestuurd.
  onboardedAt             DateTime?
  // Kotadres. `noKot` is expliciet: lege velden alleen kunnen niet onderscheiden
  // of iemand geen kot heeft of het adres nog niet invulde.
  noKot                   Boolean             @default(false)
  street                  String?
  houseNumber             String?
  bus                     String? // busnummer, optioneel
  postalCode              String?
  city                    String?
  // Thuisadres is functioneel verplicht in onboarding en studiebevestiging.
  // De kolommen blijven nullable zodat bestaande leden pas bij hun volgende
  // bevestiging een echt adres moeten opgeven, zonder verzonnen migratiedata.
  homeStreet              String?
  homeHouseNumber         String?
  homeBus                 String? // busnummer, optioneel
  homePostalCode          String?
  homeCity                String?
  birthDate               DateTime?
  // Contact: `email` is de login-/universiteitsmail (via SSO). Persoonlijke
  // mail en de voorkeur voor communicatie komen erbij.
  personalEmail           String?
  emailPreference         EmailPreference     @default(UNIVERSITY)
  // Optionele standaard voor persoonlijke terugbetalingen. Elke rekening
  // bewaart nog steeds haar eigen IBAN, zodat een afwijking of latere
  // profielwijziging historische rekeningen niet verandert.
  defaultIban             String?
  // Het `@vtk.be`-account in Google Workspace. `googleUserId` is het immutable
  // id van Google: dat blijft kloppen wanneer iemand van naam of adres wisselt.
  // Op naam matchen doen we bewust nooit (naamgenoten, tussenvoegsels), dus dit
  // veld is de enige koppeling. Zie docs/design-decisions.md, "Google Workspace".
  googleUserId            String?             @unique
  googleEmail             String?             @unique
  googleLinkedAt          DateTime?
  // Wanneer het lid de verplichte koppeling uitstelde omdat het nog geen
  // @vtk.be-account heeft. Zonder deze ontsnapping sluit de gate iemand buiten
  // die niets kan doen aan wat de gate vraagt; de gate komt gewoon terug.
  googleLinkDeferredAt    DateTime?
  // Laatst toegepaste staat van het Google-account, zodat de sync niet elke
  // ronde dezelfde OU-verhuizing opnieuw doet. Afgeleid uit de posten en de
  // kiesploeg; zie lib/google/accountState.ts.
  googleAccountState      GoogleAccountState?
  // Opt-in mailinglijsten: enkel de aangeduide categorieën zitten in de array.
  mailCategories          MailCategory[]      @default([])
  // Wanneer het lid zich via een mail zelf uitschreef (de uitschrijflink in
  // Brevo). Bewust een datum en geen boolean: het beheer wil kunnen zien wanneer
  // die keuze viel, en het is een keuze van het lid die we niet stil mogen
  // overschrijven.
  //
  // Dit blokkeert **elke** lijstmail (de studiegerichte categorieën én de
  // alumnilijst), want Brevo kent maar één uitschrijving per contact: wie op
  // "unsubscribe" klikt, zegt dat tegen VTK als geheel. Alleen het lid zelf zet
  // dit terug, via de opt-in op /account; een import of een profielopslag mag
  // het nooit wissen. `mailCategories` blijft bewust staan, zodat een lid dat
  // zich opnieuw inschrijft zijn oude voorkeuren terugkrijgt.
  mailUnsubscribedAt      DateTime?           @db.Timestamptz(3)
  // Herinneringen voor een shift waarvoor je jezelf inschreef. Bewust geen
  // `MailCategory`: dat zijn opt-in nieuwsbrieven, dit is transactioneel. Wel
  // uitzetbaar, want niet iedereen wil twee mails per shift.
  shiftReminderDayBefore  Boolean             @default(true)
  shiftReminderSoon       Boolean             @default(true)
  // Studie: meerdere studiejaren en richtingen mogelijk (iemand kan bv. deels in
  // 2de en deels in 3de bachelor zitten).
  // Expliciete studentstatus. Vroeger betekende "niet notStudying" impliciet
  // student, waardoor alumni en personeel elk academiejaar onterecht door de
  // studiebevestigingsgate gingen. Staat los van `alumni`: iemand kan beide zijn.
  isStudent               Boolean             @default(true)
  studyYears              StudyYear[]         @default([])
  studyProgrammes         StudyProgramme[]    @default([])
  // Lid dat niet aan de faculteit Ingenieurswetenschappen studeert. Bewust geen
  // `StudyProgramme`-waarde: het is geen richting, en als enum-waarde zou het
  // overal opduiken waar richtingen opgelijst worden (o.a. de career-export).
  notAtFaculty            Boolean             @default(false)
  // Expliciete status "ik studeer niet" voor wie geen student, alumnus of
  // academisch personeelslid is. Bewust los van `notAtFaculty` (dat is
  // "studeert wél, maar elders").
  notStudying             Boolean             @default(false)
  // Subtype voor wie "academisch personeel" aanvinkt. De status zelf wordt uit
  // een niet-null waarde afgeleid, zodat checkbox en subtype niet uiteenlopen.
  academicStaffRole       AcademicStaffRole?
  // Verbergt doelgroepevents die niet bij het profiel passen.
  //
  // Standaard **uit**: alles is publiek en een eerstejaars mag gerust zien dat er
  // een alumni-avond is. Wie zijn kalender wil toespitsen (en op de homepage geen
  // doopactiviteiten wil zien) zet dit aan op /account; dan gelden de doelgroepen
  // uit `audiencesForStudyProfile` als filter op de homepage, de kalender, de
  // zoekresultaten, de app en de persoonlijke agendafeed.
  calendarOnlyMyAudiences Boolean             @default(false)
  // Internationale of uitwisselingsstudent. Bewust een eigen veld en geen
  // afleiding uit `locale`: de sitetaal zegt welke taal je leest, niet of je een
  // exchange-student bent. Stuurt welke evenementen vanzelf in de kalender
  // opduiken (zie CalendarAudience).
  internationalStudent    Boolean             @default(false)
  // Afgestudeerde van de faculteit. Bewust los van `notStudying`: die laatste
  // omvat ook wie stopte zonder af te studeren en is dus geen betrouwbare
  // alumni-indicator. Stuurt de expliciete alumni-doelgroep in de kalender.
  alumni                  Boolean             @default(false)
  // Het jaar waarin het lid afstudeerde. Enkel zinvol bij `alumni`, maar bewust
  // geen aparte tabel: het is één getal dat bij de persoon hoort. Wordt getoond
  // in de aanwezigheidslijst van een alumni-evenement wanneer het lid dat zelf
  // aanvinkt, en groepeert de alumni-mailinglijsten per lichting.
  graduationYear          Int?
  // "Ik heb ooit in VTK gezeten" (praesidium, werkgroep, medewerker). Bewust
  // zelf verklaard en niet afgeleid uit `GroupMembership`: de historiek in de
  // database begint pas bij de website, terwijl een alumnus van 2004 evengoed
  // in VTK zat.
  wasInVtk                Boolean             @default(false)
  // Wil per mail op de hoogte blijven van alumni-evenementen. Bewust geen
  // `MailCategory`: die lijsten zijn studiegericht en vallen weg zodra iemand
  // zijn studie niet meer bevestigt, wat voor een alumnus altijd het geval is.
  alumniMailOptIn         Boolean             @default(false)
  // Erelid. Enkel door een beheerder te zetten (zie `users.edit`), nooit door
  // het lid zelf. Geeft toegang tot ticketsoorten met `TicketAudience.HONORARY`,
  // die voor iedereen anders onzichtbaar blijven.
  honoraryMember          Boolean             @default(false)
  // Wanneer dit account zichzelf met e-mail en wachtwoord aanmaakte (de weg voor
  // wie geen KU Leuven-login (meer) heeft). Bewust een datum en geen boolean:
  // het beheer wil kunnen zien wanneer zo'n account binnenkwam.
  //
  // Het is ook de enige plek waar `emailVerified` echt iets betekent. Een
  // account dat een beheerder aanmaakte of dat via SSO binnenkwam is per
  // definitie vertrouwd; enkel bij een zelfgemaakt account houdt een
  // onbevestigd adres de login tegen (zie `loginAction`).
  selfRegisteredAt        DateTime?           @db.Timestamptz(3)
  // Academiejaar waarin een lid met `isStudent` zijn studieprofiel laatst
  // bevestigde (2026 = "26-27"). Loopt dat achter op het huidige academiejaar,
  // dan is het profiel verlopen: de bevestigingsgate vraagt het opnieuw en het
  // lid valt zolang uit de mailinglijsten. Andere statussen negeren deze stempel.
  //
  // Dit is bewust NIET het werkingsjaar: dat kantelt op 15 juli, terwijl het
  // academiejaar tot eind september loopt. De bevestiging vervalt daarom op
  // 27 september (`currentStudyYear()` in @vtk/auth), anders duidt iedereen in
  // juli nog het jaar aan dat net gedaan is.
  studyConfirmedYear      Int?

  sessions  Session[]
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships          GroupMembership[]
  roles                UserRole[]
  vaultMember          VaultMember?
  pocRepresentative    PocRepresentative[]
  createdPages         Page[]                  @relation("PageCreatedBy")
  createdAnnouncements Announcement[]          @relation("AnnouncementCreatedBy")
  updatedFrontpages    Frontpage[]             @relation("FrontpageUpdatedBy")
  createdEvents        CalendarEvent[]         @relation("EventCreatedBy")
  dashboardTiles       DashboardTile[]
  dashboardTilePrefs   UserDashboardTilePref[]
  adminNavPins         UserAdminNavPin[]
  participatingShifts  ShiftParticipant[]
  createdShortLinks    ShortLink[]             @relation("ShortLinkCreatedBy")
  alumniContacts       AlumniContact[]         @relation("AlumniContactCreatedBy")
  accountEmailTokens   AccountEmailToken[]     @relation("AccountEmailTokenUser")

  meetingsCreated           Meeting[]                  @relation("MeetingCreatedBy")
  meetingReservations       MeetingReservation[]       @relation("MeetingReservationUser")
  meetingPaymentsProcessed  MeetingReservation[]       @relation("MeetingReservationPaidBy")
  meetingPlans              MeetingPlan[]              @relation("MeetingPlanBy")
  theokotOrders             TheokotOrder[]             @relation("TheokotOrderUser")
  theokotPickedUp           TheokotOrder[]             @relation("TheokotPickedUpBy")
  theokotVoucherRedemptions TheokotVoucherRedemption[] @relation("TheokotVoucherUser")
  theokotVouchersProcessed  TheokotVoucherRedemption[] @relation("TheokotVoucherProcessedBy")
